@model Tourist_Project_MVC.View_Model.TripBuilderVM

@{
    ViewData["Title"] = "My Trip";
    ViewData["FullWidth"] = true;
    var tourist = ViewBag.Tourist as Tourist_Project_MVC.Models.Tourist;
    var myTrips = (ViewBag.MyTrips as IEnumerable<Tourist_Project_MVC.Models.TripPlan>) ?? new List<Tourist_Project_MVC.Models.TripPlan>();
}

<!-- WIDE MODERN CONTAINER FOR FULL-SCREEN ELEGANCE -->
<div class="trip-page-container px-3 px-md-4 px-xl-5 py-4" style="max-width: 1600px; margin: 0 auto;">

    @if (ViewBag.LevelIcon != null)
    {
        <div class="trip-progress-strip mb-3 p-3 rounded-3 d-flex align-items-center gap-3"
             style="background: rgba(200,131,42,0.06); border: 1px solid rgba(200,131,42,0.15);">
            <span class="fs-4">@ViewBag.LevelIcon</span>
            <div class="flex-grow-1">
                <span class="fw-bold text-dark" style="font-family:'Cinzel',serif;">@ViewBag.LevelName</span>
                <div class="progress mt-1" style="height: 8px;">
                    <div class="progress-bar" role="progressbar"
                         style="width: @ViewBag.ProgressPercent%; background: var(--egy-primary);"
                         aria-valuenow="@ViewBag.CurrentXP" aria-valuemin="0" aria-valuemax="@ViewBag.NextLevelXP">
                    </div>
                </div>
            </div>
            <span class="small text-muted d-none d-sm-inline">@ViewBag.CurrentXP / @ViewBag.NextLevelXP XP</span>
            <span class="small fw-bold" style="color: var(--egy-primary);">@ViewBag.ProgressPercent%</span>
        </div>
    }

    <!-- MODERN HERO BANNER -->
    <div class="trip-hero-card mb-4 p-4 p-md-5 rounded-4 shadow-sm border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1E120A 0%, #2D1A0E 50%, #3B2314 100%); color: #fff;">
        <div class="position-relative z-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge px-3 py-2 rounded-pill text-uppercase fw-bold tracking-wider mb-2 d-inline-flex align-items-center gap-2" style="background: rgba(200, 131, 42, 0.25); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.78rem;">
                        <i class="bi bi-compass-fill"></i> @Localizer["Trip_HeroBadge"].Value
                    </span>
                    <h1 class="display-5 fw-bold mb-2" style="font-family:'Cinzel', serif; color: #F59E0B; letter-spacing: 0.5px;">@Localizer["Trip_HeroTitle"].Value</h1>
                    <p class="text-white opacity-90 mb-0" style="max-width: 720px; font-size: 1.1rem; line-height: 1.6;">@Localizer["Trip_HeroDesc"].Value</p>
                </div>
                @if (tourist != null)
                {
                    <div class="glass-pill px-4 py-3 rounded-pill d-flex align-items-center gap-3" style="background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.25);">
                        <div class="avatar-circle" style="width: 46px; height: 46px; border-radius: 50%; background: #C8832A; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; font-family: 'Cinzel', serif; box-shadow: 0 4px 12px rgba(200, 131, 42, 0.4);">
                            @(string.IsNullOrEmpty(tourist.Name) ? "T" : tourist.Name.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="small text-white-50 text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Planning as</div>
                            <div class="fw-bold text-white fs-6">@tourist.Name</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- EXISTING TRIPS CARDS -->
    @if (myTrips.Any())
    {
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="section-title mb-0" style="font-family:'Cinzel',serif; color:var(--text-primary); font-weight: 700;">
                    <i class="bi bi-journal-bookmark me-2 text-gold"></i>@Localizer["Trip_MySavedTrips"].Value
                </h3>
                <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; font-size: 0.85rem;">
                    @myTrips.Count() Saved Expedition@(myTrips.Count() > 1 ? "s" : "")
                </span>
            </div>
            
            <div class="row g-3">
                @foreach (var trip in myTrips)
                {
                    var statusBadge = trip.Status switch
                    {
                        "Active" => "badge-status-active",
                        "Completed" => "badge-status-pending",
                        "Cancelled" => "badge-status-inactive",
                        "Draft" => "badge-status-draft",
                        _ => "badge-status-active"
                    };
                    <div class="col-12 col-md-6 col-xl-4">
                        <a asp-controller="Trip" asp-action="Details" asp-route-id="@trip.Id" class="text-decoration-none">
                            <div class="card trip-card h-100 p-3">
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="trip-card-title mb-0 text-truncate" title="@trip.Title">
                                                @trip.Title
                                            </h5>
                                            <span class="badge-status @statusBadge ms-2">@trip.Status</span>
                                        </div>
                                        <div class="trip-card-date mb-3">
                                            <i class="bi bi-calendar3 me-1 text-gold"></i>
                                            @trip.StartDate.ToString("MMM dd, yyyy") &ndash; @trip.EndDate.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div>
                                        <div class="trip-stops flex-wrap gap-1">
                                            @foreach (var td in trip.TripDestinations.OrderBy(x => x.Visit_Order).Take(4))
                                            {
                                                <span class="trip-stop-pill">
                                                    <i class="bi bi-geo-alt-fill me-1"></i>@td.Destination?.Name
                                                </span>
                                            }
                                            @if (trip.TripDestinations.Count > 4)
                                            {
                                                <span class="trip-stop-pill fw-bold" style="background: #F1F5F9;">+@(trip.TripDestinations.Count - 4) more</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center justify-content-end mt-3 text-gold-dark fw-bold small">
                                            View Itinerary <i class="bi bi-arrow-right ms-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- BUILDER FORM -->
    <form asp-action="Create" method="post" id="tripForm">
        @Html.AntiForgeryToken()

        <div class="builder-section-header mb-4">
            <h3 class="fw-bold mb-1" style="font-family:'Cinzel',serif; color:var(--text-primary);">
                <i class="bi bi-magic me-2 text-gold"></i>@Localizer["Trip_CreationStudio"].Value
            </h3>
            <p class="text-secondary mb-0" style="font-size: 1rem;">@Localizer["Trip_SetParameters"].Value</p>
        </div>

        <!-- MAP & FILTERS PANEL -->
        <div class="card shadow-sm border-0 mb-5 p-4 rounded-4" style="background: var(--bg-surface); border: 1px solid var(--border-subtle) !important;">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-4 col-xl-3">
                    <!-- Planning Filter Bar -->
                    <div class="filter-bar h-100 d-flex flex-column justify-content-between p-3 rounded-3" style="background: var(--bg-body); border: 1px solid var(--border-subtle);">
                        <div>
<h5 class="fw-bold mb-3" style="font-family:'Cinzel',serif; color:var(--text-primary); border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
                                <i class="bi bi-sliders me-2 text-gold"></i> @Localizer["Trip_FiltersBudget"].Value
                            </h5>
                            
                            <div class="filter-field mb-3">
                                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Trip_Duration"].Value</label>
                                <div class="p-2 rounded-3 text-center fw-bold fs-5 text-dark" style="background: var(--bg-surface); border: 1px solid var(--border-medium); color: var(--text-primary) !important;" id="tripDuration">—</div>
                            </div>

                            <div class="filter-field mb-3">
                                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Trip_Budget"].Value</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-currency-dollar text-gold"></i></span>
                                    <input asp-for="Budget" class="form-control border-start-0 ps-0 text-dark fw-semibold" type="number" min="0" step="0.01" placeholder="@Localizer["Trip_BudgetPlaceholder"].Value" />
                                </div>
                            </div>

                            <div class="filter-field mb-3">
                                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Trip_Companions"].Value</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-people text-gold"></i></span>
                                    <input asp-for="Companions" class="form-control border-start-0 ps-0 text-dark fw-semibold" type="number" min="1" placeholder="@Localizer["Trip_CompanionsPlaceholder"].Value" />
                                </div>
                            </div>

                            <div class="filter-field mb-3" id="tripInterests">
                                <label class="form-label fw-bold mb-2 small text-uppercase text-muted d-block">@Localizer["Trip_Interests"].Value</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-hidden" data-status="Pending" hidden />
                                        <label for="int-hidden" class="chip-label"><i class="bi bi-gem me-1 text-gold"></i>@Localizer["Trip_HiddenGems"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-temples" data-category="Temple" hidden />
                                        <label for="int-temples" class="chip-label"><i class="bi bi-bank me-1 text-gold"></i>@Localizer["Trip_Temples"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-museums" data-category="Museum" hidden />
                                        <label for="int-museums" class="chip-label"><i class="bi bi-building me-1 text-gold"></i>@Localizer["Trip_Museums"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-nature" data-category="Natural" hidden />
                                        <label for="int-nature" class="chip-label"><i class="bi bi-tree me-1 text-gold"></i>@Localizer["Trip_Nature"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-adventure" data-category="Archaeological" hidden />
                                        <label for="int-adventure" class="chip-label"><i class="bi bi-compass me-1 text-gold"></i>@Localizer["Trip_Adventure"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-historical" data-category="Historical" hidden />
                                        <label for="int-historical" class="chip-label"><i class="bi bi-hourglass-split me-1 text-gold"></i>@Localizer["Trip_Historical"].Value</label>
                                    </div>
                                    <div class="interest-chip">
                                        <input type="checkbox" id="int-religious" data-category="Religious" hidden />
                                        <label for="int-religious" class="chip-label"><i class="bi bi-moon-stars me-1 text-gold"></i>@Localizer["Trip_Religious"].Value</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-egy-primary w-100 py-2.5 mt-2 shadow-sm" id="tripFilterBtn">
                            <i class="bi bi-funnel-fill me-1"></i> @Localizer["Trip_Filter"].Value
                        </button>
                    </div>
                </div>

                <div class="col-lg-8 col-xl-9">
                    <div class="map-wrapper-card h-100 position-relative rounded-3 overflow-hidden shadow-sm" style="border: 1px solid var(--border-medium); min-height: 400px;">
                        <div class="map-badge-overlay position-absolute top-0 end-0 m-3 z-3 px-3 py-1 rounded-pill bg-dark text-white small shadow-sm" style="opacity: 0.95;">
                            <i class="bi bi-geo-alt me-1 text-gold"></i> @Localizer["Trip_InteractiveMap"].Value
                        </div>
                        <div id="tripBuilderMap" class="trip-builder-map h-100" style="min-height: 400px;">
                            <div class="map-watermark">
                                <i class="bi bi-map text-gold" style="font-size: 2.5rem;"></i>
                                <p class="mb-0 mt-1 small text-dark fw-semibold">@Localizer["Trip_MapLoading"].Value</p>
                                <small class="text-muted">@Localizer["Trip_MapHint"].Value</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTAINED BUILDER (Picker & Itinerary) -->
        <div class="row g-4 mb-4">
            <!-- Picker -->
            <div class="col-lg-5 col-xl-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100" style="background: var(--bg-surface); border: 1px solid var(--border-subtle) !important;">
                    <h4 class="mb-3 d-flex align-items-center gap-2" style="font-family:'Cinzel',serif; color:var(--text-primary);">
                        <span class="step-num-badge">1</span> @Localizer["Trip_PickDestinations"].Value
                    </h4>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Trip Title</label>
                        <input asp-for="Title" class="form-control form-control-lg fs-6 fw-semibold text-dark" placeholder="e.g. Cairo & Luxor Escape" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3 g-2">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Start Date</label>
                            <input asp-for="StartDate" class="form-control fw-semibold text-dark" type="date" id="StartDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">End Date</label>
                            <input asp-for="EndDate" class="form-control fw-semibold text-dark" type="date" id="EndDate" />
                        </div>
                    </div>

                    <!-- Destination Quick Search -->
                    <div class="mb-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="destSearchInput" class="form-control border-start-0" placeholder="Search destination by name..." />
                        </div>
                    </div>

                    <div class="destination-picker p-2 rounded-3">
<div id="tripEmptyFilter" class="text-muted small p-3 text-center" style="display:none">
                             <i class="bi bi-exclamation-circle text-gold fs-4 d-block mb-1"></i>
                             @Localizer["Trip_NoMatch"].Value
                         </div>
                        @for (int i = 0; i < Model.Stops.Count; i++)
                        {
                            <div class="picker-row p-3 mb-2 rounded-3"
                                 data-dest-id="@Model.Stops[i].DestinationId"
                                 data-category="@Model.Stops[i].Category"
                                 data-status="@Model.Stops[i].Status"
                                 data-price="@(Model.Stops[i].TicketPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
                                 data-lat="@Model.Stops[i].Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-lng="@Model.Stops[i].Lng.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <div class="d-flex align-items-start justify-content-between gap-2 w-100">
                                    <div class="form-check custom-dest-check flex-grow-1">
                                        <input type="hidden" asp-for="Stops[i].DestinationId" />
                                        <input type="hidden" asp-for="Stops[i].DestinationName" />
                                        <input type="hidden" asp-for="Stops[i].City" />
                                        <input class="form-check-input stop-select mt-1"
                                               type="checkbox"
                                               asp-for="Stops[i].Selected"
                                               id="stop_@i" />
                                        <label class="form-check-label ms-1" for="stop_@i">
                                            <span class="fw-bold d-block text-dark dest-name-text fs-6">@Model.Stops[i].DestinationName</span>
                                            <span class="text-muted small d-inline-block"><i class="bi bi-geo-alt text-gold me-1"></i>@Model.Stops[i].City</span>
                                            @if (!string.IsNullOrEmpty(Model.Stops[i].Category))
                                            {
                                                <span class="badge bg-light text-dark border ms-1 fw-semibold">@Model.Stops[i].Category</span>
                                            }
                                        </label>
                                    </div>
                                    @if (Model.Stops[i].TicketPrice.HasValue && Model.Stops[i].TicketPrice > 0)
                                    {
                                        <span class="badge px-2 py-1 align-self-start" style="background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A;">
                                            $@Model.Stops[i].TicketPrice.Value.ToString("N0")
                                        </span>
                                    }
                                </div>
                                <div class="picker-dates d-none mt-2 pt-2 border-top">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="small text-muted mb-1">Arrival</label>
                                            <input asp-for="Stops[i].ArrivalDate" class="form-control form-control-sm" type="date" />
                                        </div>
                                        <div class="col-6">
                                            <label class="small text-muted mb-1">Departure</label>
                                            <input asp-for="Stops[i].DepartureDate" class="form-control form-control-sm" type="date" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Live itinerary preview -->
                    <div class="mt-3">
                        <h6 class="text-muted small text-uppercase fw-bold">Itinerary preview</h6>
                        <ol class="itinerary-preview mb-3 ps-3 text-dark fw-semibold" id="itineraryPreview"></ol>
                    </div>

                    <button type="submit" class="btn btn-egy-primary w-100 py-3 fw-bold fs-6 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i> Save & Create Trip Plan
                    </button>
                </div>
            </div>

            <!-- Running itinerary -->
            <div class="col-lg-7 col-xl-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100" style="background: var(--bg-surface); border: 1px solid var(--border-subtle) !important;">
                    <h4 class="mb-3 d-flex align-items-center gap-2" style="font-family:'Cinzel',serif; color:var(--text-primary);">
                        <span class="step-num-badge">2</span> @Localizer["Trip_LiveItinerary"].Value
                    </h4>
                    <div class="itinerary-board p-3 rounded-3 h-100" id="itineraryBoard">
                        <div class="text-center text-muted py-5" id="emptyHint">
                            <div class="mb-3">
                                <i class="bi bi-pin-map text-gold" style="font-size: 3rem; opacity: 0.7;"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">@Localizer["Trip_NoDestinations"].Value</h5>
                            <p class="small text-muted mb-0">@Localizer["Trip_NoDestinationsDesc"].Value</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<style>
    /* OVERRIDE BODY BACKGROUND TO CRISP MODERN NEUTRAL */
    body {
        background-color: var(--bg-body) !important;
    }

    .text-gold {
        color: #C8832A !important;
    }

    .text-gold-dark {
        color: #B45309 !important;
    }

    .btn-egy-primary {
        background: linear-gradient(135deg, #C8832A 0%, #A6651E 100%);
        color: #fff !important;
        border: none;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    .btn-egy-primary:hover {
        background: linear-gradient(135deg, #D98E32 0%, #C8832A 100%);
        box-shadow: 0 6px 20px rgba(200, 131, 42, 0.35);
        transform: translateY(-1px);
    }

    .step-num-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #C8832A;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        font-weight: bold;
        box-shadow: 0 2px 8px rgba(200, 131, 42, 0.3);
    }

    .interest-chip input:checked + .chip-label {
        background: #C8832A;
        color: #ffffff !important;
        border-color: #C8832A;
        box-shadow: 0 2px 8px rgba(200, 131, 42, 0.25);
    }

    .interest-chip input:checked + .chip-label i {
        color: #ffffff !important;
    }

    .chip-label {
        display: inline-block;
        padding: 6px 14px;
        border: 1px solid var(--border-medium);
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        cursor: pointer;
        background: var(--bg-surface);
        transition: all 0.2s ease;
        user-select: none;
    }

    .chip-label:hover {
        border-color: #C8832A;
        color: #C8832A;
        background: #FFFBEB;
    }

    .trip-card {
        background: var(--bg-surface) !important;
        border: 1px solid var(--border-subtle) !important;
        border-radius: 16px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04) !important;
    }

    .trip-card:hover {
        transform: translateY(-3px) !important;
        border-color: rgba(200, 131, 42, 0.4) !important;
        box-shadow: 0 12px 28px rgba(30, 18, 10, 0.1) !important;
    }

    .trip-card-title {
        color: var(--text-primary) !important;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1.15rem;
    }

    .trip-card-date {
        color: #334155 !important;
        font-size: 0.88rem;
        font-weight: 600;
    }

    .trip-stop-pill {
        display: inline-flex;
        align-items: center;
        background: #F1F5F9;
        border: 1px solid var(--border-medium);
        color: #1E293B;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        margin: 2px 4px 2px 0;
        transition: all 0.2s ease;
    }

    .trip-stop-pill i {
        color: #C8832A;
    }

    .trip-stop-pill:hover {
        background: #FFFBEB;
        border-color: #FCD34D;
        color: var(--text-primary);
    }

    .badge-status-active {
        background: #DCFCE7 !important;
        color: #15803D !important;
        border: 1px solid #86EFAC !important;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
    }

    .badge-status-pending {
        background: #FEF3C7 !important;
        color: #B45309 !important;
        border: 1px solid #FDE68A !important;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
    }

    .badge-status-draft {
        background: #F1F5F9 !important;
        color: #475569 !important;
        border: 1px solid var(--border-medium) !important;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
    }

    .badge-status-inactive {
        background: #FEE2E2 !important;
        color: #B91C1C !important;
        border: 1px solid #FCA5A5 !important;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
    }

    .destination-picker {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid var(--border-subtle);
        background: var(--bg-body);
        border-radius: 12px;
    }

    .picker-row {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle) !important;
        border-radius: 10px !important;
        transition: all 0.2s ease;
    }

    .picker-row:hover {
        border-color: #C8832A !important;
        box-shadow: 0 4px 12px rgba(200, 131, 42, 0.1);
    }

    .itinerary-board {
        background: var(--bg-body);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        min-height: 360px;
    }

    .itinerary-stop {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        background: var(--bg-surface);
        border-radius: 12px;
        margin-bottom: 10px;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .itinerary-order {
        flex: 0 0 34px;
        height: 34px;
        border-radius: 50%;
        background: #C8832A;
        color: #ffffff;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Cinzel', serif;
        box-shadow: 0 2px 6px rgba(200, 131, 42, 0.3);
    }

    .itinerary-preview li {
        color: var(--text-primary);
    }

    .trip-builder-map {
        min-height: 400px;
        border-radius: 12px;
        background: repeating-linear-gradient(45deg, #e7e0d5 0 18px, #efe9df 18px 36px);
    }

    .map-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #C8832A;
        opacity: 0.75;
    }

    .picker-row.match-highlight {
        background: #FFFBEB !important;
        border-color: #FCD34D !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script>
    (function () {
        var tripPropMap = {
            id: ['id', 'Id', 'destination_id'],
            name: ['name', 'Name', 'destination_name'],
            city: ['city', 'City'],
            category: ['category', 'Category'],
            detailsUrl: '/Destination/Details/{id}'
        };

        function buildPopup(feature) {
            var p = feature.properties || {};
            var id = destId(feature);
            var name = _firstDefined(p, tripPropMap.name, ['Unnamed']);
            var city = _firstDefined(p, tripPropMap.city, ['']);
            var cat = _firstDefined(p, tripPropMap.category, ['']);
            var html = '';
            if (name) html += '<strong class="text-dark">' + _esc(name) + '</strong>';
            if (city) html += '<br><span style="color:#64748B">' + _esc(city) + '</span>';
            if (cat) html += '<br><span class="badge bg-secondary">' + _esc(cat) + '</span>';
            if (id && tripPropMap.detailsUrl) {
                html += '<br><a href="' + tripPropMap.detailsUrl.replace('{id}', encodeURIComponent(id)) + '" class="btn btn-sm btn-outline-primary mt-1">Details</a>';
            }
            return html;
        }

        function _esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function _firstDefined(p, keys, fallback) {
            for (var i = 0; i < keys.length; i++) {
                var val = p[keys[i]];
                if (val !== undefined && val !== null && String(val) !== '') return String(val);
            }
            return fallback[0] || '';
        }
        function destId(feature) {
            var p = feature.attributes || feature.properties || {};
            return _firstDefined(p, tripPropMap.id, ['']);
        }

        var tripMap = EGYMaps.initWfsMap({
            mapElId: 'tripBuilderMap',
            layer: 'destinations',
            propMap: tripPropMap,
            popupHtml: buildPopup,
            markerStyle: { radius: 8, fillColor: '#C8832A', color: '#fff', weight: 2, opacity: 1, fillOpacity: 0.85 },
            onLayerReady: function () {
                applyTripFilter();
            }
        });

        var $checks = $('.stop-select');
        var $board = $('#itineraryBoard');
        var $empty = $('#emptyHint');
        var $preview = $('#itineraryPreview');
        var stopOverlays = [];
        var rowById = {};

        $('.picker-row').each(function () {
            var id = $(this).attr('data-dest-id');
            if (id) rowById[String(id)] = $(this);
        });

        function rowMatches($row) {
            var cat = $row.data('category');
            var st = $row.data('status');
            var price = parseFloat($row.data('price')) || 0;
            var interests = [];
            $('#tripInterests input:checked').each(function () {
                interests.push({ cat: $(this).data('category'), st: $(this).data('status') });
            });
            var budget = parseFloat($('#Budget').val());
            var budgetSet = !isNaN(budget);

            var interestMatch = interests.length === 0;
            for (var j = 0; j < interests.length; j++) {
                if (interests[j].cat && cat === interests[j].cat) { interestMatch = true; break; }
                if (interests[j].st && st === interests[j].st) { interestMatch = true; break; }
            }
            var budgetMatch = !budgetSet || price <= budget;
            return interestMatch && budgetMatch;
        }

        function tripPredicate(feature) {
            var p = feature.attributes || {};
            var id = destId(feature);
            var row = rowById[String(id)];
            return row ? rowMatches(row) : false;
        }

        function clearStopOverlays() {
            stopOverlays.forEach(function (m) { if (tripMap && tripMap.map && tripMap.map.hasLayer(m)) tripMap.map.removeLayer(m); });
            stopOverlays = [];
        }

        function refresh() {
            var selected = $checks.filter(':checked');
            $preview.empty();
            clearStopOverlays();

            if (selected.length === 0) {
                $empty.show();
                $board.find('.itinerary-stop').remove();
                return;
            }

            $empty.hide();
            $board.find('.itinerary-stop').remove();
            var latlngs = [];

            selected.each(function (idx) {
                var $row = $(this).closest('.picker-row');
                var name = $row.find('.dest-name-text').text();
                var arr = $row.find('input[type=date]').eq(0).val();
                var dep = $row.find('input[type=date]').eq(1).val();
                var lat = parseFloat($row.attr('data-lat'));
                var lng = parseFloat($row.attr('data-lng'));

                var $stop = $('<div class="itinerary-stop"></div>');
                $stop.append('<div class="itinerary-order">' + (idx + 1) + '</div>');
                $stop.append('<div><strong class="text-dark fs-6">' + name + '</strong>' +
                    '<div class="text-secondary small mt-1"><i class="bi bi-clock me-1 text-gold"></i>' +
                    (arr ? 'Arrive ' + arr : '') +
                    (dep ? ' &middot; Depart ' + dep : '') + '</div></div>');
                $board.append($stop);

                $preview.append('<li>' + name + '</li>');

                if (!isNaN(lat) && !isNaN(lng) && tripMap && tripMap.addStopOverlay) {
                    var overlay = tripMap.addStopOverlay(lat, lng, idx + 1);
                    latlngs.push([lat, lng]);
                }
            });

            if (latlngs.length > 1 && tripMap && tripMap.fitBounds) {
                tripMap.fitBounds(latlngs);
            }
        }

        $checks.on('change', function () {
            $(this).closest('.picker-row').find('.picker-dates').toggleClass('d-none', !this.checked);
            refresh();
        });

        refresh();

        // Search Input Filter
        $('#destSearchInput').on('keyup input', function () {
            var val = $(this).val().toLowerCase();
            $('.picker-row').each(function () {
                var name = $(this).find('.dest-name-text').text().toLowerCase();
                if (name.indexOf(val) !== -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        // ---- Planning filter bar ----
        function updateDuration() {
            var start = $('#StartDate').val();
            var end = $('#EndDate').val();
            if (start && end) {
                var d1 = new Date(start), d2 = new Date(end);
                var days = Math.round((d2 - d1) / 86400000) + 1;
                $('#tripDuration').text((days > 0 ? days : 0) + (days === 1 ? ' day' : ' days'));
            } else {
                $('#tripDuration').text('—');
            }
        }

        function applyTripFilter() {
            var interests = [];
            $('#tripInterests input:checked').each(function () {
                interests.push({ cat: $(this).data('category'), st: $(this).data('status') });
            });

            var budgetRaw = $('#Budget').val();
            var budget = parseFloat(budgetRaw);
            var budgetSet = !isNaN(budget);
            var hasFilter = interests.length > 0 || budgetSet;

            $('.picker-row').each(function () {
                var cat = $(this).data('category');
                var st = $(this).data('status');
                var price = parseFloat($(this).data('price')) || 0;

                var interestMatch = interests.length === 0;
                for (var j = 0; j < interests.length; j++) {
                    if (interests[j].cat && cat === interests[j].cat) { interestMatch = true; break; }
                    if (interests[j].st && st === interests[j].st) { interestMatch = true; break; }
                }

                var budgetMatch = !budgetSet || price <= budget;
                var match = interestMatch && budgetMatch;

                if (!hasFilter || match) {
                    $(this).show();
                    $(this).toggleClass('match-highlight', hasFilter && match);
                } else {
                    $(this).hide();
                    $(this).removeClass('match-highlight');
                }
            });

            if (tripMap && tripMap.filterMarkers) tripMap.filterMarkers(tripPredicate);
            toggleTripEmpty();
            fitTripBounds();
        }

        function fitTripBounds() {
            if (!tripMap || !tripMap.fitBounds) return;
            var latlngs = [];
            $('.picker-row').each(function () {
                if ($(this).css('display') === 'none') return;
                var lat = parseFloat($(this).attr('data-lat'));
                var lng = parseFloat($(this).attr('data-lng'));
                if (!isNaN(lat) && !isNaN(lng)) latlngs.push([lat, lng]);
            });
            if (latlngs.length === 0) return;
            tripMap.fitBounds(latlngs);
        }

        function toggleTripEmpty() {
            var visible = $('.picker-row:visible');
            var empty = document.getElementById('tripEmptyFilter');
            if (empty) empty.style.display = visible.length === 0 ? '' : 'none';
        }

        $('#StartDate, #EndDate').on('change', updateDuration);
        $('#tripFilterBtn').on('click', applyTripFilter);
        $('#tripInterests input, #Budget').on('change', function () {
            if ($('#tripInterests input:checked').length || $('#Budget').val()) applyTripFilter();
        });

        updateDuration();
    })();
</script>
}

