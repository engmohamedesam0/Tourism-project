@model Tourist_Project_MVC.View_Model.TouristRewardVM

@{
    ViewData["Title"] = "Points & Rewards";
    ViewData["IsHomePage"] = false;
}

<div class="container my-4" style="max-width: 1200px;">

    <h1 class="page-title mb-4">
        <i class="bi bi-gift me-2"></i> @Localizer["Reward_Title"].Value
    </h1>

    @if (!string.IsNullOrEmpty(TempData["RewardMessage"] as string))
    {
        var msgType = TempData["RewardMessageType"] as string ?? "info";
        <div class="alert alert-@msgType alert-dismissible fade show" role="alert">
            @Html.Raw(TempData["RewardMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Points balance -->
    <div class="row mb-4">
        <div class="col-md-4 mx-auto">
            <div class="stat-card text-center">
                <i class="bi bi-coin stat-icon"></i>
                <div>
                    <span class="stat-number">@Model.PointBalance.ToString("N0")</span>
                    <span class="stat-suffix">pts</span>
                </div>
                 <span class="stat-label">@Localizer["Reward_YourBalance"].Value</span>
            </div>
        </div>
    </div>

    <!-- Available rewards -->
    <h4 class="mb-3" style="font-family:'Cinzel',serif; color: var(--egy-dark);">
        <i class="bi bi-shop me-2"></i> @Localizer["Reward_Available"].Value
    </h4>

    <div class="filter-bar h-100 d-flex flex-column justify-content-between p-3 rounded-3 mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
        <div>
            <h5 class="fw-bold mb-3" style="font-family:'Cinzel',serif; color:#0F172A; border-bottom: 1px solid #E2E8F0; padding-bottom: 10px;">
                <i class="bi bi-sliders me-2" style="color: #C8832A;"></i> @Localizer["Reward_FilterHeading"].Value
            </h5>

            <div class="filter-field mb-3">
                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Reward_SearchLabel"].Value</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="rewardSearchInput" class="form-control border-start-0" placeholder='@Localizer["Reward_SearchPlaceholder"].Value' />
                </div>
            </div>

            <div class="filter-field mb-3">
                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Reward_TypeLabel"].Value</label>
                <select id="rewardTypeFilter" class="form-select form-select-sm">
                    <option value="">@Localizer["Reward_AllTypes"].Value</option>
                    @foreach (var type in Model.AvailableRewards.Select(r => r.RewardType).Distinct().OrderBy(t => t))
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="filter-field mb-3">
                <label class="form-label fw-bold mb-1 small text-uppercase text-muted">@Localizer["Reward_MaxPoints"].Value</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-coin"></i></span>
                    <input type="number" id="rewardMaxPoints" class="form-control border-start-0" min="0" placeholder='@Localizer["Reward_MaxPointsPlaceholder"].Value' />
                </div>
            </div>
        </div>
    </div>

    @if (!Model.AvailableRewards.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-gift" style="font-size:2.5rem;"></i>
            <p class="mb-0 mt-2">@Localizer["Reward_NoneAvailable"].Value</p>
        </div>
    }
    else
    {
        <div id="rewardEmptyFilter" class="text-muted small p-3 text-center" style="display:none">
            <i class="bi bi-exclamation-circle fs-4 d-block mb-1"></i>
            @Localizer["Reward_NoMatch"].Value
        </div>
        <div class="row g-3">
            @foreach (var reward in Model.AvailableRewards)
            {
                var canAfford = Model.PointBalance >= reward.PointsRequired;
                <div class="col-md-6 col-lg-4" data-title="@reward.Title.ToLower()" data-type="@reward.RewardType" data-points="@reward.PointsRequired">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">@reward.Title</h6>
                                <span class="badge bg-@(reward.RewardType == "Discount" ? "primary" : reward.RewardType == "Experience" ? "success" : "info")">@reward.RewardType</span>
                            </div>
                            <p class="small text-muted mb-2">@reward.Description</p>
                            <p class="small mb-2">
                                <i class="bi bi-building me-1"></i> @reward.Sponsor?.Name
                            </p>
                            <p class="small text-muted mb-3">
                                <i class="bi bi-geo-alt me-1"></i>
                                @if (reward.RewardBranches != null && reward.RewardBranches.Any())
                                {
                                    @string.Join(", ", reward.RewardBranches.Select(rb => rb.Branch?.Name).Where(n => !string.IsNullOrEmpty(n)))
                                }
                                else
                                {
                                    <text>Any branch</text>
                                }
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold" style="color: var(--egy-primary);">
                                    <i class="bi bi-coin me-1"></i> @reward.PointsRequired.ToString("N0") pts
                                </span>
                                <form asp-action="Redeem" method="post" asp-route-rewardId="@reward.Id" onsubmit="return confirm('Redeem @reward.Title for @reward.PointsRequired points?');">
                                    <button type="submit" class="btn btn-sm @(canAfford ? "btn-success" : "btn-secondary")" @(canAfford ? "" : "disabled")>
                                         <i class="bi bi-gift me-1"></i> @(canAfford ? @Localizer["Reward_Redeem"].Value : @Localizer["Reward_NotEnough"].Value)
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- My redemptions -->
    @if (Model.MyRedemptions.Any())
    {
        <h4 class="mt-5 mb-3" style="font-family:'Cinzel',serif; color: var(--egy-dark);">
            <i class="bi bi-ticket-perforated me-2"></i> @Localizer["Reward_MyVouchers"].Value
        </h4>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle destinations-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Reward_Code"].Value</th>
                                <th>@Localizer["Reward_Reward"].Value</th>
                                <th>@Localizer["Reward_Points"].Value</th>
                                <th>@Localizer["Reward_Date"].Value</th>
                                <th>@Localizer["Reward_Status"].Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.MyRedemptions)
                            {
                                <tr>
                                    <td class="fw-bold" style="font-family:'Cinzel',serif; letter-spacing:1px;">@r.Code</td>
                                    <td>@r.Reward?.Title</td>
                                    <td>@r.PointsRedeemed.ToString("N0")</td>
                                    <td class="small text-muted">@r.RedemptionDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge bg-@(r.Status == "Active" ? "success" : r.Status == "Used" ? "secondary" : "warning")">@r.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (ViewBag.RewardsCarousel is Tourist_Project_MVC.View_Model.ReviewsCarouselVM rewardVm && rewardVm.Items != null && rewardVm.Items.Any())
{
    <div class="container my-4" style="max-width: 1200px;">
        @await Html.PartialAsync("_ReviewsCarousel", rewardVm)
    </div>
}

@section Scripts {
    <script>
        (function () {
            var cards = document.querySelectorAll('.col-md-6.col-lg-4[data-title]');
            var searchInput = document.getElementById('rewardSearchInput');
            var typeSelect = document.getElementById('rewardTypeFilter');
            var maxPointsInput = document.getElementById('rewardMaxPoints');
            var emptyEl = document.getElementById('rewardEmptyFilter');

            function applyRewardFilter() {
                var search = (searchInput.value || '').toLowerCase().trim();
                var type = typeSelect.value || '';
                var maxPoints = maxPointsInput.value ? parseInt(maxPointsInput.value, 10) : null;
                var visibleCount = 0;

                for (var i = 0; i < cards.length; i++) {
                    var card = cards[i];
                    var title = card.getAttribute('data-title') || '';
                    var rewardType = card.getAttribute('data-type') || '';
                    var points = card.getAttribute('data-points') ? parseInt(card.getAttribute('data-points'), 10) : null;

                    var matchSearch = !search || title.indexOf(search) !== -1;
                    var matchType = !type || rewardType === type;
                    var matchPoints = maxPoints === null || points === null || points <= maxPoints;

                    if (matchSearch && matchType && matchPoints) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                }

                if (emptyEl) emptyEl.style.display = visibleCount === 0 ? '' : 'none';
            }

            var searchTimeout;
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(applyRewardFilter, 180);
            });

            typeSelect.addEventListener('change', applyRewardFilter);
            maxPointsInput.addEventListener('input', applyRewardFilter);
        })();
    </script>
}
