@model Tourist_Project_MVC.View_Model.SupportTicketVM

@{
    ViewData["Title"] = Localizer["SponsorNotification_SupportPageTitle"].Value;
    ViewData["FullWidth"] = true;
}

<div class="notifications-page-wrapper py-4 px-3 px-lg-4">
    <div class="container-fluid max-width-1200">

        <!-- HEADER BAR -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge bg-gold-subtle text-gold fw-bold uppercase-track">
                            <i class="bi bi-headset me-1"></i> Sponsor Helpdesk
                        </span>
                        <span class="badge bg-light text-dark border">Direct Support</span>
                    </div>
                    <h1 class="page-title mb-1">
                        @Localizer["SponsorNotification_SupportTitle"].Value
                    </h1>
                    <p class="text-muted small mb-0">
                        Need assistance with your sponsor account, reward approvals, or GIS branch layers? Contact our support team.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark px-3 py-2 rounded-3 d-flex align-items-center gap-2 btn-sm">
                        <i class="bi bi-bell-fill"></i>
                        <span>Notifications</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- MODULE NAVIGATION TABS -->
        <div class="d-flex align-items-center gap-2 mb-4 border-bottom pb-2">
            <a asp-action="Index" class="btn btn-nav-tab">
                <i class="bi bi-bell-fill me-1"></i> Notifications
            </a>
            <a asp-action="Support" class="btn btn-nav-tab active">
                <i class="bi bi-headset me-1"></i> Sponsor Support
            </a>
        </div>

        @await Html.PartialAsync("_StatBoxRow", (List<Tourist_Project_MVC.View_Model.StatBoxItem>)ViewBag.StatBoxes)

        <div class="row g-4 mt-1">
            <!-- CREATE TICKET FORM -->
            <div class="col-lg-5" id="newTicketForm">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle-fill text-gold"></i>
                            <span>@Localizer["SponsorNotification_NewTicket"].Value</span>
                        </h5>
                    </div>
                    <div class="card-body px-4 pb-4 pt-0">
                        <form asp-action="CreateSupport" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">@Localizer["SponsorNotification_Subject"].Value</label>
                                <input type="text" class="form-control rounded-3" asp-for="Subject" required placeholder="Brief summary of your inquiry..." />
                                <span class="text-danger small" asp-validation-for="Subject"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">@Localizer["SponsorNotification_Category"].Value</label>
                                <select class="form-select rounded-3" asp-for="Category" required>
                                    <option value="">@Localizer["SponsorNotification_SelectCategory"].Value</option>
                                    @foreach (var c in Tourist_Project_MVC.View_Model.SupportTicketVM.Categories)
                                    {
                                        if (Model.Category == c)
                                        {
                                            <option value="@c" selected>@c</option>
                                        }
                                        else
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    }
                                </select>
                                <span class="text-danger small" asp-validation-for="Category"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">@Localizer["SponsorNotification_Description"].Value</label>
                                <textarea class="form-control rounded-3" asp-for="Description" rows="4" required placeholder="Provide full details of your issue or request..."></textarea>
                                <span class="text-danger small" asp-validation-for="Description"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">@Localizer["SponsorNotification_Attachment"].Value</label>
                                <input type="file" class="form-control rounded-3" asp-for="Attachment" accept="image/*,video/*" />
                                <span class="text-danger small" asp-validation-for="Attachment"></span>
                            </div>
                            <button class="btn btn-gold text-white w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2" type="submit">
                                <i class="bi bi-send-fill me-1"></i>
                                <span>@Localizer["SponsorNotification_SubmitTicket"].Value</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- YOUR TICKETS LIST -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-ticket-perforated-fill text-gold"></i>
                            <span>@Localizer["SponsorNotification_YourTickets"].Value</span>
                        </h5>
                        <span class="badge bg-light text-dark border">@Model.Tickets.Count Active</span>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.Tickets.Any())
                        {
                            <div class="py-5 text-center px-4">
                                <div class="empty-icon-box bg-gold-subtle text-gold rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="bi bi-inbox fs-2"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">No Support Tickets</h6>
                                <p class="text-muted small mb-0" style="max-width: 360px; margin: 0 auto;">
                                    You haven't submitted any support tickets yet. Create a ticket on the left if you need assistance.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle custom-tickets-table mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">#</th>
                                            <th>@Localizer["SponsorNotification_Subject"].Value</th>
                                            <th>@Localizer["SponsorNotification_Category"].Value</th>
                                            <th>@Localizer["SponsorNotification_TableHeaderStatus"].Value</th>
                                            <th class="pe-4 text-end">@Localizer["SponsorNotification_Date"].Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int i = 1; }
                                        @foreach (var t in Model.Tickets)
                                        {
                                            var statusBadge = t.Status switch
                                            {
                                                "Open" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                                "Resolved" => "bg-success-subtle text-success border border-success-subtle",
                                                _ => "bg-info-subtle text-info border border-info-subtle"
                                            };
                                            <tr>
                                                <td class="ps-4 fw-bold text-muted">@i.ToString("D2")</td>
                                                <td>
                                                    <a asp-action="SupportDetails" asp-route-id="@t.Id" class="fw-bold text-dark text-decoration-none hover-gold">
                                                        @t.Subject
                                                    </a>
                                                    @if (!string.IsNullOrEmpty(t.AdminResponse))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" title="@Localizer["SponsorNotification_AdminResponded"].Value">
                                                            <i class="bi bi-reply-fill"></i>
                                                        </span>
                                                    }
                                                </td>
                                                <td><span class="badge bg-light text-dark border font-monospace">@t.Category</span></td>
                                                <td>
                                                    <span class="badge @statusBadge">@t.Status</span>
                                                </td>
                                                <td class="pe-4 text-end small text-muted font-monospace">@t.CreatedDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        .max-width-1200 {
            max-width: 1200px;
            margin: 0 auto;
        }

        .bg-gold-subtle {
            background-color: rgba(200, 131, 42, 0.12) !important;
        }

        .text-gold {
            color: #c8832a !important;
        }

        .btn-gold {
            background: linear-gradient(135deg, #c8832a 0%, #a4671e 100%);
            border: none;
            transition: all 0.25s ease;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #b57322 0%, #8e5716 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(200, 131, 42, 0.35) !important;
        }

        .uppercase-track {
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 0.72rem;
        }

        .page-title {
            font-family: 'Cinzel', serif;
            font-weight: 700;
            color: #2c1a0e;
        }

        .btn-nav-tab {
            color: #6c757d;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

        .btn-nav-tab:hover {
            color: #c8832a;
            background-color: rgba(200, 131, 42, 0.06);
        }

        .btn-nav-tab.active {
            color: #2c1a0e;
            background-color: rgba(200, 131, 42, 0.12);
            border-color: rgba(200, 131, 42, 0.25);
        }

        .custom-tickets-table th {
            background-color: #fcfbfa;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #6c757d;
            border-bottom: 2px solid #f0e9df;
            padding-top: 12px;
            padding-bottom: 12px;
        }

        .custom-tickets-table td {
            padding-top: 14px;
            padding-bottom: 14px;
            font-size: 0.9rem;
            border-bottom: 1px solid #f6f2ec;
        }

        .hover-gold:hover {
            color: #c8832a !important;
        }
    </style>
}