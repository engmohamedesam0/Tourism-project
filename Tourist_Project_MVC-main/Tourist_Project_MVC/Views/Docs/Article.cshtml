@model Tourist_Project_MVC.View_Model.DocViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Article.Title + " — Docs";
    ViewData["FullWidth"] = true;
    var currentArticle = Model.Article;
    var isTripPlanning = currentArticle.Slug.Contains("trip-planning");
}

@section Styles {
    <link href="~/css/docs.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/docs.js" asp-append-version="true"></script>
}

<div class="docs-shell">
    <!-- Mobile sidebar toggle (visible below md) -->
    <div class="px-3 d-block d-md-none">
        <button type="button" id="docsSidebarToggle" class="btn btn-outline-secondary docs-mobile-toggle" aria-expanded="false" aria-controls="docsSidebar">
            <i class="bi bi-list me-2"></i> Docs Menu
        </button>
    </div>

    <!-- Backdrop for mobile sidebar -->
    <div id="docsSidebarBackdrop" class="docs-sidebar-backdrop"></div>

    <!-- LEFT SIDEBAR -->
    <aside id="docsSidebar" class="docs-sidebar d-flex flex-column">
        <div>
            <a asp-controller="Docs" asp-action="Index" class="docs-sidebar-brand">
                <i class="bi bi-book-half"></i> EGYXPLORE Docs
            </a>

            @foreach (var section in Model.Sections)
            {
                <div class="docs-sidebar-section" data-section-id="@(section.Id)">
                    <div class="docs-sidebar-section-header d-flex align-items-center justify-content-between">
                        <div class="docs-sidebar-section-title d-flex align-items-center gap-2">
                        @if (section.Id.Equals("tourists", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="sec-badge sec-badge-tourist"><i class="bi bi-compass-fill"></i></span>
                            <span class="sec-title-text">For Tourists</span>
                        }
                        else if (section.Id.Equals("sponsors", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="sec-badge sec-badge-sponsor"><i class="bi bi-briefcase-fill"></i></span>
                            <span class="sec-title-text">For Sponsors</span>
                        }
                        else if (section.Id.Equals("admins", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="sec-badge sec-badge-admin"><i class="bi bi-person-gear-fill"></i></span>
                            <span class="sec-title-text">For Admins</span>
                        }
                        else
                        {
                            <span class="sec-badge sec-badge-default"><i class="bi bi-folder-fill"></i></span>
                            <span class="sec-title-text">@(section.Title)</span>
                        }
                    </div>
                        <button type="button" class="docs-sidebar-toggle-section" aria-expanded="true" aria-label="Toggle @(section.Title) section">
                            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
                        </button>
                    </div>
                    <ul class="docs-sidebar-list">
                        @foreach (var article in section.Articles)
                        {
                            var isActive = article.Section.Equals(currentArticle.Section, StringComparison.OrdinalIgnoreCase)
                                && article.Slug.Equals(currentArticle.Slug, StringComparison.OrdinalIgnoreCase);
                            <li>
                                <a asp-controller="Docs" asp-action="Article"
                                   asp-route-section="@article.Section"
                                   asp-route-slug="@article.Slug"
                                   class="@(isActive ? "active" : "")">
                                    @if(isActive)
                                    {
                                        <i class="bi bi-book me-2"></i>
                                    }
                                    @article.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
        
        <div class="mt-auto pt-4">
            <div class="docs-promo-card p-0 border-0 bg-transparent shadow-none">
                <img src="/images/image Aug 16, 2026, 05_17_59 AM.png" alt="Promo" class="img-fluid rounded-4 w-100" style="object-fit: cover;" />
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="docs-main">
        <!-- Hero Section -->
        <section class="docs-hero @(isTripPlanning ? "docs-hero-trip" : "")">
            @if (isTripPlanning)
            {
                <div class="docs-hero-trip-content">
                    <span class="docs-hero-category-badge"><i class="bi bi-person me-1"></i> FOR TOURISTS</span>
                    <h1 class="docs-hero-title-large">@currentArticle.Title</h1>
                    <p class="docs-hero-description-large">@currentArticle.Description</p>
                    
                    <div class="docs-hero-features-row">
                        <div class="docs-hero-feature">
                            <div class="feature-icon"><i class="bi bi-map"></i></div>
                            <div>
                                <strong>Build</strong>
                                <span>Create your perfect itinerary</span>
                            </div>
                        </div>
                        <div class="docs-hero-feature">
                            <div class="feature-icon"><i class="bi bi-bookmark"></i></div>
                            <div>
                                <strong>Save</strong>
                                <span>Save and access anytime</span>
                            </div>
                        </div>
                        <div class="docs-hero-feature">
                            <div class="feature-icon"><i class="bi bi-share"></i></div>
                            <div>
                                <strong>Share</strong>
                                <span>Share with friends and companions</span>
                            </div>
                        </div>
                        <div class="docs-hero-feature">
                            <div class="feature-icon"><i class="bi bi-heart"></i></div>
                            <div>
                                <strong>Curated</strong>
                                <span>Discover admin-curated plans</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <span class="docs-hero-category">@currentArticle.Category</span>
                <h1 class="docs-hero-title">@currentArticle.Title</h1>
                <p class="docs-hero-description">@currentArticle.Description</p>
                @if (currentArticle.Tags != null && currentArticle.Tags.Any())
                {
                    <div class="docs-hero-tags">
                        @foreach (var tag in currentArticle.Tags)
                        {
                            <span class="docs-hero-tag">@tag</span>
                        }
                    </div>
                }
            }
        </section>

        <!-- Search Bar -->
        <div class="docs-search mb-4">
            <button type="button" class="docs-search-icon-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
            <input type="search" id="docsSearchInput" placeholder="Search documentation..." autocomplete="off" aria-label="Search documentation" />
            <button type="button" id="docsFilterBtn" class="docs-filter-btn" aria-haspopup="true" aria-expanded="false" aria-label="Filter results">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
            </button>
            <div id="docsFilterMenu" class="docs-filter-menu">
                <button type="button" class="docs-filter-item active" data-section="">All Sections</button>
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="docs-filter-item" data-section="tourists">For Tourists</button>
                    <button type="button" class="docs-filter-item" data-section="sponsors">For Sponsors</button>
                    <button type="button" class="docs-filter-item" data-section="admins">For Admins</button>
                }
                else if (User.IsInRole("Sponsor"))
                {
                    <button type="button" class="docs-filter-item" data-section="tourists">For Tourists</button>
                    <button type="button" class="docs-filter-item" data-section="sponsors">For Sponsors</button>
                }
                else
                {
                    @* Guest or Tourist account *@
                    <button type="button" class="docs-filter-item" data-section="tourists">For Tourists</button>
                }
            </div>
            <div id="docsSearchResults" class="docs-search-results"></div>
        </div>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="docs-breadcrumb mb-3">
            <a asp-controller="Docs" asp-action="Index">Docs</a>
            <span class="sep"><i class="bi bi-chevron-right"></i></span>
            <span class="current">@currentArticle.Section</span>
            <span class="sep"><i class="bi bi-chevron-right"></i></span>
            <span class="current" style="color: var(--docs-accent); font-weight: 600;">@currentArticle.Title</span>
        </nav>

        <!-- Article Content -->
        <article class="docs-article">
            @if (isTripPlanning)
            {
                <h1 class="docs-article-main-title">@currentArticle.Title</h1>
                <p class="docs-article-intro">
                    EGYXPLORE lets you build, save, and share multi-stop itineraries.
                    The <a href="#">trip planner <i class="bi bi-arrow-up-right"></i></a> is powered by <strong>TripController</strong> and surfaces curated plans from <strong>TripPlanController</strong> that Admins publish for the community.
                </p>
                <div class="docs-feature-grid mb-5">
                    <div class="docs-feature-card">
                        <div class="icon-circle"><i class="bi bi-map"></i></div>
                        <h5>BUILD YOUR TRIP</h5>
                        <p>Add multiple stops, activities, and experiences to create your perfect itinerary.</p>
                    </div>
                    <div class="docs-feature-card">
                        <div class="icon-circle"><i class="bi bi-bookmark"></i></div>
                        <h5>SAVE & ACCESS</h5>
                        <p>Save your trips and access them anytime from your profile.</p>
                    </div>
                    <div class="docs-feature-card">
                        <div class="icon-circle"><i class="bi bi-share"></i></div>
                        <h5>SHARE ITINERARY</h5>
                        <p>Share your itinerary with friends and family and travel together.</p>
                    </div>
                    <div class="docs-feature-card">
                        <div class="icon-circle"><i class="bi bi-heart"></i></div>
                        <h5>CURATED PLANS</h5>
                        <p>Browse admin-curated itineraries and get inspired for your next adventure.</p>
                    </div>
                </div>
            }
            
            @Html.Raw(currentArticle.HtmlContent)
        </article>



        <!-- Prev / Next -->
        <nav class="docs-pagination d-flex justify-content-between mt-5 pt-4 border-top" aria-label="Doc pagination">
            <span></span>

            @if (Model.NextArticle != null)
            {
                <a asp-controller="Docs" asp-action="Article" asp-route-section="@Model.NextArticle.Section" asp-route-slug="@Model.NextArticle.Slug" class="btn-premium-docs text-decoration-none shadow-sm next">
                    <div class="d-flex flex-column text-end">
                        <span class="small text-muted fw-normal" style="line-height: 1;">Next</span>
                        <span>@Model.NextArticle.Title</span>
                    </div>
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            }
        </nav>
    </div>

    <!-- RIGHT ASIDE (TOC & Promo) -->
    <aside class="docs-toc d-flex flex-column" aria-label="Table of contents and promo">
        <div class="docs-promo-card right-promo p-0 border-0 bg-transparent shadow-none">
            <img src="/images/Image Aug 16, 2026, 05_23_18 AM.png" alt="Plan Smarter Promo" class="img-fluid rounded-4 w-100" style="object-fit: cover;" />
        </div>

        @if (currentArticle.Headings != null && currentArticle.Headings.Any())
        {
            <div class="docs-toc-card mt-4">
                <div class="docs-toc-head">
                    <span class="docs-toc-icon"><i class="bi bi-list-ul"></i></span>
                    <span class="docs-toc-title">On This Page</span>
                </div>
                <ul class="docs-toc-list">
                    @foreach (var h in currentArticle.Headings.Where(h => h.Level <= 3))
                    {
                        <li class="level-@h.Level">
                            <a href="#@h.Id">@h.Text</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </aside>
</div>

<!-- Floating Action Button -->
<button type="button" class="docs-fab-sparkles" aria-label="Ask AI Assistant">
    <i class="bi bi-stars"></i>
</button>

