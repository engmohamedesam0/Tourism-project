@model Tourist_Project_MVC.View_Model.NotificationBellVM

<button type="button"
        id="notificationFabBtn"
        class="fab-base notification-fab"
        data-user-role="@Model.UserRole"
        aria-label="Notifications"
        aria-expanded="false"
        aria-controls="notificationPanel">
    <div class="notification-bell-icon-wrapper">
        <svg class="notification-bell-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <span class="notification-fab-badge" id="notifFabBadge">@Model.UnreadCount</span>
    }
</button>

