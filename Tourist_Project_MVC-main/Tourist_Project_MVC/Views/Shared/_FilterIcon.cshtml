@* Views/Shared/_FilterIcon.cshtml
   Reusable inline filter icon — static/idle by default.
   The sliding-dots animation plays on hover, keyboard focus,
   or when the .active class is applied (e.g. toggle a filter panel).
   Uses currentColor so light/dark theme colors are inherited. *@
<span class="filter-icon-trigger d-inline-flex align-items-center justify-content-center"
      role="img" aria-hidden="true"
      title="@Localizer["Trip_Filter"].Value">
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 560 560" fill="none"
         class="filter-icon-svg"
         width="32" height="32" aria-hidden="true">
        <!-- Bar 1 (top) -->
        <rect class="filter-icon-bar" x="83.25" y="152.5" width="392.5" height="17.5" rx="8.75" />
        <!-- Dot 1 — starts right, slides left -->
        <circle class="filter-icon-dot" data-dot="1" cx="396.25" cy="161.25" r="38.75" />

        <!-- Bar 2 (middle) -->
        <rect class="filter-icon-bar" x="83.25" y="272.375" width="392.5" height="17.5" rx="8.75" />
        <!-- Dot 2 — starts left, slides right -->
        <circle class="filter-icon-dot" data-dot="2" cx="166.25" cy="281.125" r="38.75" />

        <!-- Bar 3 (bottom) -->
        <rect class="filter-icon-bar" x="83.25" y="392.375" width="392.5" height="17.5" rx="8.75" />
        <!-- Dot 3 — starts right-ish, slides left -->
        <circle class="filter-icon-dot" data-dot="3" cx="314.25" cy="401.125" r="38.75" />
    </svg>
</span>
