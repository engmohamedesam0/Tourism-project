    <!-- ============================================================
         FLOATING AI ASSISTANT (live — talks to /AiChat/Send)
         ============================================================ -->
    <button type="button"
            id="aiAssistantBtn"
            class="fab-base ai-fab"
            aria-label="@Localizer["Ai_Open"].Value"
            aria-expanded="false"
            aria-controls="aiAssistantPanel">
        <i class="bi bi-stars"></i>
    </button>

    @await Component.InvokeAsync("NotificationFab")

    <div class="ai-widget-panel" id="aiAssistantPanel" aria-hidden="true"
         data-send-url="@Url.Action("Send", "AiChat")"
         data-trip-url-template="@Url.Action("Details", "Trip", new { id = "__ID__" })"
         data-history-url="@Url.Action("GetHistory", "AiChat")"
         data-history-session-url-template="@Url.Action("GetHistorySession", "AiChat", new { id = "__ID__" })"
         data-history-empty-text="@Localizer["Ai_HistoryEmpty"].Value"
         data-history-error-text="@Localizer["Ai_Error"].Value"
         data-thinking-text="@Localizer["Ai_Thinking"].Value"
         data-error-text="@Localizer["Ai_Error"].Value"
         data-view-trip-text="@Localizer["Ai_ViewTrip"].Value">
         <div class="ai-widget-header">
             <h5 class="ai-widget-title">
                 <i class="bi bi-stars me-2"></i> @Localizer["Ai_Title"].Value
             </h5>
             <div class="ai-widget-header-actions">
                 <button type="button" class="ai-widget-history-toggle" id="aiHistoryBtn"
                         aria-label="@Localizer["Ai_History"].Value">
                     <i class="bi bi-clock-history"></i>
                 </button>
                 <button type="button" class="ai-menu-btn" id="aiMenuBtn"
                         aria-label="Menu" aria-haspopup="true" aria-expanded="false">
                     <i class="bi bi-list"></i>
                 </button>
                 <div class="ai-menu-dropdown" id="aiMenuDropdown" role="menu">
                     <button class="ai-menu-item" id="aiMenuNewChat" role="menuitem">
                         <i class="bi bi-plus-circle"></i> New Chat
                     </button>
                     <button class="ai-menu-item" id="aiMenuHistoryItem" role="menuitem"
                             onclick="document.getElementById('aiHistoryBtn')?.click(); document.getElementById('aiMenuDropdown')?.classList.remove('ai-menu-visible');">
                         <i class="bi bi-clock-history"></i> Chat History
                     </button>
                     <div class="ai-menu-divider"></div>
                     <button class="ai-menu-item" id="aiMenuClearChat" role="menuitem">
                         <i class="bi bi-trash3"></i> Clear Conversation
                     </button>
                 </div>
                 <button type="button" class="ai-widget-close" aria-label="@Localizer["Ai_Close"].Value">
                     <i class="bi bi-x-lg"></i>
                 </button>
             </div>
         </div>
         <div class="ai-widget-body" id="aiChatMessages">
             <div class="ai-chat-msg ai-chat-msg-assistant">
                 <div class="ai-chat-bubble">@Localizer["Ai_Description"].Value</div>
             </div>
         </div>
         <div class="ai-widget-history" id="aiWidgetHistory" hidden>
             <div class="ai-widget-history-header">
                 <button type="button" class="ai-history-back-btn" id="aiHistoryBackBtn"
                         aria-label="@Localizer["Ai_Back"].Value">
                     <i class="bi bi-arrow-left"></i>
                 </button>
                 <span>@Localizer["Ai_History"].Value</span>
             </div>
             <div class="ai-widget-history-list" id="aiHistoryList">
             </div>
         </div>
         <form class="ai-widget-footer" id="aiChatForm" autocomplete="off">
             <input type="text" class="form-control" id="aiChatInput"
                    placeholder="@Localizer["Ai_Placeholder"].Value" maxlength="1000" />
             <button type="submit" class="btn btn-secondary" id="aiChatSendBtn">@Localizer["Ai_Send"].Value</button>
         </form>
    </div>

    <!-- ============================================================
         FLOATING NOTIFICATION PANEL (slide-out like AI widget; sponsors
         load live notifications, other roles see an empty state)
         ============================================================ -->
    <div class="notification-widget-panel" id="notificationPanel" aria-hidden="true">
        <div class="notification-widget-header">
            <h5 class="notification-widget-title">
                <i class="bi bi-bell-fill me-2"></i> @Localizer["Nav_Notifications"].Value
            </h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="notification-mark-all-read" id="markAllReadBtn">
                    <i class="bi bi-check2-all me-1"></i> @Localizer["Nav_MarkAllRead"].Value
                </button>
                <button type="button" class="notification-widget-close" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="notification-widget-body" id="notificationPanelBody">
            <div class="text-center py-4">
                <div class="spinner-border text-warning" role="status"></div>
            </div>
        </div>
    </div>

    <!-- Global anti-forgery token for AJAX POSTs (read by JS helpers). -->
    <form id="antiforgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Maps JS (EGYMaps) — must load BEFORE per-page Scripts section -->
    <script src="~/js/maps.js" asp-append-version="true"></script>
    <!-- Grayscale Script -->
    <script src="~/js/scripts.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.hideGlobalLoader = function () {
            document.body.classList.add('loaded');
        };

        window.addEventListener('load', function () {
            window.hideGlobalLoader();
        });
    </script>

</body>
</html>
