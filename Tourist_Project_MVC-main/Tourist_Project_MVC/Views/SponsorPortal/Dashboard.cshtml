@model Tourist_Project_MVC.View_Model.SponsorDashboardVM

@{
    ViewData["Title"] = "Sponsor Dashboard";
    ViewData["IsHomePage"] = false;
    ViewData["FullWidth"] = true;
    var currentYear = DateTime.Now.Year;
}

@section Styles {
    <link rel="stylesheet" href="~/css/sponsor-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">
    <div class="container-fluid px-3 px-xl-4 py-2">
        
        <!-- DASHBOARD HEADER -->
        <div class="dash-header-card mb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="dash-header-left">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb breadcrumb-custom">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><partial name="_EgyxploreWordmark" /></a></li>
                            <li class="breadcrumb-item active" aria-current="page">Sponsor Portal</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <h1 class="dash-title mb-0">Sponsor Analytics Dashboard</h1>
                        <span class="dash-sponsor-badge"><i class="bi bi-shield-check"></i> Enterprise Partner</span>
                        <span class="dash-status-pill"><span class="pulse-dot"></span> Live Portal</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-controller="SponsorBranch" asp-action="Index" class="btn btn-outline-dark dash-action-btn">
                        <i class="bi bi-geo-alt-fill me-1"></i> Manage Branches
                    </a>
                    <a asp-controller="Reward" asp-action="Index" class="btn btn-primary dash-action-btn btn-egy-gold">
                        <i class="bi bi-gift-fill me-1"></i> Manage Rewards
                    </a>
                </div>
            </div>
        </div>

        <!-- TOP KPI CARDS GRID -->
        <div class="kpi-grid mb-3">
            <div class="kpi-card gold">
                <div class="kpi-card-top-bar gold"></div>
                <div class="kpi-icon-wrapper gold">
                    <i class="bi bi-shop"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Active Branches</div>
                    <div class="kpi-value">@Model.TotalBranches</div>
                    <div class="kpi-sub"><i class="bi bi-geo-alt me-1"></i>Registered locations</div>
                </div>
            </div>
            
            <div class="kpi-card dark">
                <div class="kpi-card-top-bar dark"></div>
                <div class="kpi-icon-wrapper dark">
                    <i class="bi bi-gift"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Total Rewards</div>
                    <div class="kpi-value">@Model.TotalRewards</div>
                    <div class="kpi-sub"><i class="bi bi-tags me-1"></i>Available offers</div>
                </div>
            </div>

            <div class="kpi-card green">
                <div class="kpi-card-top-bar green"></div>
                <div class="kpi-icon-wrapper green">
                    <i class="bi bi-check2-square"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Redemptions</div>
                    <div class="kpi-value">@Model.TotalRedemptions.ToString("N0")</div>
                    <div class="kpi-sub"><i class="bi bi-arrow-up-right me-1"></i>Total claims</div>
                </div>
            </div>

            <div class="kpi-card amber">
                <div class="kpi-card-top-bar amber"></div>
                <div class="kpi-icon-wrapper amber">
                    <i class="bi bi-eye-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Reward Views</div>
                    <div class="kpi-value">@Model.RewardViewCount.ToString("N0")</div>
                    <div class="kpi-sub"><i class="bi bi-people me-1"></i>Tourist engagement</div>
                </div>
            </div>
        </div>

        <!-- MAIN DASHBOARD GRID (3 COLUMNS) -->
        <div class="dashboard-main-grid mb-3">
            
            <!-- LEFT COLUMN (PROFILE & FILTERS) -->
            <aside class="dash-sidebar">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <span><i class="bi bi-person-badge-fill me-2"></i> Sponsor Info</span>
                        <span class="badge bg-soft-gold text-gold">Verified</span>
                    </div>
                    <div class="dash-card-body sponsor-profile-meta">
                        <div class="mb-2">
                            <h3 class="sponsor-name-heading">@Model.SponsorName</h3>
                            <span class="sponsor-type-tag"><i class="bi bi-award-fill me-1"></i> Official Partner</span>
                        </div>
                        
                        <div class="profile-info-item mb-2">
                            <i class="bi bi-building"></i>
                            <span>Enterprise GIS Subscriber</span>
                        </div>
                        
                        <div class="mt-2 pt-2 border-top">
                            <div class="info-row">
                                <span class="info-row-label">Joined Year</span>
                                <span class="info-row-val">@currentYear</span>
                            </div>
                            <div class="info-row">
                                <span class="info-row-label">Account Status</span>
                                <span class="info-row-val text-success"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-card-header">
                        <span><i class="bi bi-funnel-fill me-2"></i> Map Filters</span>
                    </div>
                    <div class="dash-card-body">
                        <div class="chips-filter-group">
                            <button class="chip-btn chip-active" onclick="filterMap('all', this)">
                                <span><i class="bi bi-layers me-2"></i> All Branches</span>
                                <i class="bi bi-check-lg check-icon"></i>
                            </button>
                            <button class="chip-btn" onclick="filterMap('active', this)">
                                <span><i class="bi bi-graph-up-arrow me-2"></i> High Activity</span>
                                <i class="bi bi-check-lg check-icon"></i>
                            </button>
                            <button class="chip-btn" onclick="filterMap('recent', this)">
                                <span><i class="bi bi-clock-history me-2"></i> Recently Added</span>
                                <i class="bi bi-check-lg check-icon"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- CENTER COLUMN (INTERACTIVE MAP) -->
            <main class="dash-center-column">
                <div class="dash-map-card">
                    <div class="map-card-bar">
                        <div class="map-card-title">
                            <i class="bi bi-geo-alt-fill"></i> Network Coverage Map
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="map-live-indicator">
                                <div class="live-dot"></div>
                                LIVE GIS DATA
                            </div>
                        </div>
                    </div>
                    <div class="dash-map-container" id="dashboardMap">
                        <div class="map-watermark">
                            <h2><partial name="_EgyxploreWordmark" /></h2>
                        </div>
                    </div>
                </div>
            </main>

            <!-- RIGHT COLUMN (RATING & HIGHLIGHTS) -->
            <aside class="dash-widgets">
                <div class="dash-card rating-widget-card">
                    <div class="dash-card-header justify-content-center border-0 bg-transparent pb-0">
                        <span><i class="bi bi-star-fill me-2 text-warning"></i> AI Satisfaction</span>
                    </div>
                    <div class="dash-card-body">
                        @if (Model.RatingAvailable)
                        {
                            <div class="rating-gauge-wrapper" style="--rating: @(Model.AverageRating / 5.0)">
                                <div class="rating-gauge">
                                    <div class="rating-gauge-value">@Model.AverageRating?.ToString("0.0")</div>
                                </div>
                            </div>
                            <div class="rating-stars mt-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating ?? 0))
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>
                            <div class="kpi-sub mt-2">Based on tourist feedback</div>
                        }
                        else
                        {
                            <div class="text-muted py-3">
                                <i class="bi bi-info-circle display-5 d-block mb-2 text-black-50"></i>
                                No ratings available yet.
                            </div>
                        }
                    </div>
                </div>

                <div class="dash-card top-performing-card">
                    <div class="dash-card-header bg-transparent">
                        <span><i class="bi bi-trophy-fill me-2 text-gold"></i> Top Performer</span>
                    </div>
                    <div class="dash-card-body">
                        <div class="kpi-label mb-2">Most Active Location</div>
                        <div class="top-branch-item">
                            <div class="top-branch-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold branch-name-text">
                                    @(string.IsNullOrEmpty(Model.MostActiveBranchName) ? "Analyzing data..." : Model.MostActiveBranchName)
                                </h6>
                                <span class="text-muted small">Highest engagement rate</span>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

        </div>

        <!-- BOTTOM CHARTS GRID -->
        <div class="charts-grid">
            <div class="chart-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-graph-up-arrow me-2"></i> Monthly Performance</span>
                    <span class="chart-badge">Line Trend</span>
                </div>
                <div class="chart-body-wrapper">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-bar-chart-line-fill me-2"></i> Top Rewards by Claims</span>
                    <span class="chart-badge">Claims</span>
                </div>
                <div class="chart-body-wrapper">
                    @if (Model.DashboardTopRewards.Any())
                    {
                        <canvas id="topRewardsChart"></canvas>
                    }
                    else
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center">
                            @await Html.PartialAsync("_EmptyState", null, new ViewDataDictionary(ViewData)
                            {
                                { "EmptyStateTitle", "No Reward Data" },
                                { "EmptyStateDescription", "Top rewards will appear here once tourists start redeeming your offers." },
                                { "EmptyStateCompact", true }
                            })
                        </div>
                    }
                </div>
            </div>

            <div class="chart-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-pie-chart-fill me-2"></i> Engagement Split</span>
                    <span class="chart-badge">Share</span>
                </div>
                <div class="chart-body-wrapper">
                    <canvas id="engagementPieChart"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // --- 1. Initialize Map ---
        (function () {
            window.sponsorBranchLatlngs = [@foreach (var b in Model.SponsorBranches) {<text>[@b.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture), @b.Lng.ToString(System.Globalization.CultureInfo.InvariantCulture)],</text>}];

            var dashboardMap = EGYMaps.initWfsMap({
                mapElId: 'dashboardMap',
                layer: 'branches',
                propMap: {
                    id: ['Id', 'id', 'SponsorId'],
                    name: ['Name', 'name', 'branch_name']
                },
                useLayerStyle: true,
                popupHtml: function (ctx) {
                    var p = ctx.attributes || {};
                    var name = p['Name'] || p['name'] || p['branch_name'] || 'Unnamed Branch';
                    return '<div style="text-align:center;">' +
                           '<strong class="popup-name">' + name + '</strong>' +
                           '<br><span class="popup-verified"><i class="bi bi-shield-check"></i> Verified Partner</span>' +
                           '</div>';
                },
                onLayerReady: function () {
                    // Filter to show only this sponsor's branches on the feature layer
                    if (dashboardMap && dashboardMap.filterMarkers) {
                        dashboardMap.filterMarkers(function (f) {
                            var p = f.attributes || {};
                            var sid = p.SponsorId !== undefined ? p.SponsorId : (p.sponsor_id !== undefined ? p.sponsor_id : (p.SponsorID !== undefined ? p.SponsorID : p.sponsorId));
                            return String(sid) === String(@Model.SponsorId);
                        });
                    }

                    // Auto-zoom to fit sponsor's branches
                    if (window.sponsorBranchLatlngs && window.sponsorBranchLatlngs.length && dashboardMap && dashboardMap.fitBounds) {
                        dashboardMap.fitBounds(window.sponsorBranchLatlngs);
                    }
                }
            });

            // Map Filter functionality (UI simulation)
            window.filterMap = function (filterType, btnEl) {
                if (btnEl) {
                    document.querySelectorAll('.chip-btn').forEach(btn => btn.classList.remove('chip-active'));
                    btnEl.classList.add('chip-active');
                }
            };
        })();

        // --- 2. Initialize Charts with Modern Gradient Styling ---
        (function () {
            Chart.defaults.font.family = "'Nunito', sans-serif";
            Chart.defaults.color = '#1E120A';

            var themePrimary = '#C8832A'; // Gold
            var themeDark = '#1E120A';    // Dark
            var themeAccent = '#E8A045';  // Amber

            // Helper to build linear gradient for Chart.js
            function createGradient(ctx, colorStart, colorEnd) {
                var gradient = ctx.createLinearGradient(0, 0, 0, 240);
                gradient.addColorStop(0, colorStart);
                gradient.addColorStop(1, colorEnd);
                return gradient;
            }

            // 1. Monthly Trend Chart
            var monthLabels = [@Html.Raw(string.Join(",", Model.MonthlyStats.Select(r => $"\"{r.MonthLabel}\"")))];
            var redemptionsData = [@Html.Raw(string.Join(",", Model.MonthlyStats.Select(r => r.Redemptions)))];
            var viewsData = [@Html.Raw(string.Join(",", Model.MonthlyStats.Select(r => r.Views)))];
            
            var canvasTrend = document.getElementById('monthlyTrendChart');
            if (canvasTrend) {
                var ctxTrend = canvasTrend.getContext('2d');
                var fillGradient = createGradient(ctxTrend, 'rgba(200, 131, 42, 0.35)', 'rgba(200, 131, 42, 0.02)');
                
                new Chart(ctxTrend, {
                    type: 'line',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: 'Redemptions',
                                data: redemptionsData,
                                borderColor: themePrimary,
                                backgroundColor: fillGradient,
                                borderWidth: 3,
                                pointBackgroundColor: '#ffffff',
                                pointBorderColor: themePrimary,
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                fill: true,
                                tension: 0.4
                            },
                            {
                                label: 'Views',
                                data: viewsData,
                                borderColor: themeDark,
                                backgroundColor: 'transparent',
                                borderWidth: 2,
                                borderDash: [5, 5],
                                pointRadius: 3,
                                tension: 0.4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, boxWidth: 8, font: { weight: '600', size: 12 } }
                            },
                            tooltip: {
                                backgroundColor: '#1E120A',
                                titleFont: { family: 'Cinzel', size: 13, weight: '700' },
                                padding: 10,
                                cornerRadius: 8
                            }
                        },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(200, 131, 42, 0.08)' } },
                            x: { grid: { display: false } }
                        },
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        }
                    }
                });
            }

            // 2. Top Rewards Bar Chart
            @if (Model.DashboardTopRewards.Any())
            {
                <text>
                var rewardLabels = [@Html.Raw(string.Join(",", Model.DashboardTopRewards.Select(r => $"\"{r.RewardTitle}\"")))];
                var rewardData = [@Html.Raw(string.Join(",", Model.DashboardTopRewards.Select(r => r.Redemptions)))];
                
                var canvasRewards = document.getElementById('topRewardsChart');
                if (canvasRewards) {
                    var ctxRewards = canvasRewards.getContext('2d');
                    var barGradient = createGradient(ctxRewards, themePrimary, themeAccent);
                    
                    new Chart(ctxRewards, {
                        type: 'bar',
                        data: {
                            labels: rewardLabels,
                            datasets: [{
                                label: 'Total Claims',
                                data: rewardData,
                                backgroundColor: barGradient,
                                borderRadius: 8,
                                barThickness: 20
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#1E120A',
                                    padding: 10,
                                    cornerRadius: 8
                                }
                            },
                            scales: {
                                x: { beginAtZero: true, grid: { color: 'rgba(200, 131, 42, 0.08)' } },
                                y: { grid: { display: false } }
                            }
                        }
                    });
                }
                </text>
            }

            // 3. Engagement Split
            var canvasPie = document.getElementById('engagementPieChart');
            if (canvasPie) {
                new Chart(canvasPie, {
                    type: 'doughnut',
                    data: {
                        labels: ['Redemptions', 'Views'],
                        datasets: [{
                            data: [@Model.TotalRedemptions, @Model.RewardViewCount],
                            backgroundColor: [themePrimary, themeDark],
                            borderWidth: 3,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { padding: 16, usePointStyle: true, font: { weight: '600' } }
                            },
                            tooltip: {
                                backgroundColor: '#1E120A',
                                padding: 10,
                                cornerRadius: 8
                            }
                        },
                        cutout: '72%'
                    }
                });
            }
        })();
    </script>
}
