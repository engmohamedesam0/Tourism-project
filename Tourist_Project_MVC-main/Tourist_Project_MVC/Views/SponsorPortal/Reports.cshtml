@model Tourist_Project_MVC.View_Model.SponsorReportsVM

@{
    ViewData["Title"] = Localizer["SponsorPortal_Reports"].Value + " - " + Model.CurrentSponsorName;
    ViewData["FullWidth"] = true;

    var totalRedemptions = Model.ReportRows.Sum(r => r.Redemptions);
    var totalPoints = Model.ReportRows.Sum(r => r.PointsRedeemed);
    var totalViews = Model.ReportRows.Sum(r => r.Views);
    var peakMonthRow = Model.ReportRows.OrderByDescending(r => r.Redemptions).FirstOrDefault();
    var peakMonth = peakMonthRow != null && peakMonthRow.Redemptions > 0 ? peakMonthRow.MonthLabel : "—";
    var maxRedemptions = Model.ReportRows.Any() ? Math.Max(1, Model.ReportRows.Max(r => r.Redemptions)) : 1;
}

<div class="reports-page-wrapper py-4 px-3 px-lg-4">
    <div class="container-fluid max-width-1300">

        <!-- REPORT HEADER & ACTION BAR -->
        <div class="report-header card border-0 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge bg-gold-subtle text-gold fw-bold uppercase-track me-1">
                            <i class="bi bi-shield-check me-1"></i> Official Report
                        </span>
                        <span class="badge bg-light text-dark border me-1">@Model.Year Fiscal Period</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-circle-fill me-1 small"></i> Verified Sponsor
                        </span>
                    </div>
                    <h1 class="report-title mb-1">
                        <i class="bi bi-bar-chart-line-fill text-gold me-2"></i> @Model.CurrentSponsorName — Activity Report
                    </h1>
                    <p class="text-muted small mb-0">
                        Detailed monthly analytics, tourist reward claims, and performance summary for <strong>@Model.CurrentSponsorName</strong> &middot; Generated on @DateTime.Now.ToString("dd MMMM yyyy")
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2 no-print">
                    <button onclick="window.print()" class="btn btn-gold text-white px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 fw-semibold">
                        <i class="bi bi-printer-fill fs-5"></i>
                        <span>Print / Export PDF</span>
                    </button>
                    <a asp-controller="SponsorPortal" asp-action="Dashboard" class="btn btn-outline-dark px-3 py-2 rounded-3 d-flex align-items-center gap-2">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- PRINT-ONLY HEADER BANNER -->
        <div class="print-only-header mb-4">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3">
                <div>
                    <h2 class="mb-1 text-dark fw-bold" style="font-family: 'Cinzel', serif;">EGYXPLORE SPONSOR PORTAL</h2>
                    <h4 class="text-gold mb-0">Performance & Analytics Report — @Model.CurrentSponsorName (@Model.Year)</h4>
                </div>
                <div class="text-end small text-muted">
                    <div>Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                    <div>Account: @Model.CurrentSponsorName</div>
                </div>
            </div>
        </div>

        <!-- SUMMARY KPI METRIC TILES -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card report-kpi-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon-box bg-gold-subtle text-gold rounded-3">
                            <i class="bi bi-receipt-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="kpi-label text-muted small fw-semibold uppercase-track">Total Claims</div>
                            <div class="kpi-value fs-3 fw-bold text-dark">@totalRedemptions.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card report-kpi-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon-box bg-primary-subtle text-primary rounded-3">
                            <i class="bi bi-coin fs-4"></i>
                        </div>
                        <div>
                            <div class="kpi-label text-muted small fw-semibold uppercase-track">Points Redeemed</div>
                            <div class="kpi-value fs-3 fw-bold text-dark">@totalPoints.ToString("N0") <span class="fs-6 text-muted font-normal">pts</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card report-kpi-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon-box bg-info-subtle text-info rounded-3">
                            <i class="bi bi-eye-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="kpi-label text-muted small fw-semibold uppercase-track">Offer Views</div>
                            <div class="kpi-value fs-3 fw-bold text-dark">@totalViews.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card report-kpi-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon-box bg-success-subtle text-success rounded-3">
                            <i class="bi bi-trophy-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="kpi-label text-muted small fw-semibold uppercase-track">Peak Month</div>
                            <div class="kpi-value fs-4 fw-bold text-dark">@peakMonth</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN CHART SECTION -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden print-keep-together">
            <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-gold"></i>
                    <span>Monthly Redemptions & Activity Trend (@Model.Year)</span>
                </h5>
                <span class="badge bg-light text-dark border">Chart Breakdown</span>
            </div>
            <div class="card-body px-4 pb-4">
                <div style="height: 340px; position: relative;">
                    <canvas id="reportsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- DATA TABLES GRID -->
        <div class="row g-4 mb-4">
            <!-- MONTHLY BREAKDOWN TABLE -->
            <div class="col-lg-7 print-keep-together">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-calendar3 text-gold"></i>
                            <span>Monthly Performance Breakdown</span>
                        </h5>
                        <span class="badge bg-light text-muted border">12 Months</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle custom-report-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Month</th>
                                        <th>Claims</th>
                                        <th>Points Redeemed</th>
                                        <th class="pe-4">Views</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.ReportRows)
                                    {
                                        var pct = (row.Redemptions / (double)maxRedemptions) * 100;
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">
                                                <i class="bi bi-calendar-event text-muted me-2 small"></i>@row.MonthLabel
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-dark" style="min-width: 28px;">@row.Redemptions</span>
                                                    <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                                                        <div class="progress-bar bg-gold" role="progressbar" style="width: @pct.ToString("F0")%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">@row.PointsRedeemed.ToString("N0") pts</span>
                                            </td>
                                            <td class="pe-4 text-muted font-monospace">@row.Views.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TOP REWARDS TABLE -->
            <div class="col-lg-5 print-keep-together">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-award-fill text-gold"></i>
                            <span>Top Performing Rewards</span>
                        </h5>
                        <span class="badge bg-gold-subtle text-gold fw-bold">Rankings</span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.TopRewards.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle custom-report-table mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">#</th>
                                            <th>Reward Title</th>
                                            <th>Claims</th>
                                            <th class="pe-4">Views</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int rank = 1; }
                                        @foreach (var reward in Model.TopRewards)
                                        {
                                            var rankBadge = rank switch
                                            {
                                                1 => "bg-warning text-dark border border-warning",
                                                2 => "bg-secondary-subtle text-dark border",
                                                3 => "bg-danger-subtle text-danger border border-danger-subtle",
                                                _ => "bg-light text-muted border"
                                            };
                                            <tr>
                                                <td class="ps-4">
                                                    <span class="badge rounded-circle p-2 @rankBadge" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                                        @rank
                                                    </span>
                                                </td>
                                                <td class="fw-bold text-dark text-truncate" style="max-width: 180px;">@reward.RewardTitle</td>
                                                <td><span class="fw-bold text-success">@reward.Redemptions</span></td>
                                                <td class="pe-4 text-muted font-monospace">@reward.Views</td>
                                            </tr>
                                            rank++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4">
                                @await Html.PartialAsync("_EmptyState", null, new ViewDataDictionary(ViewData)
                                {
                                    { "EmptyStateTitle", "No Reward Activity" },
                                    { "EmptyStateDescription", "No redemptions or views recorded for your rewards yet." },
                                    { "EmptyStateCompact", true }
                                })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var ctx = document.getElementById('reportsChart');
            if (!ctx) return;
            var labels = [@Html.Raw(string.Join(",", Model.ReportRows.Select(r => $"\"{r.MonthLabel}\"")))];
            var redemptionsData = [@Html.Raw(string.Join(",", Model.ReportRows.Select(r => r.Redemptions)))];
            var viewsData = [@Html.Raw(string.Join(",", Model.ReportRows.Select(r => r.Views)))];

            var chartGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 300);
            chartGradient.addColorStop(0, 'rgba(200, 131, 42, 0.85)');
            chartGradient.addColorStop(1, 'rgba(200, 131, 42, 0.15)');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Redemptions (Claims)',
                            data: redemptionsData,
                            backgroundColor: chartGradient,
                            borderColor: '#c8832a',
                            borderWidth: 1.5,
                            borderRadius: 6,
                            borderSkipped: false,
                            order: 2
                        },
                        {
                            label: 'Offer Views',
                            data: viewsData,
                            type: 'line',
                            borderColor: '#2c1a0e',
                            backgroundColor: 'rgba(44, 26, 14, 0.05)',
                            borderWidth: 2,
                            pointBackgroundColor: '#2c1a0e',
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            tension: 0.35,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            align: 'end',
                            labels: {
                                usePointStyle: true,
                                font: { family: 'Inter', size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(24, 20, 16, 0.9)',
                            titleFont: { size: 13, weight: 'bold' },
                            padding: 12,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)' },
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        })();
    </script>

    <style>
        .max-width-1300 {
            max-width: 1300px;
            margin: 0 auto;
        }

        .bg-gold-subtle {
            background-color: rgba(200, 131, 42, 0.12) !important;
        }

        .text-gold {
            color: #c8832a !important;
        }

        .btn-gold {
            background: linear-gradient(135deg, #c8832a 0%, #a4671e 100%);
            border: none;
            transition: all 0.25s ease;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #b57322 0%, #8e5716 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(200, 131, 42, 0.35) !important;
        }

        .uppercase-track {
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 0.72rem;
        }

        .report-title {
            font-family: 'Cinzel', serif;
            font-weight: 700;
            color: #2c1a0e;
        }

        .report-kpi-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-left: 4px solid transparent !important;
        }

        .report-kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
        }

        .kpi-icon-box {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-report-table th {
            background-color: #fcfbfa;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #6c757d;
            border-bottom: 2px solid #f0e9df;
            padding-top: 12px;
            padding-bottom: 12px;
        }

        .custom-report-table td {
            padding-top: 14px;
            padding-bottom: 14px;
            font-size: 0.9rem;
            border-bottom: 1px solid #f6f2ec;
        }

        .bg-gold {
            background-color: #c8832a !important;
        }

        .print-only-header {
            display: none;
        }

        /* PRINT & PDF STYLES */
        @@media print {
            .no-print, nav, footer, header, .navbar, .btn-gold, .btn-outline-dark, #header, #footer {
                display: none !important;
            }

            body {
                background: #ffffff !important;
                color: #000000 !important;
                font-size: 11pt;
            }

            .reports-page-wrapper {
                padding: 0 !important;
            }

            .container-fluid {
                max-width: 100% !important;
                padding: 0 !important;
            }

            .print-only-header {
                display: block !important;
            }

            .report-header {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
                padding: 16px !important;
            }

            .card {
                box-shadow: none !important;
                border: 1px solid #e0e0e0 !important;
                break-inside: avoid;
            }

            .print-keep-together {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .custom-report-table th, .custom-report-table td {
                padding: 8px 12px !important;
            }

            @@page {
                size: A4 portrait;
                margin: 1.5cm;
            }
        }
    </style>
}