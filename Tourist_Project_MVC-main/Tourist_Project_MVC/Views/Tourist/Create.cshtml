@model Tourist_Project_MVC.View_Model.CreateTouristViewModel

@{
    ViewData["Title"] = Localizer["TouristAdmin_AddTourist"].Value;
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="container mt-5 mb-5" style="max-width: 800px;">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden form-card">
            <!-- Card Header -->
            <div class="card-header py-4 text-center header-gradient">
                <h3 class="text-white mb-0 font-cinzel">
                    <i class="bi bi-person-plus-fill me-2"></i> @Localizer["TouristAdmin_AddNewTourist"].Value
                </h3>
                <p class="text-white-50 small mb-0 mt-1">Register a new tourist identity & profile account</p>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4 shadow-sm" role="alert"></div>

                    <!-- SECTION 1: User Account Details -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark-egy border-bottom pb-2 mb-3 font-cinzel">
                            <i class="bi bi-person-badge-fill me-2 text-gold"></i> User Account Details
                        </h5>
                        <div class="row g-3">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-person"></i></span>
                                    <input asp-for="FirstName" class="form-control-custom" placeholder="e.g. John" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-person"></i></span>
                                    <input asp-for="LastName" class="form-control-custom" placeholder="e.g. Doe" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control-custom" placeholder="john.doe@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control-custom" placeholder="+1234567890" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="Password (min 12 chars)" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="Confirm password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Nationality -->
                            <div class="col-md-6">
                                <label asp-for="Nationality" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-globe"></i></span>
                                    <input asp-for="Nationality" class="form-control-custom" placeholder="e.g. Egyptian, American..." />
                                </div>
                                <span asp-validation-for="Nationality" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Profile Picture -->
                            <div class="col-md-6">
                                <label asp-for="ProfilePicture" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-image"></i></span>
                                    <input asp-for="ProfilePicture" type="file" class="form-control-custom" accept="image/*" />
                                </div>
                                <span asp-validation-for="ProfilePicture" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Tourist Specific Details -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark-egy border-bottom pb-2 mb-3 font-cinzel">
                            <i class="bi bi-passport me-2 text-gold"></i> Tourist Profile Details
                        </h5>
                        <div class="row g-3">
                            <!-- ID Number -->
                            <div class="col-md-6">
                                <label asp-for="IdNumber" class="form-label fw-bold text-dark-egy">@Localizer["TouristAdmin_IdNumber"].Value</label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-card-list"></i></span>
                                    <input asp-for="IdNumber" class="form-control-custom" placeholder="National identity number" />
                                </div>
                                <span asp-validation-for="IdNumber" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Passport -->
                            <div class="col-md-6">
                                <label asp-for="Passport" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-file-earmark-person"></i></span>
                                    <input asp-for="Passport" class="form-control-custom" placeholder="Passport number" />
                                </div>
                                <span asp-validation-for="Passport" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Preferred Language -->
                            <div class="col-md-6">
                                <label asp-for="PreferredLanguage" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-translate"></i></span>
                                    <input asp-for="PreferredLanguage" class="form-control-custom" placeholder="e.g. English, Arabic" />
                                </div>
                                <span asp-validation-for="PreferredLanguage" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Travel Interests -->
                            <div class="col-md-6">
                                <label asp-for="TravelInterests" class="form-label fw-bold text-dark-egy"></label>
                                <div class="input-group-custom">
                                    <span class="input-icon"><i class="bi bi-compass"></i></span>
                                    <input asp-for="TravelInterests" class="form-control-custom" placeholder="e.g. History, Beaches, Food" />
                                </div>
                                <span asp-validation-for="TravelInterests" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-end mt-5 pt-3 border-top border-light">
                        <a asp-action="Index" class="btn btn-cancel-custom px-4 py-2.5 order-2 order-sm-1">
                            <i class="bi bi-x-lg me-1"></i> @Localizer["TouristAdmin_Cancel"].Value
                        </a>
                        <button type="submit" class="btn btn-save-custom px-5 py-2.5 order-1 order-sm-2 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> @Localizer["TouristAdmin_Save"].Value
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .form-card {
            border: 1px solid rgba(200, 131, 42, 0.15) !important;
            box-shadow: 0 15px 35px rgba(30, 18, 10, 0.08) !important;
        }

        .header-gradient {
            background: linear-gradient(135deg, var(--egy-dark) 0%, #3a2212 50%, var(--egy-primary) 100%);
            border-bottom: 3px solid var(--egy-accent);
        }

        .text-dark-egy {
            color: var(--egy-dark);
            font-size: 0.95rem;
            letter-spacing: 0.5px;
        }

        .font-cinzel {
            font-family: 'Cinzel', serif;
            letter-spacing: 1px;
        }

        .text-gold {
            color: var(--egy-primary);
        }

        /* Custom Input Styling */
        .input-group-custom {
            display: flex;
            align-items: stretch;
            background-color: var(--bg-surface);
            border: 1px solid rgba(200, 131, 42, 0.3);
            border-radius: var(--radius-md);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .input-group-custom:focus-within {
            border-color: var(--egy-primary);
            box-shadow: 0 0 0 3.5px rgba(200, 131, 42, 0.15);
        }

        .input-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1rem;
            background-color: rgba(200, 131, 42, 0.05);
            color: var(--egy-muted-gold);
            border-right: 1px solid rgba(200, 131, 42, 0.15);
            font-size: 1.1rem;
        }

        .form-control-custom {
            flex: 1 1 auto;
            width: 1%;
            min-width: 0;
            border: none;
            padding: 0.75rem 1rem;
            color: var(--text-primary);
            outline: none;
            background-color: transparent;
            font-size: 0.95rem;
        }

        .form-control-custom:focus {
            outline: none;
        }

        /* Buttons Styling */
        .btn-save-custom {
            background-color: var(--egy-success);
            color: #ffffff;
            border: none;
            border-radius: var(--radius-md);
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-save-custom:hover {
            background-color: var(--egy-success-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(46, 125, 50, 0.2);
            color: #ffffff;
        }

        .btn-cancel-custom {
            background-color: var(--bg-body);
            color: #495057;
            border: 1px solid #dee2e6;
            border-radius: var(--radius-md);
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-cancel-custom:hover {
            background-color: #e9ecef;
            color: #212529;
            transform: translateY(-2px);
        }
    </style>
}