@model IEnumerable<Tourist_Project_MVC.Models.Utility>

@{
    ViewData["Title"] = Localizer["Utility_IndexTitle"].Value;
}

<div class="container-fluid mt-4 px-md-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <h2 class="page-title mb-0">🚨 @Localizer["Utility_IndexHeading"].Value</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success px-4">
                <i class="bi bi-plus-lg me-1"></i> @Localizer["Utility_CreateBtn"].Value
            </a>
        }
    </div>

    @await Html.PartialAsync("_StatBoxRow", (List<Tourist_Project_MVC.View_Model.StatBoxItem>)ViewBag.StatBoxes)

    <!-- Filter Bar -->
    <div class="filter-bar mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <form method="get" asp-action="Index" id="filterForm">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 d-flex align-items-center gap-2">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search"
                               class="form-control border-start-0"
                               placeholder="@Localizer["Utility_SearchPlaceholder"].Value"
                               value="@ViewBag.Search" />
                        <input type="hidden" name="type" value="@ViewBag.Type" />
                    </div>
                </form>
            </div>

            <div class="col-md-4">
                <select class="form-select" onchange="window.location.href=this.value">
                    <option value="@Url.Action("Index", new { search = ViewBag.Search })">
                        @Localizer["Utility_AllTypes"].Value
                    </option>
                    @foreach (var t in ViewBag.Types as List<string> ?? new List<string>())
                    {
                        var url = Url.Action("Index", new { search = ViewBag.Search, type = t });
                        if (ViewBag.Type == t)
                        {
                            <option value="@url" selected>@t</option>
                        }
                        else
                        {
                            <option value="@url">@t</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 text-muted small">
                @Localizer["Utility_TotalLabel"].Value: <strong>@ViewBag.AllCount</strong>
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle destinations-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Localizer["Utility_ColName"].Value</th>
                        <th>@Localizer["Utility_ColType"].Value</th>
                        <th>@Localizer["Utility_ColCity"].Value</th>
                        <th>@Localizer["Utility_ColAddress"].Value</th>
                        <th>@Localizer["Utility_ColContact"].Value</th>
                        <th>@Localizer["Utility_ColHours"].Value</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th>@Localizer["Utility_ColActions"].Value</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@i.ToString("D2")</td>
                            <td><div class="fw-bold">@item.Name</div></td>
                            <td><span class="badge-category">@item.Type</span></td>
                            <td>@(item.City ?? "—")</td>
                            <td>@(item.Address ?? "—")</td>
                            <td>@(item.ContactNumber ?? "—")</td>
                            <td>@(item.OpenHours ?? "—")</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning" title="@Localizer["Utility_EditTip"].Value">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger" title="@Localizer["Utility_DeleteTip"].Value">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", null, new ViewDataDictionary(ViewData)
        {
            { "EmptyStateTitle", "No Utilities Found" },
            { "EmptyStateDescription", "There are no utilities matching your filter. Try adjusting your search." },
            { "EmptyStateActionUrl", Url.Action("Index") },
            { "EmptyStateActionText", "Clear Filters" }
        })
    }
</div>

@section Styles {
    <style>
        .filter-bar {
            background: var(--bg-surface);
            padding: 16px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .destinations-table {
            background: var(--bg-surface);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .badge-category {
            background-color: #FDF6EC;
            color: var(--egy-primary);
            border: 1px solid var(--egy-accent);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            white-space: nowrap;
        }
    </style>
}

@section Scripts {
    <script>
        document.querySelector('input[name="search"]').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') document.getElementById('filterForm').submit();
        });
    </script>
}
