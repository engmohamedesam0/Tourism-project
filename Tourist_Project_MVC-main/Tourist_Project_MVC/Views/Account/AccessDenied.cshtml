@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = @Localizer["AccessDenied_Title"].Value;
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-shield-lock-fill" style="font-size: 4.5rem; color: var(--egy-primary);"></i>
    </div>
    <h1 class="mb-3" style="color: var(--text-heading); font-family: 'Cinzel', serif; letter-spacing: 1px;">
        @Localizer["AccessDenied_Title"].Value
    </h1>
    <p class="lead text-muted mb-4">
        @Localizer["AccessDenied_Message"].Value
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-house-fill me-2"></i> @Localizer["AccessDenied_BackToHome"].Value
    </a>
</div>
