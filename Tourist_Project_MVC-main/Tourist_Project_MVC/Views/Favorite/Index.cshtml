@model Tourist_Project_MVC.View_Model.FavoritesIndexVM

@{
    ViewData["Title"] = "My Favorites";
}

<div class="favorites-page inner-page-wrapper">
    <div class="container py-4">
        <h1 class="page-title">@Localizer["Favorites_Title"].Value</h1>
        <p class="text-muted mb-4">@Localizer["Favorites_Subtitle"].Value</p>

        @if (!Model.Destinations.Any() && !Model.Rewards.Any() && !Model.Branches.Any())
        {
            @await Html.PartialAsync("_EmptyState", null, new ViewDataDictionary(ViewData)
            {
                { "EmptyStateTitle", "No Favorites Yet" },
                { "EmptyStateDescription", "You haven't saved any destinations, rewards or branches yet. Tap the heart icon anywhere on the site to build your personal collection." },
                { "EmptyStateActionUrl", Url.Action("Index", "Explore") },
                { "EmptyStateActionText", "Explore Destinations" }
            })
        }
        else
        {
            @if (Model.Destinations.Any())
            {
                <section class="mb-5">
                    <h2 class="section-title">
                        <i class="bi bi-geo-alt-fill me-2" style="color: var(--egy-primary);"></i>
                        @Localizer["Favorites_Destinations"].Value
                    </h2>
                    <div class="row g-3">
                        @foreach (var dest in Model.Destinations)
                        {
                            <div class="col-md-6 col-xl-4 favorite-item" data-item-type="Destination" data-item-id="@dest.Id">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0 fw-bold" style="font-family:'Cinzel',serif;">@dest.Name</h6>
                                            @if (User.IsInRole("User"))
                                            {
                                                await Html.PartialAsync("_FavoriteButton", new FavoriteButtonVM
                                                {
                                                    ItemType = FavoriteItemType.Destination,
                                                    ItemId = dest.Id,
                                                    IsFavorited = true
                                                });
                                            }
                                        </div>
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-geo-alt-fill me-1"></i> @dest.City
                                        </p>
                                        @if (dest.Rating.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-star-fill me-1"></i> @dest.Rating.Value.ToString("0.0")
                                            </span>
                                        }
                                        <p class="card-text small mt-2 text-secondary-dark">
                                            @(dest.Description?.Length > 120 ? dest.Description.Substring(0, 120) + "…" : dest.Description)
                                        </p>
                                        <a asp-controller="Destination" asp-action="Details" asp-route-id="@dest.Id" class="btn btn-sm btn-explore-action mt-2">
                                            <i class="bi bi-eye-fill me-1"></i> @Localizer["Explore_Details"].Value
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (Model.Rewards.Any())
            {
                <section class="mb-5">
                    <h2 class="section-title">
                        <i class="bi bi-gift-fill me-2" style="color: var(--egy-primary);"></i>
                        @Localizer["Favorites_Rewards"].Value
                    </h2>
                    <div class="row g-3">
                        @foreach (var reward in Model.Rewards)
                        {
                            <div class="col-md-6 col-xl-4 favorite-item" data-item-type="Reward" data-item-id="@reward.Id">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0 fw-bold text-truncate" title="@reward.Title">@reward.Title</h6>
                                            @if (User.IsInRole("User"))
                                            {
                                                await Html.PartialAsync("_FavoriteButton", new FavoriteButtonVM
                                                {
                                                    ItemType = FavoriteItemType.Reward,
                                                    ItemId = reward.Id,
                                                    IsFavorited = true
                                                });
                                            }
                                        </div>
                                        <p class="card-text small text-muted mb-2">@reward.Description</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-gold-dark">
                                                <i class="bi bi-coin me-1"></i> @reward.PointsRequired.ToString("N0") pts
                                            </span>
                                            <a asp-controller="TouristReward" asp-action="Index" class="btn btn-sm btn-egy-primary">
                                                @Localizer["Reward_Redeem"].Value
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (Model.Branches.Any())
            {
                <section class="mb-5">
                    <h2 class="section-title">
                        <i class="bi bi-geo-fill me-2" style="color: var(--egy-primary);"></i>
                        @Localizer["Favorites_Branches"].Value
                    </h2>
                    <div class="row g-3">
                        @foreach (var branch in Model.Branches)
                        {
                            <div class="col-md-6 col-xl-4 favorite-item" data-item-type="Branch" data-item-id="@branch.Id">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0 fw-bold" style="font-family:'Cinzel',serif;">@branch.Name</h6>
                                            @if (User.IsInRole("User"))
                                            {
                                                await Html.PartialAsync("_FavoriteButton", new FavoriteButtonVM
                                                {
                                                    ItemType = FavoriteItemType.Branch,
                                                    ItemId = branch.Id,
                                                    IsFavorited = true
                                                });
                                            }
                                        </div>
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-geo-alt-fill me-1"></i> @branch.Address
                                        </p>
                                        <p class="card-text small text-muted">@branch.Sponsor?.Name</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </div>
</div>