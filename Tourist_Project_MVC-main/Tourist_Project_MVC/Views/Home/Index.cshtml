@{
    ViewData["Title"] = "Home";
    ViewData["IsHomePage"] = true;
}

<!-- =============================================
     PREMIUM HERO SECTION
     ============================================= -->
<section class="premium-hero" id="home">
    <div class="hero-bg-overlay"></div>
    <div class="hero-particles" id="particles"></div>
    <div class="hero-content">
        <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>@Localizer["Hero_Badge_Live"].Value</span>
        </div>
        <h1 class="hero-title">
            <span class="hero-title-line">EGY</span><span class="hero-title-accent">XPLORE</span>
        </h1>
        <p class="hero-subtitle">@Localizer["Hero_Subtitle"].Value</p>
        <div class="hero-cta-group">
            <a class="btn-hero-primary" asp-controller="Explore" asp-action="Index">
                <i class="bi bi-compass-fill"></i>
                <span>@Localizer["Hero_ExploreBtn"].Value</span>
                <div class="btn-hero-glow"></div>
            </a>
            <a class="btn-hero-ghost" asp-controller="Trip" asp-action="Index">
                <i class="bi bi-map"></i>
                <span>@Localizer["Feature2_Link"].Value</span>
            </a>
        </div>
        <div class="hero-scroll-indicator">
            <span>@Localizer["Hero_Scroll"].Value</span>
            <div class="scroll-line"></div>
        </div>
    </div>
    <div class="hero-overlay-cards">
        <div class="floating-card fc-1">
            <i class="bi bi-geo-alt-fill"></i>
            <div>
                <div class="fc-num" data-target="@ViewBag.DestinationCount">0</div>
                <div class="fc-lbl">@Localizer["Stat_ArchaeologicalSites"].Value</div>
            </div>
        </div>
        <div class="floating-card fc-2">
            <i class="bi bi-star-fill"></i>
            <div>
                <div class="fc-num" data-target="@ViewBag.MissionCount">0</div>
                <div class="fc-lbl">@Localizer["Stat_ActiveMissions"].Value</div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     STATS BAND
     ============================================= -->
<section class="stats-band" id="stats">
    <div class="stats-band-inner">
        <div class="stat-pill" data-delay="0">
            <div class="stat-pill-icon icon-blue">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="stat-pill-body">
                <div class="stat-pill-num"><span class="counter" data-target="@ViewBag.DestinationCount">0</span></div>
                <div class="stat-pill-lbl">@Localizer["Stat_ArchaeologicalSites"].Value</div>
            </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-pill" data-delay="100">
            <div class="stat-pill-icon icon-gold">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-pill-body">
                <div class="stat-pill-num"><span class="counter" data-target="@ViewBag.TouristCount">0</span><span class="stat-plus">+</span></div>
                <div class="stat-pill-lbl">@Localizer["Stat_RegisteredTourists"].Value</div>
            </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-pill" data-delay="200">
            <div class="stat-pill-icon icon-green">
                <i class="bi bi-signpost-split-fill"></i>
            </div>
            <div class="stat-pill-body">
                <div class="stat-pill-num"><span class="counter" data-target="@ViewBag.TripPlanCount">0</span><span class="stat-plus">+</span></div>
                <div class="stat-pill-lbl">@Localizer["Stat_TripPlansCreated"].Value</div>
            </div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-pill" data-delay="300">
            <div class="stat-pill-icon icon-purple">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div class="stat-pill-body">
                <div class="stat-pill-num"><span class="counter" data-target="@ViewBag.MissionCount">0</span></div>
                <div class="stat-pill-lbl">@Localizer["Stat_ActiveMissions"].Value</div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     ABOUT / BRAND IDENTITY SECTION
     ============================================= -->
<section class="brand-section" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row align-items-center gx-5">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="brand-text-block">
                    <div class="section-eyebrow">
                        <span class="eyebrow-line"></span>
                        <span>@Localizer["About_Eyebrow"].Value</span>
                    </div>
                    <h2 class="brand-heading">@Localizer["About_Title"].Value</h2>
                    <p class="brand-body">@Localizer["About_Text"].Value</p>
                    <a class="btn-primary-branded" asp-controller="Explore" asp-action="Index">
                        <i class="bi bi-compass-fill me-2"></i>@Localizer["Feature1_Link"].Value
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="brand-image-wrapper">
                    <div class="brand-image-glow"></div>
                    <img src="~/assets/img/ipad.png" alt="EGYXPLORE App" class="brand-image" />
                    <div class="brand-image-badge">
                        <i class="bi bi-patch-check-fill"></i>
                        <span>@Localizer["About_Badge"].Value</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     FEATURES BENTO GRID
     ============================================= -->
<section class="features-bento" id="features">
    <div class="container px-4 px-lg-5">
        <div class="section-header text-center mb-5">
            <div class="section-eyebrow justify-content-center">
                <span class="eyebrow-line"></span>
                <span>@Localizer["Features_Eyebrow"].Value</span>
                <span class="eyebrow-line"></span>
            </div>
            <h2 class="section-heading">@Localizer["Features_Title"].Value</h2>
            <p class="section-sub">@Localizer["Features_Subtitle"].Value</p>
        </div>

        <div class="bento-grid">
            <!-- Feature 1 â€” Large -->
            <div class="bento-card bento-large bento-img-card" style="--bento-img: url('/assets/img/egypt_feature1.jpg')">
                <div class="bento-img-overlay"></div>
                <div class="bento-content">
                    <div class="bento-tag">
                        <i class="bi bi-geo-alt-fill me-1"></i>@Localizer["Feature1_Tag"].Value
                    </div>
                    <h3 class="bento-title">@Localizer["Feature1_Title"].Value</h3>
                    <p class="bento-text">@Localizer["Feature1_Text"].Value</p>
                    <a asp-controller="Explore" asp-action="Index" class="bento-cta">
                        @Localizer["Feature1_Link"].Value <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 2 â€” Small top right -->
            <div class="bento-card bento-small bento-dark">
                <div class="bento-icon-wrap bento-icon-gold">
                    <i class="bi bi-stars"></i>
                </div>
                <h3 class="bento-title">@Localizer["Feature2_Title"].Value</h3>
                <p class="bento-text">@Localizer["Feature2_Text"].Value</p>
                <a asp-controller="Trip" asp-action="Index" class="bento-cta">
                    @Localizer["Feature2_Link"].Value <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <!-- Feature 3 â€” Small bottom right -->
            <div class="bento-card bento-small bento-img-card" style="--bento-img: url('/assets/img/egypt_feature2.jpg')">
                <div class="bento-img-overlay"></div>
                <div class="bento-content">
                    <div class="bento-tag">
                        <i class="bi bi-trophy-fill me-1"></i>@Localizer["Feature3_Tag"].Value
                    </div>
                    <h3 class="bento-title">@Localizer["Feature3_Title"].Value</h3>
                    <p class="bento-text">@Localizer["Feature3_Text"].Value</p>
                    <a asp-controller="Mission" asp-action="Index" class="bento-cta">
                        @Localizer["Feature3_Link"].Value <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 4 â€” Full width bottom -->
            <div class="bento-card bento-wide bento-gradient">
                <div class="bento-wide-icon">
                    <i class="bi bi-map-fill"></i>
                </div>
                <div class="bento-wide-body">
                    <h3 class="bento-title">@Localizer["Contact_GIS"].Value</h3>
                    <p class="bento-text">@Localizer["Contact_GIS_Text"].Value</p>
                </div>
                <div class="bento-wide-badge">
                    <i class="bi bi-lightning-charge-fill me-1"></i>@Localizer["Feature_Powered"].Value
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     HOW IT WORKS â€” TIMELINE
     ============================================= -->
<section class="howit-section" id="how-it-works">
    <div class="container px-4 px-lg-5">
        <div class="section-header text-center mb-5">
            <div class="section-eyebrow justify-content-center">
                <span class="eyebrow-line"></span>
                <span>@Localizer["HowIt_Eyebrow"].Value</span>
                <span class="eyebrow-line"></span>
            </div>
            <h2 class="section-heading text-white">@Localizer["HowIt_Title"].Value</h2>
        </div>
        <div class="timeline-grid">
            <div class="timeline-step" data-step="01">
                <div class="ts-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div class="ts-content">
                    <h4>@Localizer["Step1_Title"].Value</h4>
                    <p>@Localizer["Step1_Text"].Value</p>
                </div>
                <div class="ts-connector"></div>
            </div>
            <div class="timeline-step" data-step="02">
                <div class="ts-icon">
                    <i class="bi bi-compass-fill"></i>
                </div>
                <div class="ts-content">
                    <h4>@Localizer["Step2_Title"].Value</h4>
                    <p>@Localizer["Step2_Text"].Value</p>
                </div>
                <div class="ts-connector"></div>
            </div>
            <div class="timeline-step" data-step="03">
                <div class="ts-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <div class="ts-content">
                    <h4>@Localizer["Step3_Title"].Value</h4>
                    <p>@Localizer["Step3_Text"].Value</p>
                </div>
                <div class="ts-connector"></div>
            </div>
            <div class="timeline-step" data-step="04">
                <div class="ts-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <div class="ts-content">
                    <h4>@Localizer["Step4_Title"].Value</h4>
                    <p>@Localizer["Step4_Text"].Value</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     TECHNOLOGY PILLARS
     ============================================= -->
<section class="pillars-section" id="technology">
    <div class="container px-4 px-lg-5">
        <div class="section-header text-center mb-5">
            <div class="section-eyebrow justify-content-center">
                <span class="eyebrow-line"></span>
                <span>@Localizer["Pillars_Eyebrow"].Value</span>
                <span class="eyebrow-line"></span>
            </div>
            <h2 class="section-heading">@Localizer["Pillars_Title"].Value</h2>
        </div>
        <div class="row gx-4 gy-4">
            <div class="col-md-4">
                <div class="pillar-card pillar-blue">
                    <div class="pillar-icon">
                        <i class="bi bi-map-fill"></i>
                    </div>
                    <h4>@Localizer["Contact_GIS"].Value</h4>
                    <p>@Localizer["Contact_GIS_Text"].Value</p>
                    <div class="pillar-tag">ArcGIS</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pillar-card pillar-gold">
                    <div class="pillar-icon">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h4>@Localizer["Contact_AI"].Value</h4>
                    <p>@Localizer["Contact_AI_Text"].Value</p>
                    <div class="pillar-tag">Gemini AI</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pillar-card pillar-purple">
                    <div class="pillar-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <h4>@Localizer["Contact_Gamified"].Value</h4>
                    <p>@Localizer["Contact_Gamified_Text"].Value</p>
                    <div class="pillar-tag">Gamification</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =============================================
     FINAL CTA BANNER
     ============================================= -->
<section class="cta-banner">
    <div class="cta-banner-bg"></div>
    <div class="container position-relative">
        <div class="cta-inner text-center">
            <h2 class="cta-heading">@Localizer["CTA_Title"].Value</h2>
            <p class="cta-sub">@Localizer["CTA_Sub"].Value</p>
            <div class="hero-cta-group justify-content-center">
                <a class="btn-hero-primary" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>@Localizer["CTA_Btn"].Value</span>
                    <div class="btn-hero-glow"></div>
                </a>
                <a class="btn-hero-ghost" asp-controller="Explore" asp-action="Index">
                    <i class="bi bi-compass-fill"></i>
                    <span>@Localizer["Hero_ExploreBtn"].Value</span>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<style>
/* ================================================================
   PREMIUM HOME PAGE â€” COMPLETE STYLES
   ================================================================ */

/* ---- Hero ---- */
.premium-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: url('/assets/img/egypt_hero_bg.jpg') center/cover no-repeat;
}

.hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(10, 5, 0, 0.82) 0%,
        rgba(30, 18, 10, 0.65) 40%,
        rgba(10, 5, 0, 0.85) 100%
    );
    z-index: 1;
}

.hero-particles {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 0 20px;
    max-width: 860px;
    margin: 0 auto;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(200, 131, 42, 0.12);
    border: 1px solid rgba(200, 131, 42, 0.4);
    border-radius: 50px;
    padding: 6px 18px;
    font-family: 'Nunito', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--egy-accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 28px;
    backdrop-filter: blur(6px);
}

.badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse-dot 1.8s ease-in-out infinite;
}

@@keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.5); }
}

.hero-title {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 900;
    letter-spacing: 6px;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 0.35em;
    text-shadow: 0 4px 40px rgba(0,0,0,0.5);
}

.hero-title-accent {
    background: linear-gradient(135deg, #E8A045 0%, #C8832A 50%, #f5c77e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: rgba(255,255,255,0.72);
    max-width: 560px;
    margin: 0 auto 42px;
    line-height: 1.7;
    font-weight: 300;
    letter-spacing: 0.3px;
}

.hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-bottom: 60px;
}

.btn-hero-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #C8832A, #E8A045);
    color: #fff;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 16px 38px;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.btn-hero-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(200, 131, 42, 0.55);
    color: #fff;
    text-decoration: none;
}

.btn-hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.2) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.btn-hero-primary:hover .btn-hero-glow { opacity: 1; }

.btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid rgba(200, 131, 42, 0.6);
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(8px);
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 15px 34px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease;
}

.btn-hero-ghost:hover {
    background: rgba(200, 131, 42, 0.15);
    border-color: var(--egy-accent);
    color: var(--egy-accent);
    transform: translateY(-2px);
    text-decoration: none;
}

.hero-scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: 'Nunito', sans-serif;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 3px;
}

.scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, rgba(200, 131, 42, 0.7), transparent);
    animation: scroll-bounce 2s ease-in-out infinite;
}

@@keyframes scroll-bounce {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.6); opacity: 0.4; }
}

/* Floating cards on hero */
.hero-overlay-cards {
    position: absolute;
    z-index: 4;
    width: 100%;
    height: 100%;
    top: 0; left: 0;
    pointer-events: none;
}

.floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 16px 22px;
    color: white;
    animation: float-card 5s ease-in-out infinite;
}

.floating-card i {
    font-size: 1.6rem;
    color: var(--egy-accent);
}

.fc-num {
    font-family: 'Cinzel', serif;
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
}

.fc-lbl {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.6);
    font-weight: 600;
    letter-spacing: 0.5px;
}

.fc-1 {
    bottom: 25%;
    left: 4%;
    animation-delay: 0s;
}

.fc-2 {
    bottom: 35%;
    right: 4%;
    animation-delay: 2.5s;
}

@@keyframes float-card {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
}

@@media (max-width: 768px) {
    .hero-overlay-cards { display: none; }
}

/* ---- Stats Band ---- */
.stats-band {
    background: var(--egy-dark);
    border-top: 2px solid rgba(200,131,42,0.3);
    border-bottom: 2px solid rgba(200,131,42,0.3);
    padding: 0;
}

.stats-band-inner {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 1100px;
    margin: 0 auto;
}

.stat-pill {
    flex: 1 1 200px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 36px 32px;
    transition: background 0.3s ease;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease, background 0.3s ease;
}

.stat-pill.visible {
    opacity: 1;
    transform: translateY(0);
}

.stat-pill:hover {
    background: rgba(200,131,42,0.07);
}

.stat-divider {
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(200, 131, 42, 0.4) 50%, transparent);
    margin: 20px 0;
    align-self: stretch;
}

.stat-pill-icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
    background: rgba(232, 160, 69, 0.1);
    border: 1px solid rgba(200, 131, 42, 0.35);
    backdrop-filter: blur(6px);
    color: var(--egy-accent);
    transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
}

.stat-pill:hover .stat-pill-icon {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 8px 24px rgba(200, 131, 42, 0.35);
    background: rgba(232, 160, 69, 0.18);
}

.icon-blue   { border-color: rgba(59, 130, 246, 0.4); color: #7fb2ff; }
.icon-gold   { border-color: rgba(200, 131, 42, 0.45); color: var(--egy-accent); }
.icon-green  { border-color: rgba(34, 197, 94, 0.4); color: #6fe3a0; }
.icon-purple { border-color: rgba(168, 85, 247, 0.4); color: #c9a3fb; }

.stat-pill-num {
    font-family: 'Cinzel', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1;
}

.stat-plus {
    color: var(--egy-accent);
    font-size: 1.4rem;
}

.stat-pill-lbl {
    font-family: 'Nunito', sans-serif;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.5);
    font-weight: 600;
    letter-spacing: 0.4px;
    margin-top: 4px;
}

/* ---- Brand Section ---- */
.brand-section {
    padding: 120px 0;
    background: var(--egy-light);
    position: relative;
    overflow: hidden;
}

.brand-section::before {
    content: '';
    position: absolute;
