        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Sticky Quick Nav Active Item Sync on Scroll
                var navItems = Array.from(document.querySelectorAll('.quick-nav-item'));
                var sections = Array.from(document.querySelectorAll('.feature-card-section'));

                if ('IntersectionObserver' in window && navItems.length && sections.length) {
                    var observer = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                var id = entry.target.getAttribute('id');
                                navItems.forEach(function (item) {
                                    if (item.getAttribute('href') === '#' + id) {
                                        item.classList.add('active');
                                    } else {
                                        item.classList.remove('active');
                                    }
                                });
                            }
                        });
                    }, { threshold: 0.3 });

                    sections.forEach(function (sec) { observer.observe(sec); });
                }

                // Scroll to Video Demo button handler
                var demoBtn = document.getElementById('scrollDemoBtn');
                var videoCard = document.getElementById('heroVideoCard');
                if (demoBtn && videoCard) {
                    demoBtn.addEventListener('click', function () {
                        videoCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        videoCard.style.transition = 'box-shadow 0.4s ease, transform 0.4s ease';
                        videoCard.style.boxShadow = '0 0 50px rgba(232, 160, 69, 0.9)';
                        videoCard.style.transform = 'scale(1.03)';
                        setTimeout(function () {
                            videoCard.style.boxShadow = '';
                            videoCard.style.transform = '';
                        }, 1600);
                    });
                }
            });
        </script>
    }
