@{
    ViewData["Title"] = "Features";
    ViewData["FullWidth"] = true;
}

<!-- ============================================================
     HERO SECTION (INSPIRED BY ABOUT PAGE HERO)
     ============================================================ -->
<div class="features-hero">
    <div class="features-hero-bg"></div>
    <div class="features-hero-overlay"></div>

    <div class="container position-relative py-5 z-2">
        <div class="row align-items-center g-5">
            <!-- Left Text Content -->
            <div class="col-lg-6 text-center text-lg-start">
                <span class="features-badge mb-3 animate-fade-down">
                    <i class="bi bi-cpu-fill me-2"></i>EGYXPLORE INNOVATION
                </span>

                <h1 class="features-hero-title mb-4 animate-fade-up">
                    Discover Egypt <span class="text-gold-gradient">Smarter</span>
                </h1>

                <div class="features-hero-lead-wrapper p-4 mb-4 animate-fade-up delay-1">
                    <p class="features-hero-lead mb-0">
                        Experience the ancient wonders of Egypt through cutting-edge technology. From AI-powered
                        personalized itineraries to location-aware audio guides and photorealistic AR reconstructions.
                    </p>
                </div>

                <div
                    class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-3 animate-fade-up delay-2">
                    <a href="#features-grid" class="btn btn-egy-hero primary-hero-btn">
                        <i class="bi bi-compass-fill me-2"></i> Explore Features
                    </a>
                    <button type="button" id="scrollDemoBtn" class="btn btn-egy-hero secondary-hero-btn">
                        <i class="bi bi-play-circle-fill me-2"></i> Watch Demo
                    </button>
                </div>
            </div>

            <!-- Right Hero Video (Smartify Products Video) -->
            <div class="col-lg-6">
                <div class="hero-video-card shadow-lg animate-fade-up delay-1" id="heroVideoCard">
                    <div class="hero-video-wrapper">
                        <video class="hero-video-player" autoplay loop muted playsinline preload="auto">
                            <source src="@Url.Content("~/assets/img/Smartify-Products.mp4")" type="video/mp4" />
                            Your browser does not support HTML5 video.
                        </video>
                        <div class="hero-video-overlay"></div>
                    </div>
                    <div class="hero-video-badge">
                        <i class="bi bi-play-fill text-warning me-1"></i>
                        <span>Smartify Product Demo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STYLISH BOTTOM DIVIDER -->
    <div class="hero-shape-divider">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,0 C480,100 960,100 1440,0 L1440,120 L0,120 Z" fill="#F8FAFC"></path>
        </svg>
        <a href="#features-grid" class="divider-arrow-notch" aria-label="Scroll to features">
            <i class="bi bi-chevron-down"></i>
        </a>
    </div>
</div>

<!-- ============================================================
     STICKY QUICK CATEGORY BAR
     ============================================================ -->
<div class="sticky-nav-wrapper">
    <div class="container">
        <div class="quick-nav-bar shadow-sm">
            <a href="#feature-ai-planner" class="quick-nav-item active">
                <i class="bi bi-cpu"></i> <span>AI Trip Planner</span>
            </a>
            <a href="#feature-gis-maps" class="quick-nav-item">
                <i class="bi bi-map-fill"></i> <span>GIS Maps</span>
            </a>
            <a href="#feature-audio-guide" class="quick-nav-item">
                <i class="bi bi-headphones"></i> <span>Audio Guide</span>
            </a>
            <a href="#feature-ar-experience" class="quick-nav-item">
                <i class="bi bi-bounding-box-circles"></i> <span>AR Experience</span>
            </a>
            <a href="#feature-offline-nav" class="quick-nav-item">
                <i class="bi bi-wifi-off"></i> <span>Offline Mode</span>
            </a>
            <a href="#feature-recommendations" class="quick-nav-item">
                <i class="bi bi-stars"></i> <span>Recommendations</span>
            </a>
        </div>
    </div>
</div>

<!-- ============================================================
     MAIN FEATURES CONTENT CONTAINER
     ============================================================ -->
<div class="container py-5" id="features-grid">

    <!-- SECTION TITLE -->
    <div class="text-center mb-5 pb-3">
        <span class="section-tag mb-2"><i class="bi bi-stars me-2"></i>PLATFORM CAPABILITIES</span>
        <h2 class="about-section-title text-center mx-auto mb-3" style="max-width: 650px;">
            Engineered for the Modern Traveler
        </h2>
        <div class="title-accent-line mx-auto"></div>
    </div>

    <!-- FEATURE 1: AI TRIP PLANNER -->
    <section id="feature-ai-planner" class="feature-card-section mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/egypt_feature1.jpg")" alt="AI Trip Planner"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-robot text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">AI Powered</div>
                            <div class="stat-label">Tailored Itineraries</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <span class="section-tag mb-2">SMART ITINERARY GENERATOR</span>
                    <h3 class="about-section-title mb-3">AI Trip Planner</h3>
                    <p class="about-text-lead mb-4">
                        Our intelligent AI engine analyzes your travel preferences, budget, duration, and interests to
                        generate fully customized, day-by-day itineraries across Egypt in seconds.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Customized itineraries generated in under 30 seconds</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Smart budget & duration optimization algorithms</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Dynamic route adjustments based on live crowd data</span>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "TripPlan")"
                       class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-magic me-2"></i> Plan My Trip
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE 2: INTERACTIVE GIS MAPS (ALTERNATING LAYOUT) -->
    <section id="feature-gis-maps" class="feature-card-section mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6 order-lg-last">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/egypt_feature2.jpg")" alt="Interactive GIS Maps"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-geo-alt-fill text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">Live GIS</div>
                            <div class="stat-label">Spatial Navigation</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-map-fill"></i>
                    </div>
                    <span class="section-tag mb-2">PRECISION SPATIAL MAPPING</span>
                    <h3 class="about-section-title mb-3">Interactive GIS Maps</h3>
                    <p class="about-text-lead mb-4">
                        Explore high-definition interactive GIS maps featuring real-time layers for historical sites,
                        verified hotels, local dining, transport hubs, and nearby services.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Spatial points of interest with real-time layer filtering</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Multi-modal navigation including Metro & local transit</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Geofenced notifications for nearby hidden gems</span>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "NearMe")" class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-compass-fill me-2"></i> Explore Maps
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE 3: SMART AUDIO GUIDE -->
    <section id="feature-audio-guide" class="feature-card-section mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/demo-image-01.jpg")" alt="Smart Audio Guide"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-soundwave text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">15+ Languages</div>
                            <div class="stat-label">Location Narrations</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-headphones"></i>
                    </div>
                    <span class="section-tag mb-2">LOCATION-AWARE AUDIO</span>
                    <h3 class="about-section-title mb-3">Smart Audio Guide</h3>
                    <p class="about-text-lead mb-4">
                        Immerse yourself in history with hands-free audio narrations that trigger automatically as you
                        approach ancient monuments, temples, and museum exhibits.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Automatic location-triggered hands-free audio</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Support for 15+ global languages with native accents</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Narrated by certified Egyptologists & historians</span>
                        </div>
                    </div>

                    <button type="button" class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm"
                            onclick="alert('Audio Guide preview available in EGYXPLORE Mobile App!')">
                        <i class="bi bi-play-fill me-2"></i> Start Listening
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE 4: AR HISTORICAL EXPERIENCE (ALTERNATING LAYOUT) -->
    <section id="feature-ar-experience" class="feature-card-section mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6 order-lg-last">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/egypt_hero_bg.jpg")" alt="AR Historical Experience"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-box-seam text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">3D Overlay</div>
                            <div class="stat-label">Augmented Reality</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-bounding-box-circles"></i>
                    </div>
                    <span class="section-tag mb-2">IMMERSIVE RECONSTRUCTION</span>
                    <h3 class="about-section-title mb-3">AR Historical Experience</h3>
                    <p class="about-text-lead mb-4">
                        Step back in time to witness ancient Egyptian temples and monuments restored to their original
                        glory through high-precision augmented reality overlays.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Photorealistic 3D ancient structure reconstructions</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Time-slider overlay comparing ancient vs. present state</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Interactive 360° artifact & hieroglyph deciphering</span>
                        </div>
                    </div>

                    <button type="button" class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm"
                            onclick="alert('AR Mode requires camera permission on mobile!')">
                        <i class="bi bi-eye-fill me-2"></i> Experience AR
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE 5: OFFLINE NAVIGATION -->
    <section id="feature-offline-nav" class="feature-card-section mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/demo-image-02.jpg")" alt="Offline Navigation"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-cloud-arrow-down-fill text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">100% Offline</div>
                            <div class="stat-label">Zero Data Usage</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-wifi-off"></i>
                    </div>
                    <span class="section-tag mb-2">DATA-FREE EXPLORATION</span>
                    <h3 class="about-section-title mb-3">Offline Navigation</h3>
                    <p class="about-text-lead mb-4">
                        Download complete vector map packages, POI directories, and audio guides before your trip to
                        enjoy full navigation functionality without roaming data.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Full offline map package downloads per governorate</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Zero mobile internet data consumption while traveling</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>High-precision GPS tracking without cellular signal</span>
                        </div>
                    </div>

                    <a href="#" class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm"
                       onclick="alert('Offline maps ready for download in profile!')">
                        <i class="bi bi-download me-2"></i> Download Guides
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE 6: PERSONALIZED RECOMMENDATIONS (ALTERNATING LAYOUT) -->
    <section id="feature-recommendations" class="feature-card-section mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6 order-lg-last">
                <div class="feature-image-card shadow-lg">
                    <div class="feature-img-wrapper">
                        <img src="@Url.Content("~/assets/img/bg-masthead.jpg")" alt="Personalized Recommendations"
                             class="img-fluid feature-img" />
                        <div class="feature-img-overlay"></div>
                    </div>
                    <div class="feature-stat-badge">
                        <i class="bi bi-stars text-warning me-2 fs-5"></i>
                        <div>
                            <div class="stat-number">Smart Profile</div>
                            <div class="stat-label">Machine Learning</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="feature-content-card p-4 p-md-5">
                    <div class="feature-icon-badge mb-3">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="section-tag mb-2">TASTE-PROFILE MATCHING</span>
                    <h3 class="about-section-title mb-3">Personalized Recommendations</h3>
                    <p class="about-text-lead mb-4">
                        Discover hidden gems, authentic dining, and cultural events tailored specifically to your taste
                        profile as our recommendation engine learns from your journey.
                    </p>

                    <div class="feature-highlights-list mb-4">
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Smart taste profile machine learning engine</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Curated hidden gems, authentic dining & local artisan spots</span>
                        </div>
                        <div class="highlight-point">
                            <i class="bi bi-check-circle-fill text-warning me-2"></i>
                            <span>Tailored event, festival & bazaar notifications</span>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "Destination")"
                       class="btn btn-egy-gold rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-person-check-fill me-2"></i> View Recommendations
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- BOTTOM CTA BANNER (MATCHING ABOUT PAGE TEAM BANNER) -->
    <section class="mt-5 pt-3">
        <div class="features-banner-card p-4 p-md-5 text-center">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <span class="section-tag mb-2"><i class="bi bi-rocket-takeoff-fill me-2"></i>START YOUR
                        JOURNEY</span>
                        <h3 class="team-card-title mb-3">Ready to Experience Egypt Like Never Before?</h3>
                        <p class="team-card-text mb-4">
                            Join thousands of smart travelers using EGYXPLORE to design seamless, intelligent, and
                            unforgettable journeys across Egypt.
                        </p>
                        <a href="@Url.Action("Index", "TripPlan")"
                           class="btn btn-egy-hero primary-hero-btn px-5 py-3 shadow">
                            <i class="bi bi-compass-fill me-2"></i> Start Planning Now
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </div>

    @section Scripts {
        <style>
            /* ============================================================
               FEATURES PAGE PREMIUM STYLES (MATCHING ABOUT PAGE THEME)
               ============================================================ */

            /* HERO SECTION */
            .features-hero {
                position: relative;
                min-height: 85vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--egy-dark);
                margin-top: calc(-1 * var(--nav-offset));
                padding-top: calc(var(--nav-offset) + 60px);
                padding-bottom: 120px;
                overflow: hidden;
            }

            .features-hero-bg {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url('https://images.unsplash.com/photo-1503177119275-0aa32b3a9368?q=80&w=2000&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
                filter: brightness(0.55) contrast(1.1);
                transform: scale(1.05);
                transition: transform 10s ease;
            }

            .features-hero:hover .features-hero-bg {
                transform: scale(1);
            }

            .features-hero-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(180deg, rgba(30, 18, 10, 0.88) 0%, rgba(30, 18, 10, 0.65) 50%, rgba(30, 18, 10, 0.95) 100%);
            }

            .features-badge {
                display: inline-flex;
                align-items: center;
                padding: 6px 18px;
                border-radius: 999px;
                background: rgba(200, 131, 42, 0.25);
                border: 1px solid rgba(232, 160, 69, 0.4);
                color: var(--egy-accent);
                font-size: 0.85rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                backdrop-filter: blur(8px);
            }

            .features-hero-title {
                font-family: 'Cinzel Decorative', 'Cinzel', serif;
                font-size: clamp(2.2rem, 4.5vw, 3.6rem);
                font-weight: 900;
                color: #ffffff;
                letter-spacing: 2px;
                line-height: 1.2;
                text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            }

            .text-gold-gradient {
                background: linear-gradient(135deg, var(--egy-accent) 0%, #ffc06e 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .features-hero-lead-wrapper {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 20px;
                backdrop-filter: blur(12px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            }

            .features-hero-lead {
                font-family: 'Nunito', sans-serif;
                font-size: 1.1rem;
                color: rgba(255, 255, 255, 0.92);
                line-height: 1.7;
                font-weight: 400;
            }

            /* HERO VIDEO FRAME */
            .hero-video-card {
                position: relative;
                border-radius: 24px;
                overflow: hidden;
                border: 2px solid var(--egy-primary);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
                background: #000;
            }

            .hero-video-wrapper {
                position: relative;
                width: 100%;
                aspect-ratio: 16 / 10;
                overflow: hidden;
            }

            .hero-video-player {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .hero-video-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, transparent 60%, rgba(30, 18, 10, 0.7) 100%);
                pointer-events: none;
            }

            .hero-video-badge {
                position: absolute;
                bottom: 16px;
                left: 16px;
                background: rgba(30, 18, 10, 0.85);
                border: 1px solid var(--egy-primary);
                border-radius: 999px;
                padding: 8px 18px;
                backdrop-filter: blur(10px);
                color: #ffffff;
                font-size: 0.85rem;
                font-weight: 700;
                display: flex;
                align-items: center;
            }

            /* HERO BUTTONS */
            .btn-egy-hero {
                padding: 14px 32px;
                border-radius: 999px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-size: 0.9rem;
                transition: all 0.3s ease;
            }

            .primary-hero-btn {
                background: linear-gradient(135deg, var(--egy-primary) 0%, var(--egy-accent) 100%);
                color: var(--egy-dark) !important;
                border: none;
                box-shadow: 0 8px 25px rgba(200, 131, 42, 0.4);
            }

            .primary-hero-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 30px rgba(232, 160, 69, 0.6);
                background: linear-gradient(135deg, var(--egy-accent) 0%, #ffc06e 100%);
            }

            .secondary-hero-btn {
                background: rgba(255, 255, 255, 0.12);
                color: #ffffff !important;
