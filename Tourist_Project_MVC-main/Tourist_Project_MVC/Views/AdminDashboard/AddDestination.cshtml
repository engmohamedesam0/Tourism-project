@model Tourist_Project_MVC.View_Model.AddDestinationVM
@{
    ViewData["Title"] = "Add Destination";
    var categories = new[] { "Hidden Gems", "Temple", "Museum", "Natural", "Public", "Adventure", "Historical", "Archaeological", "Religious", "Cultural", "Beaches", "Parks", "Landmarks", "Other" };
    var days = new[] { "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <style>
        .destination-create-page { max-width:1320px; margin:0 auto; font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif; color:var(--dash-text-primary); }
        .destination-create-header { position:relative; display:flex; justify-content:space-between; gap:1.5rem; align-items:flex-end; padding:2rem 2.1rem; margin-bottom:1.15rem; border:1px solid color-mix(in srgb,var(--dash-primary) 24%,var(--dash-border)); border-radius:22px; overflow:hidden; background:radial-gradient(circle at 88% 10%,var(--dash-primary-light),transparent 34%),linear-gradient(135deg,color-mix(in srgb,var(--dash-primary) 8%,var(--dash-card-bg)),var(--dash-card-bg) 60%); box-shadow:var(--dash-shadow-md); }
        .destination-create-header::after { content:''; position:absolute; right:-50px; bottom:-75px; width:220px; height:220px; border:1px solid color-mix(in srgb,var(--dash-primary) 22%,transparent); border-radius:50%; box-shadow:0 0 0 18px color-mix(in srgb,var(--dash-primary) 5%,transparent),0 0 0 38px color-mix(in srgb,var(--dash-primary) 4%,transparent); pointer-events:none; }
        .destination-breadcrumb { display:flex; align-items:center; gap:.45rem; color:var(--dash-text-muted); font-size:.7rem; font-weight:700; margin-bottom:1rem; }
        .destination-breadcrumb i { color:var(--dash-primary); }
        .destination-create-header h1 { font-size:clamp(1.65rem,2.5vw,2.45rem); font-weight:800; letter-spacing:-.055em; margin:0; color:var(--dash-text-primary); }
        .destination-create-header p { color:var(--dash-text-secondary); margin:.6rem 0 0; max-width:620px; line-height:1.65; font-size:.85rem; }
        .destination-header-mark { display:inline-grid; place-items:center; width:42px; height:42px; margin-bottom:.7rem; border-radius:13px; color:#fff; background:linear-gradient(135deg,var(--dash-primary),#e8a045); box-shadow:0 8px 22px var(--dash-primary-glow); font-size:1.15rem; }
        .destination-header-actions { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-end; gap:.75rem; min-width:200px; }
        .destination-layer-badge { display:inline-flex; align-items:center; gap:.4rem; padding:.45rem .65rem; border-radius:99px; color:var(--dash-green); background:var(--dash-green-bg); font-size:.66rem; font-weight:800; white-space:nowrap; }
        .destination-layer-badge i { font-size:.52rem; }
        .destination-back-link { display:inline-flex; align-items:center; gap:.55rem; padding:.66rem .95rem; border:1px solid color-mix(in srgb,var(--dash-primary) 38%,var(--dash-border)); border-radius:999px; color:var(--dash-text-primary); background:color-mix(in srgb,var(--dash-primary) 5%,var(--dash-card-bg)); font-size:.72rem; font-weight:800; text-decoration:none; transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease,color .2s ease; }
        .destination-back-link i { color:var(--dash-primary); transition:transform .2s ease; }
        .destination-back-link:hover { color:var(--dash-primary); border-color:var(--dash-primary); box-shadow:0 8px 22px var(--dash-primary-glow); transform:translateY(-1px); }
        .destination-back-link:hover i { transform:translateX(-3px); }
        .destination-wizard { display:grid; grid-template-columns:230px minmax(0,1fr); gap:1.15rem; align-items:start; }
        .destination-stepper { position:sticky; top:1rem; padding:1rem .85rem; border:1px solid var(--dash-border); border-radius:18px; background:var(--dash-card-bg); box-shadow:var(--dash-shadow-sm); }
        .destination-stepper-title { margin:0 0 .8rem .35rem; color:var(--dash-text-muted); text-transform:uppercase; letter-spacing:.12em; font-size:.61rem; font-weight:900; }
        .destination-step { position:relative; display:flex; gap:.65rem; width:100%; padding:.72rem .45rem; border:0; border-radius:12px; color:var(--dash-text-muted); background:transparent; text-align:left; cursor:pointer; transition:background .2s ease,color .2s ease,transform .2s ease; }
        .destination-step:not(:last-child)::after { content:''; position:absolute; left:17px; top:39px; height:25px; border-left:1px solid var(--dash-border); }
        .destination-step-dot { position:relative; z-index:1; display:grid; place-items:center; flex:0 0 auto; width:26px; height:26px; border:1px solid var(--dash-border); border-radius:50%; color:var(--dash-text-muted); background:var(--dash-bg); font-size:.66rem; font-weight:900; }
        .destination-step-copy strong { display:block; font-size:.7rem; font-weight:900; }
        .destination-step-copy small { display:block; margin-top:2px; font-size:.6rem; line-height:1.35; color:var(--dash-text-muted); }
        .destination-step:hover { color:var(--dash-primary); background:var(--dash-primary-light); transform:translateX(2px); }
        .destination-step.active { color:var(--dash-primary); background:color-mix(in srgb,var(--dash-primary) 8%,var(--dash-card-bg)); }
        .destination-step.active .destination-step-dot { border-color:var(--dash-primary); color:#fff; background:var(--dash-primary); box-shadow:0 0 0 4px var(--dash-primary-light); }
        .destination-step.completed { color:var(--dash-green); }
        .destination-step.completed .destination-step-dot { border-color:var(--dash-green); color:#fff; background:var(--dash-green); }
        .destination-step.completed:not(:last-child)::after { border-color:color-mix(in srgb,var(--dash-green) 55%,var(--dash-border)); }
        .destination-pane { display:none; animation:destinationPaneIn .25s ease; }
        .destination-pane.active { display:block; }
        @@keyframes destinationPaneIn { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:translateY(0); } }
        .destination-create-card { background:var(--dash-card-bg); border:1px solid var(--dash-border); border-radius:18px; box-shadow:var(--dash-shadow-sm); overflow:hidden; }
        .destination-create-card-header { display:flex; align-items:center; gap:.75rem; padding:1rem 1.2rem; border-bottom:1px solid var(--dash-border); color:var(--dash-text-primary); }
        .destination-section-icon { display:grid; place-items:center; width:32px; height:32px; flex:0 0 auto; border-radius:10px; color:var(--dash-primary); background:var(--dash-primary-light); }
        .destination-create-card-header strong { display:block; font-size:.84rem; font-weight:800; }
        .destination-create-card-header small { display:block; color:var(--dash-text-muted); font-size:.67rem; margin-top:2px; font-weight:600; }
        .destination-create-card-body { padding:1.25rem; }
        .destination-create-page .validation-summary-valid { display:none; }
        .destination-create-page .validation-summary-errors { border:1px solid color-mix(in srgb,var(--dash-rose) 28%,var(--dash-border)); border-radius:12px; background:var(--dash-rose-bg); color:var(--dash-rose); padding:.85rem 1rem; font-size:.78rem; }
        .destination-create-page .form-label { display:flex; align-items:center; gap:.3rem; color:var(--dash-text-primary); font-weight:800; font-size:.72rem; margin-bottom:.42rem; }
        .destination-create-page .required-mark { color:var(--dash-primary); }
        .destination-create-page .field-hint { color:var(--dash-text-muted); font-size:.66rem; margin-top:.35rem; }
        .destination-create-page .form-control,.destination-create-page .form-select { min-height:45px; color:var(--dash-text-primary); background:var(--dash-card-bg); border:1px solid var(--dash-border); border-radius:10px; font-size:.78rem; transition:border-color .2s,box-shadow .2s; }
        .destination-create-page textarea.form-control { min-height:116px; resize:vertical; }
        .destination-create-page .form-control:focus,.destination-create-page .form-select:focus { color:var(--dash-text-primary); background:var(--dash-card-bg); border-color:var(--dash-primary); box-shadow:0 0 0 4px var(--dash-primary-light); }
        .destination-input { position:relative; }
        .destination-input > i { position:absolute; left:13px; top:14px; z-index:2; color:var(--dash-text-muted); font-size:.85rem; pointer-events:none; }
        .destination-input .form-control { padding-left:36px; }
        .destination-map-wrap { height:460px; position:relative; border-radius:15px; overflow:hidden; border:1px solid var(--dash-border); background:var(--dash-bg); }
        #destinationMap { height:100%; width:100%; }
        .destination-map-hint { position:absolute; z-index:4; bottom:13px; left:13px; display:inline-flex; align-items:center; gap:.4rem; padding:.62rem .75rem; border:1px solid rgba(200,131,42,.28); border-radius:10px; background:color-mix(in srgb,var(--dash-card-bg) 92%,transparent); color:var(--dash-text-primary); box-shadow:var(--dash-shadow-sm); font-size:.7rem; font-weight:800; pointer-events:none; }
        .destination-map-hint i { color:var(--dash-primary); }
        .location-status { display:flex; align-items:center; gap:.5rem; min-height:36px; margin-top:.8rem; padding:.6rem .75rem; border:1px dashed var(--dash-border); border-radius:10px; color:var(--dash-text-muted); background:var(--dash-bg); font-size:.7rem; font-weight:700; }
        .location-status.selected { border-style:solid; border-color:color-mix(in srgb,var(--dash-green) 32%,var(--dash-border)); color:var(--dash-green); background:var(--dash-green-bg); }
        .coordinate-card { display:flex; align-items:center; gap:.6rem; padding:.35rem .7rem; border:1px solid var(--dash-border); border-radius:10px; background:var(--dash-bg); }
        .coordinate-card i { color:var(--dash-primary); }
        .coordinate-card .form-control { min-height:34px; padding:.25rem .35rem; background:transparent; border:0; box-shadow:none; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.72rem; }
        .day-picker { display:flex; gap:.42rem; flex-wrap:wrap; }
        .day-picker label { cursor:pointer; }.day-picker input { position:absolute; opacity:0; pointer-events:none; }.day-picker span { display:inline-flex; align-items:center; justify-content:center; min-width:48px; padding:.62rem .65rem; border:1px solid var(--dash-border); border-radius:9px; color:var(--dash-text-secondary); background:var(--dash-card-bg); font-size:.68rem; font-weight:800; transition:.2s ease; }.day-picker span:hover { border-color:var(--dash-primary); color:var(--dash-primary); }.day-picker input:checked + span { border-color:var(--dash-primary); color:var(--dash-primary); background:var(--dash-primary-light); box-shadow:0 0 0 3px var(--dash-primary-light); }
        .public-schedule { display:none; align-items:center; gap:.65rem; padding:1rem; border:1px solid color-mix(in srgb,var(--dash-green) 35%,var(--dash-border)); border-radius:12px; color:var(--dash-green); background:var(--dash-green-bg); font-size:.78rem; font-weight:800; }.public-schedule i { font-size:1.1rem; }
        .ticket-toggle { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.8rem .9rem; border:1px solid var(--dash-border); border-radius:12px; background:var(--dash-bg); margin-bottom:1rem; }.ticket-toggle strong { display:block; color:var(--dash-text-primary); font-size:.76rem; }.ticket-toggle small { display:block; color:var(--dash-text-muted); margin-top:2px; font-size:.66rem; }.form-switch .form-check-input { width:2.4em; height:1.3em; cursor:pointer; }.form-switch .form-check-input:checked { background-color:var(--dash-primary); border-color:var(--dash-primary); }.ticket-price-fields.is-disabled { opacity:.45; pointer-events:none; }
        .image-dropzone { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:150px; padding:1.25rem; border:1px dashed color-mix(in srgb,var(--dash-primary) 42%,var(--dash-border)); border-radius:14px; background:linear-gradient(135deg,var(--dash-primary-light),transparent); text-align:center; transition:.2s ease; }.image-dropzone:hover,.image-dropzone.dragover { border-color:var(--dash-primary); background:var(--dash-primary-light); }.image-dropzone i { display:grid; place-items:center; width:42px; height:42px; margin-bottom:.55rem; border-radius:13px; color:var(--dash-primary); background:var(--dash-card-bg); box-shadow:var(--dash-shadow-sm); font-size:1.15rem; }.image-dropzone strong { color:var(--dash-text-primary); font-size:.78rem; }.image-dropzone span { color:var(--dash-text-muted); font-size:.67rem; margin-top:.3rem; }.image-dropzone input { position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:pointer; }
        .image-preview-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(125px,1fr)); gap:.7rem; margin-top:.8rem; }.image-preview-item { position:relative; aspect-ratio:1.25; overflow:hidden; border:1px solid var(--dash-border); border-radius:11px; background:var(--dash-bg); }.image-preview-item img { width:100%; height:100%; object-fit:cover; }.image-preview-item .image-name { position:absolute; left:5px; right:34px; bottom:5px; overflow:hidden; padding:.25rem .35rem; border-radius:5px; background:rgba(15,23,42,.72); color:#fff; font-size:.58rem; text-overflow:ellipsis; white-space:nowrap; }.image-remove { position:absolute; top:6px; right:6px; width:27px; height:27px; border:0; border-radius:50%; color:#fff; background:rgba(15,23,42,.75); }.image-remove:hover { background:var(--dash-rose); }.external-url-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.5rem; align-items:start; margin-bottom:.65rem; }.external-url-row .url-preview { display:none; grid-column:1/-1; align-items:center; gap:.6rem; padding:.4rem; border-radius:9px; background:var(--dash-bg); color:var(--dash-text-muted); font-size:.65rem; }.external-url-row .url-preview img { width:72px; height:52px; object-fit:cover; border-radius:6px; }.external-url-row.is-valid .url-preview { display:flex; }.external-url-row.is-invalid .url-preview { display:flex; color:var(--dash-rose); }.external-url-row.is-invalid .url-preview img { display:none; }
        .destination-create-actions { display:flex; justify-content:space-between; gap:.65rem; margin-top:1rem; padding:1rem; border:1px solid var(--dash-border); border-radius:15px; background:var(--dash-card-bg); box-shadow:var(--dash-shadow-sm); }.destination-create-actions .btn { min-height:44px; border-radius:10px; padding:.65rem 1rem; font-size:.76rem; font-weight:800; }.destination-create-actions .btn-primary { border:0; background:linear-gradient(135deg,var(--dash-primary),#e1a04e); box-shadow:0 8px 18px var(--dash-primary-glow); }
        @@media(max-width:900px) { .destination-wizard { grid-template-columns:1fr; }.destination-stepper { position:static; display:grid; grid-template-columns:repeat(3,1fr); gap:.3rem; }.destination-stepper-title { grid-column:1/-1; }.destination-step { padding:.6rem .35rem; }.destination-step:not(:last-child)::after { display:none; }.destination-step-copy small { display:none; } }
        @@media(max-width:700px) { .destination-create-header { flex-direction:column; align-items:flex-start; padding:1.35rem; }.destination-header-actions { align-items:flex-start; }.destination-stepper { grid-template-columns:repeat(2,1fr); }.destination-create-card-body { padding:1rem; }.destination-map-wrap { height:350px; }.destination-create-actions { flex-direction:column-reverse; }.destination-create-actions .btn { width:100%; }.external-url-row { grid-template-columns:1fr auto; } }
    </style>
}

<div class="destination-create-page">
    <div class="destination-create-header">
        <div><div class="destination-breadcrumb"><i class="bi bi-grid-1x2-fill"></i><span>Admin Dashboard</span><i class="bi bi-chevron-right"></i><span>Destinations</span><i class="bi bi-chevron-right"></i><span style="color:var(--dash-primary)">New destination</span></div><span class="destination-header-mark"><i class="bi bi-geo-alt-fill"></i></span><h1>Add a new destination</h1><p>Publish a verified destination to the EGYXPLORE ArcGIS layer. Add the essentials, pinpoint its location, and prepare the visitor experience.</p></div>
        <div class="destination-header-actions"><span class="destination-layer-badge"><i class="bi bi-circle-fill"></i> ArcGIS layer connected</span><a asp-action="Index" asp-route-section="destinations" class="destination-back-link"><i class="bi bi-arrow-left"></i> Back to Destinations</a></div>
    </div>

    <form asp-controller="AdminDashboard" asp-action="AddDestination" method="post" enctype="multipart/form-data" id="addDestinationForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div class="destination-wizard">
            <nav class="destination-stepper" aria-label="Destination creation steps">
                <p class="destination-stepper-title">Creation path</p>
                <button type="button" class="destination-step active" data-step="0"><span class="destination-step-dot">1</span><span class="destination-step-copy"><strong>Basic Information</strong><small>Name, category and access</small></span></button>
                <button type="button" class="destination-step" data-step="1"><span class="destination-step-dot">2</span><span class="destination-step-copy"><strong>Location</strong><small>Search and place the pin</small></span></button>
                <button type="button" class="destination-step" data-step="2"><span class="destination-step-dot">3</span><span class="destination-step-copy"><strong>Schedule &amp; Booking</strong><small>Visitor access details</small></span></button>
                <button type="button" class="destination-step" data-step="3"><span class="destination-step-dot">4</span><span class="destination-step-copy"><strong>Ticket Information</strong><small>Prices when applicable</small></span></button>
                <button type="button" class="destination-step" data-step="4"><span class="destination-step-dot">5</span><span class="destination-step-copy"><strong>Gallery</strong><small>Local and external images</small></span></button>
                <button type="button" class="destination-step" data-step="5"><span class="destination-step-dot">6</span><span class="destination-step-copy"><strong>Review &amp; Publish</strong><small>Check before creating</small></span></button>
            </nav>
            <main>
                <section class="destination-pane active" data-pane="0"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-stars"></i></span><div><strong>Destination identity</strong><small>Give visitors a clear, searchable place to discover</small></div></div><div class="destination-create-card-body"><div class="row g-4">
                    <div class="col-md-6"><label asp-for="Name" class="form-label">English name <span class="required-mark">*</span></label><div class="destination-input"><i class="bi bi-type"></i><input asp-for="Name" class="form-control" autocomplete="off" placeholder="e.g. The Citadel of Cairo" /></div><span asp-validation-for="Name" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ArabicName" class="form-label">Arabic name</label><div class="destination-input"><i class="bi bi-translate"></i><input asp-for="ArabicName" class="form-control" dir="rtl" placeholder="اكتب الاسم بالعربية" /></div></div>
                    <div class="col-md-6"><label asp-for="City" class="form-label">City / governorate <span class="required-mark">*</span></label><div class="destination-input"><i class="bi bi-buildings"></i><input asp-for="City" class="form-control" autocomplete="address-level2" placeholder="e.g. Cairo" /></div><span asp-validation-for="City" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Category" class="form-label">Category <span class="required-mark">*</span></label><select asp-for="Category" class="form-select" id="categorySelect"><option value="">Select a category</option>@foreach (var category in categories) { <option value="@category">@category</option> }</select><span asp-validation-for="Category" class="text-danger"></span><div class="field-hint">Use the existing canonical category names so Explore filters remain compatible.</div></div>
                    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe what makes this destination worth visiting..."></textarea></div>
                    <div class="col-md-6"><label asp-for="Tags" class="form-label">Discovery tags</label><div class="destination-input"><i class="bi bi-tags"></i><input asp-for="Tags" class="form-control" placeholder="museum, family, heritage" /></div></div>
                    <div class="col-md-6"><label asp-for="Booking" class="form-label">Booking link or instructions <span class="booking-optional-hint text-muted">(optional)</span></label><div class="destination-input"><i class="bi bi-link-45deg"></i><input asp-for="Booking" class="form-control" id="bookingInput" placeholder="https://... or booking instructions" /></div></div>
                </div></div></div></section>

                <section class="destination-pane" data-pane="1"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-crosshair2"></i></span><div><strong>Pinpoint the destination</strong><small>Search a real place, then click to refine the exact visitor location</small></div></div><div class="destination-create-card-body"><div class="destination-map-wrap"><div id="destinationMap"><div class="text-center p-5 text-muted">Loading ArcGIS map…</div></div><div class="destination-map-hint"><i class="bi bi-cursor-fill"></i> Search or click anywhere to place the pin</div></div><div class="location-status" id="locationStatus"><i class="bi bi-exclamation-circle"></i> No location selected yet — search or click the map to continue.</div><div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="Latitude" class="form-label">Latitude</label><div class="coordinate-card"><i class="bi bi-arrow-up-down"></i><input asp-for="Latitude" class="form-control" id="Latitude" type="number" step="any" /></div><span asp-validation-for="Latitude" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Longitude" class="form-label">Longitude</label><div class="coordinate-card"><i class="bi bi-arrow-left-right"></i><input asp-for="Longitude" class="form-control" id="Longitude" type="number" step="any" /></div><span asp-validation-for="Longitude" class="text-danger"></span></div></div><input asp-for="LocationSelected" type="hidden" id="LocationSelected" /><div class="field-hint">ArcGIS uses X = longitude and Y = latitude. Manual edits move the marker and map together.</div></div></div></section>

                <section class="destination-pane" data-pane="2"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-calendar2-week"></i></span><div><strong>Opening schedule and booking</strong><small>Make visitor access clear without overloading the destination</small></div></div><div class="destination-create-card-body"><div class="public-schedule" id="publicSchedule"><i class="bi bi-clock-fill"></i><span>Open 24 Hours &nbsp;·&nbsp; Every Day</span></div><div id="normalSchedule"><label class="form-label">Opening days</label><div class="day-picker mb-4">@foreach (var day in days) { <label><input type="checkbox" name="SelectedDays" value="@day" @(Model.SelectedDays.Contains(day) ? "checked" : "") /><span>@day[..3]</span></label> }</div><div class="row g-4"><div class="col-md-6"><label asp-for="OpenAt" class="form-label">Opening hour</label><input asp-for="OpenAt" class="form-control" type="number" min="0" max="23" placeholder="09" /></div><div class="col-md-6"><label asp-for="CloseAt" class="form-label">Closing hour</label><input asp-for="CloseAt" class="form-control" type="number" min="0" max="23" placeholder="17" /></div></div></div><div class="field-hint mt-3" id="publicBookingHint">Public destinations automatically receive All Days, 00:00–23:00, and no booking requirement.</div></div></div></section>

                <section class="destination-pane" data-pane="3"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-ticket-perforated"></i></span><div><strong>Visitor access and pricing</strong><small>Prices stay optional unless tickets are required</small></div></div><div class="destination-create-card-body"><div class="ticket-toggle"><div><strong>Does this destination require a ticket?</strong><small>Public destinations are always free to access.</small></div><div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="ticketSwitch" aria-label="Ticket required" /></div></div><select asp-for="TicketRequired" class="form-select d-none" id="ticketRequired"><option value="No">No</option><option value="Yes">Yes</option></select><div class="ticket-price-fields is-disabled" id="ticketPriceFields"><div class="row g-4"><div class="col-md-6"><label asp-for="EgyptianPrice" class="form-label">Egyptian visitor price</label><input asp-for="EgyptianPrice" class="form-control ticket-price" type="number" min="0" placeholder="0" /></div><div class="col-md-6"><label asp-for="StudentEgyptianPrice" class="form-label">Egyptian student price</label><input asp-for="StudentEgyptianPrice" class="form-control ticket-price" type="number" min="0" placeholder="0" /></div><div class="col-md-6"><label asp-for="ForeignPrice" class="form-label">Foreign visitor price</label><input asp-for="ForeignPrice" class="form-control ticket-price" type="number" min="0" placeholder="0" /></div><div class="col-md-6"><label asp-for="StudentForeignPrice" class="form-label">Foreign student price</label><input asp-for="StudentForeignPrice" class="form-control ticket-price" type="number" min="0" placeholder="0" /></div></div></div></div></div></section>

                <section class="destination-pane" data-pane="4"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-images"></i></span><div><strong>Destination gallery</strong><small>Combine uploaded images and public image URLs before publishing</small></div></div><div class="destination-create-card-body"><div class="image-dropzone" id="imageDropzone"><i class="bi bi-cloud-arrow-up"></i><strong>Drop images here or click to browse</strong><span>JPG, PNG, or WEBP · up to 10 MB per image · multiple files supported</span><input asp-for="ImageFiles" id="imageFiles" type="file" accept=".jpg,.jpeg,.png,.webp" multiple /></div><div class="image-preview-grid" id="imagePreviewGrid"></div><span asp-validation-for="ImageFiles" class="text-danger"></span><hr class="my-4" /><label class="form-label">External Image URLs</label><div id="externalUrlList"></div><button type="button" class="btn btn-outline-secondary btn-sm" id="addExternalUrl"><i class="bi bi-plus-lg me-1"></i>Add Another URL</button><div class="field-hint">Each valid URL previews immediately. Broken or non-image URLs stay visibly flagged and are not submitted.</div></div></div></section>

                <section class="destination-pane" data-pane="5"><div class="destination-create-card"><div class="destination-create-card-header"><span class="destination-section-icon"><i class="bi bi-check2-circle"></i></span><div><strong>Review and publish</strong><small>Confirm the essentials before creating the ArcGIS feature</small></div></div><div class="destination-create-card-body"><div class="row g-3"><div class="col-md-6"><div class="field-hint">Destination</div><strong id="reviewName">—</strong></div><div class="col-md-6"><div class="field-hint">Category</div><strong id="reviewCategory">—</strong></div><div class="col-md-6"><div class="field-hint">Location</div><strong id="reviewLocation">Select a point</strong></div><div class="col-md-6"><div class="field-hint">Access</div><strong id="reviewAccess">—</strong></div></div><div class="alert alert-info mt-4 mb-0">The destination will be created in ArcGIS first, then synchronized with the local directory.</div></div></div></section>
            </main>
        </div>
        <div class="destination-create-actions"><button type="button" class="btn btn-outline-secondary" id="previousStep"><i class="bi bi-arrow-left me-1"></i> Previous</button><button type="button" class="btn btn-primary" id="nextStep">Next <i class="bi bi-arrow-right ms-1"></i></button><button type="submit" class="btn btn-primary d-none" id="publishDestination"><i class="bi bi-cloud-plus me-1"></i> Add Destination</button></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('addDestinationForm'), panes = Array.from(document.querySelectorAll('.destination-pane')), steps = Array.from(document.querySelectorAll('.destination-step')), current = 0;
            var lat = document.getElementById('Latitude'), lng = document.getElementById('Longitude'), selected = document.getElementById('LocationSelected'), status = document.getElementById('locationStatus');
            var category = document.getElementById('categorySelect'), normalSchedule = document.getElementById('normalSchedule'), publicSchedule = document.getElementById('publicSchedule'), ticketSwitch = document.getElementById('ticketSwitch'), ticketRequired = document.getElementById('ticketRequired'), ticketFields = document.getElementById('ticketPriceFields');
            var imageInput = document.getElementById('imageFiles'), dropzone = document.getElementById('imageDropzone'), preview = document.getElementById('imagePreviewGrid'), fileItems = [];
            var setLocation = function () { var la = parseFloat(lat.value), lo = parseFloat(lng.value); if (Number.isFinite(la) && Number.isFinite(lo) && (la !== 0 || lo !== 0)) { selected.value = 'true'; status.classList.add('selected'); status.innerHTML = '<i class="bi bi-check-circle-fill"></i> Location selected: ' + la.toFixed(6) + ', ' + lo.toFixed(6); } };
            var syncPublic = function () { var isPublic = category.value.toLowerCase() === 'public'; normalSchedule.style.display = isPublic ? 'none' : ''; publicSchedule.style.display = isPublic ? 'flex' : 'none'; if (isPublic) { document.querySelectorAll('input[name="SelectedDays"]').forEach(function (x) { x.checked = false; x.disabled = true; }); document.getElementById('OpenAt').value = '0'; document.getElementById('CloseAt').value = '23'; ticketSwitch.checked = false; ticketSwitch.disabled = true; document.getElementById('bookingInput').value = ''; document.getElementById('bookingInput').disabled = true; } else { document.querySelectorAll('input[name="SelectedDays"]').forEach(function (x) { x.disabled = false; }); ticketSwitch.disabled = false; document.getElementById('bookingInput').disabled = false; } ticketRequired.value = isPublic ? 'No' : (ticketSwitch.checked ? 'Yes' : 'No'); ticketFields.classList.toggle('is-disabled', !ticketSwitch.checked || isPublic); ticketFields.querySelectorAll('input').forEach(function (x) { x.disabled = !ticketSwitch.checked || isPublic; if (isPublic) x.value = ''; }); };
            var syncTicket = function () { ticketRequired.value = ticketSwitch.checked ? 'Yes' : 'No'; ticketFields.classList.toggle('is-disabled', !ticketSwitch.checked || category.value.toLowerCase() === 'public'); ticketFields.querySelectorAll('input').forEach(function (x) { x.disabled = !ticketSwitch.checked || category.value.toLowerCase() === 'public'; if (!ticketSwitch.checked) x.value = ''; }); };
            var updateReview = function () { document.getElementById('reviewName').textContent = document.getElementById('Name').value || '—'; document.getElementById('reviewCategory').textContent = category.value || '—'; document.getElementById('reviewLocation').textContent = lat.value && lng.value ? lat.value + ', ' + lng.value : 'Select a point'; document.getElementById('reviewAccess').textContent = category.value.toLowerCase() === 'public' ? 'Open 24 Hours · Every Day' : (ticketSwitch.checked ? 'Ticketed destination' : 'No ticket required'); };
            var renderFiles = function () { preview.innerHTML = ''; fileItems.forEach(function (file, index) { var reader = new FileReader(); reader.onload = function (e) { var item = document.createElement('div'); item.className = 'image-preview-item'; item.innerHTML = '<img src="' + e.target.result + '" alt=""><span class="image-name"></span><button type="button" class="image-remove" aria-label="Remove image"><i class="bi bi-trash3"></i></button>'; item.querySelector('.image-name').textContent = file.name; item.querySelector('.image-remove').addEventListener('click', function () { fileItems.splice(index, 1); rebuildFiles(); }); preview.appendChild(item); }; reader.readAsDataURL(file); }); };
            var rebuildFiles = function () { var dt = new DataTransfer(); fileItems.forEach(function (f) { dt.items.add(f); }); imageInput.files = dt.files; renderFiles(); };
            var addFiles = function (files) { Array.from(files).forEach(function (file) { if (!file.type.match(/^image\/(jpeg|png|webp)$/i) || file.size > 10 * 1024 * 1024) return; if (!fileItems.some(function (f) { return f.name === file.name && f.size === file.size; })) fileItems.push(file); }); rebuildFiles(); };
            var addUrlRow = function (value) { var row = document.createElement('div'); row.className = 'external-url-row'; row.innerHTML = '<div><input name="ExternalImageUrls" class="form-control external-url-input" type="url" placeholder="https://example.com/image.jpg"><div class="url-error text-danger field-hint"></div></div><button type="button" class="btn btn-outline-secondary btn-sm remove-url" aria-label="Remove URL"><i class="bi bi-trash3"></i></button><div class="url-preview"><img alt=""><span>Preview loading…</span></div>'; var input = row.querySelector('input'); input.value = value || ''; var previewBox = row.querySelector('.url-preview'), img = previewBox.querySelector('img'), message = previewBox.querySelector('span'); var validate = function () { var url = input.value.trim(); row.classList.remove('is-valid', 'is-invalid'); row.querySelector('.url-error').textContent = ''; if (!url) return; try { var parsed = new URL(url); if (!/^https?:$/.test(parsed.protocol)) throw new Error(); } catch (_) { row.classList.add('is-invalid'); row.querySelector('.url-error').textContent = 'Enter a valid http(s) image URL.'; return; } row.classList.add('is-valid'); message.textContent = 'Loading preview…'; img.onload = function () { message.textContent = 'Image ready'; }; img.onerror = function () { row.classList.remove('is-valid'); row.classList.add('is-invalid'); message.textContent = 'This URL did not return a readable image.'; }; img.src = url; }; input.addEventListener('input', validate); row.querySelector('.remove-url').addEventListener('click', function () { row.remove(); }); document.getElementById('externalUrlList').appendChild(row); validate(); };
            var validateStep = function (index) { if (index === 0) { return ['Name', 'City', 'categorySelect'].every(function (id) { var el = document.getElementById(id); return el && el.value.trim(); }); } if (index === 1) return selected.value === 'true'; return true; };
            var showStep = function (index) { current = Math.max(0, Math.min(index, panes.length - 1)); panes.forEach(function (p, i) { p.classList.toggle('active', i === current); }); steps.forEach(function (s, i) { s.classList.toggle('active', i === current); s.classList.toggle('completed', i < current); var dot = s.querySelector('.destination-step-dot'); dot.innerHTML = i < current ? '<i class="bi bi-check2"></i>' : String(i + 1); }); document.getElementById('previousStep').classList.toggle('d-none', current === 0); document.getElementById('nextStep').classList.toggle('d-none', current === panes.length - 1); document.getElementById('publishDestination').classList.toggle('d-none', current !== panes.length - 1); updateReview(); if (current === 1 && window.EGYMaps && EGYMaps.resize) setTimeout(function () { EGYMaps.resize('destinationMap'); }, 50); };
                        steps.forEach(function (s) { s.addEventListener('click', function () { var target = Number(s.dataset.step); if (target > current && !validateStep(current)) { if (current === 1) { status.classList.remove('selected'); status.innerHTML = '<i class="bi bi-exclamation-circle"></i> Please select a location on the map.'; } return; } showStep(target); }); }); document.getElementById('nextStep').addEventListener('click', function () { if (!validateStep(current)) { if (current === 0) { document.getElementById('addDestinationForm').reportValidity(); } else { status.classList.remove('selected'); status.innerHTML = '<i class="bi bi-exclamation-circle"></i> Please select a location on the map.'; } return; } showStep(current + 1); }); document.getElementById('previousStep').addEventListener('click', function () { showStep(current - 1); }); category.addEventListener('change', function () { syncPublic(); syncTicket(); updateReview(); }); ticketSwitch.addEventListener('change', syncTicket); [lat, lng].forEach(function (x) { x.addEventListener('input', setLocation); x.addEventListener('change', setLocation); }); imageInput.addEventListener('change', function () { addFiles(imageInput.files); });
 ['dragenter', 'dragover'].forEach(function (n) { dropzone.addEventListener(n, function (e) { e.preventDefault(); dropzone.classList.add('dragover'); }); }); ['dragleave', 'drop'].forEach(function (n) { dropzone.addEventListener(n, function (e) { e.preventDefault(); dropzone.classList.remove('dragover'); if (n === 'drop') addFiles(e.dataTransfer.files); }); }); document.getElementById('addExternalUrl').addEventListener('click', function () { addUrlRow(''); });
            form.addEventListener('submit', function (e) { syncPublic(); if (selected.value !== 'true') { e.preventDefault(); showStep(1); status.classList.remove('selected'); status.innerHTML = '<i class="bi bi-exclamation-circle"></i> Please select a location on the map.'; return; } var invalidUrls = Array.from(document.querySelectorAll('.external-url-row.is-invalid')); if (invalidUrls.length) { e.preventDefault(); showStep(4); return; } document.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; }); });
            var initialExternalUrls = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExternalImageUrls ?? new List<string>()));
            if (initialExternalUrls.length) initialExternalUrls.forEach(function (url) { addUrlRow(url); }); else addUrlRow('');
            ticketSwitch.checked = ticketRequired.value === 'Yes'; syncPublic(); syncTicket(); showStep(0);
            if (window.EGYMaps) EGYMaps.initLocationPicker({ mapElId:'destinationMap', latInputId:'Latitude', lngInputId:'Longitude', contextLayer:'destinations', initialLat:30.0444, initialLng:31.2357, contextStyle:{ radius:6, fillColor:'#64748B', color:'#fff', weight:1, opacity:.7, fillOpacity:.25 }, onLocationSelected:function () { setLocation(); } });
        })();
    </script>
}
