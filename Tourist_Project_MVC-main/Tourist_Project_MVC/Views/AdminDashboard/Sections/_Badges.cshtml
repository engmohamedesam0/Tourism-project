@model Tourist_Project_MVC.View_Model.AdminDashboardVM

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon-wrapper gold">
            <i class="bi bi-award-fill"></i>
        </div>
        <div>
            <div class="kpi-label">@Localizer["Dash_TotalBadges"].Value</div>
            <div class="kpi-value">@Model.BadgeSection.TotalBadges</div>
            <div class="kpi-sub">@Localizer["Dash_AvailableBadges"].Value</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-wrapper green">
            <i class="bi bi-trophy-fill"></i>
        </div>
        <div>
            <div class="kpi-label">@Localizer["Dash_TotalEarned"].Value</div>
            <div class="kpi-value">@Model.BadgeSection.TotalEarned</div>
            <div class="kpi-sub">@Localizer["Dash_UserAchievements"].Value</div>
        </div>
    </div>
</div>

<div class="dash-card">
    <div class="dash-card-header">
        <span><i class="bi bi-tags me-2"></i> @Localizer["Dash_BadgesByRarity"].Value</span>
    </div>
    <div class="dash-card-body">
        @foreach (var row in Model.BadgeSection.RarityBreakdown)
        {
            <div class="top-branch-item mb-2">
                <div class="top-branch-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-bold" style="color: var(--egy-dark); font-size: 0.9rem;">@row.Name</h6>
                </div>
                <span class="badge bg-dark">@row.Count</span>
            </div>
        }
    </div>
</div>
