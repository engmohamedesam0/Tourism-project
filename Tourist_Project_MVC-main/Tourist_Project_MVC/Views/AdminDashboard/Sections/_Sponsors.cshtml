@model Tourist_Project_MVC.View_Model.AdminDashboardVM

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon-wrapper dark">
            <i class="bi bi-building-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Sponsors</div>
            <div class="kpi-value">@Model.SponsorSection.Total</div>
            <div class="kpi-sub">Registered partners</div>
        </div>
    </div>
</div>

<div class="dash-card">
    <div class="dash-card-header">
        <span><i class="bi bi-diagram-3 me-2"></i> Sponsors by Type</span>
    </div>
    <div class="dash-card-body">
        @foreach (var row in Model.SponsorSection.TypeBreakdown)
        {
            <div class="top-branch-item mb-2">
                <div class="top-branch-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-bold" style="color: var(--egy-dark); font-size: 0.9rem;">@row.Name</h6>
                </div>
                <span class="badge bg-dark">@row.Count</span>
            </div>
        }
    </div>
</div>
