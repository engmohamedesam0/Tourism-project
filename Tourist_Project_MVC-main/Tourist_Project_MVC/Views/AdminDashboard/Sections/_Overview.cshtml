@model Tourist_Project_MVC.View_Model.AdminDashboardVM

<!-- TOP KPI CARDS GRID -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon-wrapper blue">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Tourists</div>
            <div class="kpi-value">@Model.TotalTourists</div>
            <div class="kpi-sub">Registered users</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrapper green">
            <i class="bi bi-building-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Sponsors</div>
            <div class="kpi-value">@Model.TotalSponsors</div>
            <div class="kpi-sub">Active partners</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrapper gold">
            <i class="bi bi-geo-alt-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Destinations</div>
            <div class="kpi-value">@Model.TotalDestinations</div>
            <div class="kpi-sub">Listed locations</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrapper purple">
            <i class="bi bi-gift-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Rewards</div>
            <div class="kpi-value">@Model.TotalRewards</div>
            <div class="kpi-sub">Available offers</div>
        </div>
    </div>
</div>

<!-- STAT BOX ROW -->
@await Html.PartialAsync("_StatBoxRow", (List<Tourist_Project_MVC.View_Model.StatBoxItem>)ViewBag.StatBoxes)

<!-- MAIN DASHBOARD GRID (3 COLUMNS) -->
<div class="dashboard-main-grid">

    <!-- LEFT COLUMN (MAP FILTERS) -->
    <aside class="dash-sidebar">
        <div class="dash-card">
            <div class="dash-card-header">
                <span><i class="bi bi-funnel me-2"></i> Map Filters</span>
            </div>
            <div class="dash-card-body">
                <div class="chips-filter-group">
                    <button class="chip-btn chip-active" onclick="filterMap('all')">
                        <span>All Branches</span>
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="chip-btn" onclick="filterMap('active')">
                        <span>High Activity</span>
                        <i class="bi bi-graph-up"></i>
                    </button>
                    <button class="chip-btn" onclick="filterMap('recent')">
                        <span>Recently Added</span>
                        <i class="bi bi-clock-history"></i>
                    </button>
                </div>
            </div>
        </div>
    </aside>

    <!-- CENTER COLUMN (INTERACTIVE MAP) -->
    <main class="dash-center-column">
        <div class="dash-map-card">
            <div class="map-card-bar">
                <div class="map-card-title">
                    <i class="bi bi-map"></i> Platform Network Map
                </div>
                <div class="map-live-indicator">
                    <div class="live-dot"></div>
                    LIVE GIS DATA
                </div>
            </div>
            <div class="dash-map-container" id="dashboardMap">
                <div class="map-watermark">
                    <h2><partial name="_EgyxploreWordmark" /></h2>
                </div>
            </div>
        </div>
    </main>

    <!-- RIGHT COLUMN (RATING & HIGHLIGHTS) -->
    <aside class="dash-widgets">
        <div class="dash-card rating-widget-card">
            <div class="dash-card-header justify-content-center border-0 bg-transparent pb-0">
                <span><i class="bi bi-star me-2"></i> AI Satisfaction</span>
            </div>
            <div class="dash-card-body">
                @if (Model.RatingAvailable)
                {
                    <div class="rating-gauge-wrapper" style="--rating: @(Model.AverageRating / 5.0)">
                        <div class="rating-gauge">
                            <div class="rating-gauge-value">@Model.AverageRating?.ToString("0.0")</div>
                        </div>
                    </div>
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating ?? 0))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                    </div>
                    <div class="kpi-sub mt-2">@Model.ReviewCount reviews</div>
                }
                else
                {
                    <div class="text-muted mt-3 mb-3">
                        <i class="bi bi-info-circle display-4 d-block mb-2 text-black-50"></i>
                        No ratings available yet.
                    </div>
                }
            </div>
        </div>

        <div class="dash-card top-performing-card">
            <div class="dash-card-header bg-transparent">
                <span><i class="bi bi-trophy me-2"></i> Highlights</span>
            </div>
            <div class="dash-card-body">
                <div class="kpi-label mb-2">Missions Completed</div>
                <div class="top-branch-item">
                    <div class="top-branch-icon">
                        <i class="bi bi-flag-fill"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold" style="color: var(--egy-dark); font-size: 0.9rem;">
                            @Model.TotalMissionsCompleted.ToString("N0")
                        </h6>
                        <span class="text-muted" style="font-size: 0.75rem;">Platform-wide completions</span>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="kpi-label mb-2">Total Redemptions</div>
                    <div class="top-branch-item">
                        <div class="top-branch-icon">
                            <i class="bi bi-receipt-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" style="color: var(--egy-dark); font-size: 0.9rem;">
                                @Model.TotalRedemptions.ToString("N0")
                            </h6>
                            <span class="text-muted" style="font-size: 0.75rem;">All-time claims</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

</div>

<!-- BOTTOM CHARTS GRID -->
<div class="charts-grid">
    <div class="chart-card">
        <div class="dash-card-header">
            <span><i class="bi bi-graph-up me-2"></i> Monthly Performance</span>
        </div>
        <div class="chart-body-wrapper">
            <canvas id="monthlyTrendChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="dash-card-header">
            <span><i class="bi bi-bar-chart me-2"></i> Top Rewards by Claims</span>
        </div>
        <div class="chart-body-wrapper">
            @if (Model.DashboardTopRewards.Any())
            {
                <canvas id="topRewardsChart"></canvas>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                    <div class="text-center">
                        <i class="bi bi-inbox display-4 d-block mb-2 text-black-50"></i>
                        No reward data available
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="chart-card">
        <div class="dash-card-header">
            <span><i class="bi bi-pie-chart me-2"></i> Engagement Split</span>
        </div>
        <div class="chart-body-wrapper">
            <canvas id="engagementPieChart"></canvas>
        </div>
    </div>
</div>
