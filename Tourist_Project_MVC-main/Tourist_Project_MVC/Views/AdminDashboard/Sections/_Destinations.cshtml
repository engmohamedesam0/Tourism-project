@model Tourist_Project_MVC.View_Model.AdminDashboardVM

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon-wrapper gold">
            <i class="bi bi-geo-alt-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Total Destinations</div>
            <div class="kpi-value">@Model.DestinationSection.Total</div>
            <div class="kpi-sub">Listed locations</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon-wrapper green">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <div>
            <div class="kpi-label">Active</div>
            <div class="kpi-value">@Model.DestinationSection.Active</div>
            <div class="kpi-sub">Ready for tourists</div>
        </div>
    </div>
</div>

<div class="dash-card">
    <div class="dash-card-header">
        <span><i class="bi bi-tags me-2"></i> Destinations by Category</span>
    </div>
    <div class="dash-card-body">
        @foreach (var row in Model.DestinationSection.CategoryBreakdown)
        {
            <div class="top-branch-item mb-2">
                <div class="top-branch-icon">
                    <i class="bi bi-map-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-bold" style="color: var(--egy-dark); font-size: 0.9rem;">@row.Name</h6>
                </div>
                <span class="badge bg-dark">@row.Count</span>
            </div>
        }
    </div>
</div>
