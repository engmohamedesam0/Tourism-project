@model Tourist_Project_MVC.View_Model.AdminDashboardVM

@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["IsHomePage"] = false;
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<!-- Full-bleed ArcGIS Online dashboard: no page header, no margins -->
@if (!string.IsNullOrWhiteSpace(Model.ArcGISDashboardUrl))
{
    <div class="arcgis-dashboard-embed">
        @if (TempData["ArcGISMessage"] != null)
        {
            var msgType = TempData["ArcGISMessageType"]?.ToString() ?? "info";
            <div class="alert alert-@msgType alert-dismissible fade show arcgis-dashboard-toast" role="alert" id="arcgis-toast">
                @TempData["ArcGISMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <iframe src="@Model.ArcGISDashboardUrl"
                title="@Localizer["ArcGISDashboard_PoweredBy"].Value"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a href="@Model.ArcGISDashboardUrl" target="_blank" rel="noopener noreferrer"
           class="arcgis-dashboard-fullscreen"
           title="@Localizer["ArcGISDashboard_OpenFullscreen"].Value">
            <i class="bi bi-arrows-fullscreen"></i>
        </a>
    </div>
}
else
{
    <div class="arcgis-dashboard-embed arcgis-dashboard-embed-empty">
        <div class="alert alert-warning d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Localizer["ArcGISDashboard_NotConfigured"].Value</span>
        </div>
    </div>
}
