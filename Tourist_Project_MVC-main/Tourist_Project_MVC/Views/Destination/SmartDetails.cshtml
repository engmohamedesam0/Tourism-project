@model Tourist_Project_MVC.View_Model.DestinationSmartDetailsVM
@using System.Globalization
@{
    ViewData["Title"] = "Destination Details";
    var isAdmin = User.IsInRole("Admin");
    var feature = Model.Feature;
    var attributes = feature?.Attributes ?? new Dictionary<string, object?>();
    string Display(object? value) => value switch { null => "Not Available", string s when string.IsNullOrWhiteSpace(s) || s is "N/A" or "n/a" => "Not Available", _ => Convert.ToString(value, CultureInfo.CurrentCulture) ?? "Not Available" };
    string Value(string name) => attributes.TryGetValue(name, out var value) ? Display(value) : "Not Available";
    bool IsImage(string name, object? value) => name.Equals("Images", StringComparison.OrdinalIgnoreCase) || (value?.ToString()?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true && (value.ToString().Contains(".jpg", StringComparison.OrdinalIgnoreCase) || value.ToString().Contains(".png", StringComparison.OrdinalIgnoreCase) || value.ToString().Contains(".webp", StringComparison.OrdinalIgnoreCase)));
    bool IsUrl(object? value) => value?.ToString()?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true;
    var basic = new[] { "Id", "English_Name", "Arabic_Name", "Governorate", "Category", "Status" };
    var location = new[] { "Latitiude", "Longitude" };
    var visitor = new[] { "Visits", "Rating", "Booking" };
    var pricing = new[] { "TicketRequired", "ForeignPrice", "StudentForeignPrice", "EgyptianPrice", "StudentEgyptianPrice" };
    var opening = new[] { "Days", "Open_at", "Close_at" };
    var media = new[] { "Images" };
    var used = basic.Concat(location).Concat(visitor).Concat(pricing).Concat(opening).Concat(media).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var extra = Model.Fields.Where(f => !used.Contains(f.Name) && !f.Name.Equals("ObjectId", StringComparison.OrdinalIgnoreCase)).ToList();
    void RenderSection(string title, string icon, IEnumerable<string> names) {
        <section class="smart-detail-card"><div class="smart-detail-head"><i class="bi @icon"></i><strong>@title</strong></div><div class="smart-detail-fields">@foreach(var name in names){var field=Model.Fields.FirstOrDefault(f=>f.Name.Equals(name,StringComparison.OrdinalIgnoreCase));if(field==null)continue;var raw=attributes.TryGetValue(field.Name,out var value)?value:null;<div class="smart-detail-field"><span class="smart-detail-label">@field.Alias</span>@if(IsImage(field.Name,raw)){<div class="smart-images">@foreach(var image in (raw?.ToString()??"").Split('|','\n',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){<a href="@image" target="_blank" rel="noopener"><img src="@image" alt="@field.Alias" onerror="this.style.display='none'"></a>}</div>}else if(IsUrl(raw)){<a class="smart-detail-link" href="@raw" target="_blank" rel="noopener">@Display(raw) <i class="bi bi-box-arrow-up-right"></i></a>}else if(field.Name.Equals("TicketRequired",StringComparison.OrdinalIgnoreCase)||field.Name.Equals("Status",StringComparison.OrdinalIgnoreCase)){<span class="smart-detail-badge">@Display(raw)</span>}else{<span class="smart-detail-value">@Display(raw)</span>}</div>}</div></section>;
    }
}
@section Styles {<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /><style>
.smart-detail-page{max-width:1250px;margin:0 auto;padding-bottom:2rem;color:var(--dash-text-primary)}.smart-detail-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;padding:1.35rem 1.5rem;margin-bottom:1rem;border:1px solid color-mix(in srgb,var(--dash-primary) 27%,var(--dash-border));border-radius:16px;background:linear-gradient(135deg,color-mix(in srgb,var(--dash-primary) 8%,var(--dash-card-bg)),var(--dash-card-bg));box-shadow:var(--dash-shadow-sm)}.smart-detail-kicker{color:var(--dash-primary);font-size:.62rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.smart-detail-top h1{margin:.3rem 0 .2rem;font-size:clamp(1.35rem,2.8vw,2.1rem);font-weight:900}.smart-detail-top p{margin:0;color:var(--dash-text-muted);font-size:.74rem}.smart-detail-actions{display:flex;gap:.45rem}.smart-detail-actions .btn{border-radius:8px;font-size:.7rem;font-weight:800}.smart-detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:1rem}.smart-detail-card{border:1px solid var(--dash-border);border-radius:14px;background:var(--dash-card-bg);box-shadow:var(--dash-shadow-sm);overflow:hidden;margin-bottom:1rem}.smart-detail-head{display:flex;align-items:center;gap:.55rem;padding:.8rem 1rem;border-bottom:1px solid var(--dash-border);font-size:.76rem}.smart-detail-head i{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;color:var(--dash-primary);background:var(--dash-primary-light)}.smart-detail-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:.6rem;padding:1rem}.smart-detail-field{min-width:0;padding:.6rem .65rem;border:1px solid var(--dash-border);border-radius:9px;background:var(--dash-bg)}.smart-detail-label{display:block;color:var(--dash-text-muted);font-size:.59rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.smart-detail-value,.smart-detail-link{display:block;margin-top:.3rem;color:var(--dash-text-primary);font-size:.73rem;font-weight:750;overflow-wrap:anywhere}.smart-detail-link{color:var(--dash-primary);text-decoration:none}.smart-detail-badge{display:inline-flex;margin-top:.3rem;padding:.26rem .48rem;border-radius:999px;color:var(--dash-primary);background:var(--dash-primary-light);font-size:.65rem;font-weight:900}.smart-images{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.35rem}.smart-images img{width:64px;height:48px;object-fit:cover;border-radius:6px;border:1px solid var(--dash-border)}.smart-detail-note{padding:.8rem;border-radius:10px;color:var(--dash-text-secondary);background:var(--dash-bg);font-size:.68rem;line-height:1.55}.smart-detail-error{padding:.8rem;margin-bottom:1rem;border-radius:10px;color:var(--dash-rose);background:var(--dash-rose-bg);font-size:.72rem}@@media(max-width:850px){.smart-detail-layout{grid-template-columns:1fr}.smart-detail-top{align-items:flex-start;flex-direction:column}.smart-detail-actions{width:100%}.smart-detail-actions .btn{flex:1}}
</style>}
<div class="smart-detail-page"><a href="/Destination" class="d-inline-flex align-items-center gap-1 mb-2 text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to all destinations</a><div class="smart-detail-top"><div><div class="smart-detail-kicker"><i class="bi bi-database me-1"></i> Live ArcGIS feature · ObjectId @Display(feature?.ObjectId)</div><h1>@Value("English_Name")</h1><p>@Value("Arabic_Name") · @Value("Governorate") · Database Id @Display(feature?.DatabaseId)</p></div><div class="smart-detail-actions">@if(isAdmin){<a asp-action="Edit" asp-route-id="@(feature?.DatabaseId ?? feature?.ObjectId)" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a><a asp-action="Delete" asp-route-id="@(feature?.DatabaseId ?? feature?.ObjectId)" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</a>}</div></div>@if(!string.IsNullOrWhiteSpace(Model.Error)){<div class="smart-detail-error"><i class="bi bi-exclamation-triangle me-1"></i> @Model.Error</div>}<div class="smart-detail-layout"><main>@{RenderSection("Basic Information","bi-card-text",basic);RenderSection("Location","bi-geo-alt",location);RenderSection("Visitor Information","bi-people",visitor);RenderSection("Ticket & Pricing","bi-ticket-perforated",pricing);RenderSection("Opening Information","bi-calendar2-week",opening);RenderSection("Media","bi-images",media);RenderSection("Additional Information","bi-braces",extra.Select(f => f.Name));}</main><aside><section class="smart-detail-card"><div class="smart-detail-head"><i class="bi bi-diagram-3"></i><strong>GIS / system</strong></div><div class="smart-detail-fields"><div class="smart-detail-field"><span class="smart-detail-label">ObjectId</span><span class="smart-detail-value">@Display(feature?.ObjectId)</span></div><div class="smart-detail-field"><span class="smart-detail-label">GlobalId</span><span class="smart-detail-value">Not Available — layer has no GlobalId</span></div><div class="smart-detail-field"><span class="smart-detail-label">Spatial reference</span><span class="smart-detail-value">WKID 102100 / 3857</span></div></div></section><div class="smart-detail-note"><i class="bi bi-info-circle me-1"></i> This page is driven by the live ArcGIS field schema. Every returned field is rendered in a section or Additional Information, including fields added later to the layer.</div></aside></div></div>
