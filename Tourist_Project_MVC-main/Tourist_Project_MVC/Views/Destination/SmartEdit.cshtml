@model Tourist_Project_MVC.View_Model.DestinationSmartEditVM
@{
    ViewData["Title"] = "Edit destination";
    var editableFields = Model.Fields.Where(f => f.Editable && !f.Name.Equals("ObjectId", StringComparison.OrdinalIgnoreCase) && !f.Name.Equals("Id", StringComparison.OrdinalIgnoreCase)).ToList();
    var groups = new[] { ("Basic information", "bi-card-text", new[] { "English_Name", "Arabic_Name", "Governorate", "Category", "Status" }), ("Location", "bi-geo-alt", new[] { "Latitiude", "Longitude" }), ("Visitor and access", "bi-people", new[] { "Visits", "Rating", "Booking", "TicketRequired" }), ("Ticket and pricing", "bi-ticket-perforated", new[] { "ForeignPrice", "StudentForeignPrice", "EgyptianPrice", "StudentEgyptianPrice" }), ("Opening information", "bi-calendar2-week", new[] { "Days", "Open_at", "Close_at" }), ("Content and media", "bi-file-earmark-richtext", new[] { "Description", "Tags", "Images" }) };
    string Value(string name) => Model.Values.TryGetValue(name, out var value) ? value ?? string.Empty : string.Empty;
    bool IsLongText(string name) => new[] { "Description", "Days", "Tags", "Images" }.Contains(name, StringComparer.OrdinalIgnoreCase);
    bool IsNumber(string type) => type.Contains("Integer", StringComparison.OrdinalIgnoreCase) || type.Contains("Double", StringComparison.OrdinalIgnoreCase) || type.Contains("Single", StringComparison.OrdinalIgnoreCase) || type.Contains("Decimal", StringComparison.OrdinalIgnoreCase);
    string Label(string alias) => alias.Replace("_", " ");
    var grouped = groups.Select(g => (g, fields: editableFields.Where(f => g.Item3.Contains(f.Name, StringComparer.OrdinalIgnoreCase)).ToList())).Where(x => x.fields.Count > 0).ToList();
    var used = grouped.SelectMany(x => x.fields).Select(f => f.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var additional = editableFields.Where(f => !used.Contains(f.Name)).ToList();
}
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /><style>
.smart-edit-page{max-width:1280px;margin:0 auto;padding:1rem 0 3rem;color:var(--dash-text-primary)}.smart-edit-header{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;padding:1.25rem 1.4rem;margin-bottom:1rem;border:1px solid color-mix(in srgb,var(--dash-primary) 26%,var(--dash-border));border-radius:16px;background:linear-gradient(135deg,color-mix(in srgb,var(--dash-primary) 8%,var(--dash-card-bg)),var(--dash-card-bg));box-shadow:var(--dash-shadow-sm)}.smart-edit-kicker{color:var(--dash-primary);font-size:.62rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.smart-edit-header h1{margin:.3rem 0;font-size:clamp(1.35rem,2.5vw,2rem);font-weight:900}.smart-edit-header p{margin:0;color:var(--dash-text-muted);font-size:.72rem}.smart-edit-card{border:1px solid var(--dash-border);border-radius:14px;background:var(--dash-card-bg);box-shadow:var(--dash-shadow-sm);overflow:hidden;margin-bottom:1rem}.smart-edit-card-head{display:flex;align-items:center;gap:.55rem;padding:.8rem 1rem;border-bottom:1px solid var(--dash-border);font-size:.76rem}.smart-edit-card-head i{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;color:var(--dash-primary);background:var(--dash-primary-light)}.smart-edit-card-body{padding:1rem}.smart-edit-field label{display:flex;gap:.35rem;align-items:center;margin-bottom:.3rem;color:var(--dash-text-muted);font-size:.62rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.smart-edit-field label em{color:#b23a48;font-style:normal}.smart-edit-field .form-control,.smart-edit-field .form-select{min-height:38px;border-color:var(--dash-border);border-radius:8px;background:var(--dash-bg);color:var(--dash-text-primary);font-size:.75rem}.smart-edit-field textarea{min-height:100px;resize:vertical}.smart-edit-field .form-text{font-size:.63rem;color:var(--dash-text-muted)}.smart-edit-actions{display:flex;justify-content:flex-end;gap:.5rem;position:sticky;bottom:0;padding:1rem;background:color-mix(in srgb,var(--dash-card-bg) 94%,transparent);border-top:1px solid var(--dash-border);backdrop-filter:blur(8px)}@@media(max-width:700px){.smart-edit-header{align-items:flex-start;flex-direction:column}.smart-edit-actions{justify-content:stretch}.smart-edit-actions .btn{flex:1}}
</style> }
<div class="smart-edit-page">
    <div class="smart-edit-header"><div><div class="smart-edit-kicker"><i class="bi bi-pencil-square me-1"></i> ArcGIS-backed administration</div><h1>Edit destination</h1><p>Feature Id @Model.ObjectId · Database Id @Model.DatabaseId · ArcGIS is updated before local synchronization.</p></div><div class="d-flex gap-2"><a asp-action="Details" asp-route-id="@Model.DatabaseId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye me-1"></i> View</a><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div> }
    <form asp-action="Edit" asp-route-id="@Model.DatabaseId" method="post" novalidate>
        @Html.AntiForgeryToken()<input type="hidden" name="DatabaseId" value="@Model.DatabaseId" /><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @foreach (var group in grouped) { <section class="smart-edit-card"><div class="smart-edit-card-head"><i class="bi @group.g.Item2"></i><strong>@group.g.Item1</strong></div><div class="smart-edit-card-body"><div class="row g-3">
            @foreach (var field in group.fields) { var value = Value(field.Name); <div class="smart-edit-field @(IsLongText(field.Name) ? "col-12" : "col-xl-4 col-md-6")"><label for="field-@field.Name">@Label(field.Alias) @if (!field.Nullable) { <em>*</em> }</label>
                @if (field.Name.Equals("Status", StringComparison.OrdinalIgnoreCase)) { <select id="field-@field.Name" name="Values[@field.Name]" class="form-select"><option value="">Not Available</option>@foreach (var option in new[] { "Active", "Pending", "Inactive" }) { <option value="@option" selected="@(value.Equals(option, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option</option> }</select> }
                else if (field.Name.Equals("TicketRequired", StringComparison.OrdinalIgnoreCase)) { <select id="field-@field.Name" name="Values[@field.Name]" class="form-select"><option value="">Not Available</option>@foreach (var option in new[] { "Yes", "No" }) { <option value="@option" selected="@(value.Equals(option, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option</option> }</select> }
                else if (IsLongText(field.Name)) { <textarea id="field-@field.Name" name="Values[@field.Name]" class="form-control" placeholder="Enter @Label(field.Alias)">@value</textarea> }
                else { <input id="field-@field.Name" name="Values[@field.Name]" value="@value" type="@(field.Type.Contains("Integer", StringComparison.OrdinalIgnoreCase) || field.Type.Contains("Double", StringComparison.OrdinalIgnoreCase) ? "number" : "text")" step="@(field.Type.Contains("Double", StringComparison.OrdinalIgnoreCase) ? "any" : "1")" class="form-control" placeholder="Enter @Label(field.Alias)" /> }
                @if (field.Name.Equals("Images", StringComparison.OrdinalIgnoreCase)) { <div class="form-text">Use one image URL per line or separate URLs with |.</div> }
            </div> }
        </div></div></section> }
        @if (additional.Count > 0) { <section class="smart-edit-card"><div class="smart-edit-card-head"><i class="bi bi-braces"></i><strong>Additional editable information</strong></div><div class="smart-edit-card-body"><div class="row g-3">@foreach (var field in additional) { var value = Value(field.Name); <div class="smart-edit-field col-xl-4 col-md-6"><label for="field-@field.Name">@Label(field.Alias)</label><input id="field-@field.Name" name="Values[@field.Name]" value="@value" type="text" class="form-control" /><div class="form-text">ArcGIS type: @field.Type</div></div> }</div></div></section> }
        <div class="smart-edit-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="reset" class="btn btn-outline-warning">Reset</button><button type="submit" class="btn btn-primary"><i class="bi bi-cloud-arrow-up me-1"></i> Save to ArcGIS</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
