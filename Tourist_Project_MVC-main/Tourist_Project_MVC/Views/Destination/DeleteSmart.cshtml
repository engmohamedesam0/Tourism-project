@model Tourist_Project_MVC.Models.Destination
@{ ViewData["Title"] = "Delete destination"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /><style>.smart-delete{max-width:720px;margin:2rem auto}.smart-delete-card{border:1px solid color-mix(in srgb,#b23a48 35%,var(--dash-border));border-radius:16px;background:var(--dash-card-bg);box-shadow:var(--dash-shadow-sm);overflow:hidden}.smart-delete-head{padding:1.25rem 1.4rem;background:color-mix(in srgb,#b23a48 8%,var(--dash-card-bg));border-bottom:1px solid var(--dash-border)}.smart-delete-head h1{margin:0;font-size:1.4rem;font-weight:900}.smart-delete-body{padding:1.4rem}.smart-delete-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin:1rem 0}.smart-delete-grid div{padding:.7rem;border:1px solid var(--dash-border);border-radius:9px;background:var(--dash-bg)}.smart-delete-label{display:block;color:var(--dash-text-muted);font-size:.6rem;font-weight:900;text-transform:uppercase}.smart-delete-value{display:block;margin-top:.25rem;font-size:.8rem;font-weight:800;overflow-wrap:anywhere}.smart-delete-actions{display:flex;justify-content:flex-end;gap:.5rem}@@media(max-width:600px){.smart-delete-grid{grid-template-columns:1fr}.smart-delete-actions{flex-direction:column}.smart-delete-actions .btn{width:100%}}</style> }
<div class="smart-delete"><div class="smart-delete-card"><div class="smart-delete-head"><div class="text-danger small fw-bold text-uppercase">Destructive action</div><h1><i class="bi bi-trash3 me-2"></i>Delete destination?</h1></div><div class="smart-delete-body"><p>This permanently removes the exact ArcGIS feature first. The local database record and related rows are removed only after ArcGIS confirms success.</p><div class="smart-delete-grid"><div><span class="smart-delete-label">Destination name</span><span class="smart-delete-value">@Model.Name</span></div><div><span class="smart-delete-label">Database Id</span><span class="smart-delete-value">@Model.Id</span></div><div><span class="smart-delete-label">City / governorate</span><span class="smart-delete-value">@(Model.City is null ? "Not Available" : Model.City)</span></div><div><span class="smart-delete-label">Category</span><span class="smart-delete-value">@(Model.Category is null ? "Not Available" : Model.Category)</span></div></div><div class="alert alert-warning small"><i class="bi bi-shield-exclamation me-1"></i>Do not continue unless this is the intended destination.</div><form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<div class="smart-delete-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete destination</button></div></form></div></div></div>
