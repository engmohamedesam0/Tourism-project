@model Tourist_Project_MVC.Models.Destination

@{
    ViewData["Title"] = "Destination Management";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid destination-record-page mt-4">

    <div class="destination-record-shell">

        <a href="/Destination" class="record-back"><i class="bi bi-arrow-left"></i> Back to destination management</a>
        <div class="record-hero">
            <div class="d-flex justify-content-between align-items-center">
                <div><div class="record-kicker"><i class="bi bi-database me-1"></i> Admin destination record · ID @Model.Id</div><h1>@Model.Name</h1><p>@(Model.ArabicName ?? "No Arabic name supplied") · @Model.City</p></div>
                <div class="record-actions">@if (isAdmin) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Edit</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</a> }</div>
                @{
                    var badgeClass = Model.Status switch
                    {
                        "Active" => "bg-success",
                        "Pending" => "bg-warning text-dark",
                        "Inactive" => "bg-danger",
                        _ => "bg-success"
                    };
                }
                <span class="record-status @badgeClass"><i class="bi bi-circle-fill"></i> @Model.Status</span>
            </div>
        </div>

        <div class="record-card-body">

            <!-- Stats Row -->
            <div class="row text-center mb-4">
                <div class="col-4">
                    <div class="stat-mini-card">
                        <i class="bi bi-eye-fill text-primary"></i>
                        <div class="stat-mini-number">@Model.Visits.ToString("N0")</div>
                        <div class="stat-mini-label">@Localizer["Destination_TotalVisits"].Value</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-mini-card">
                        <i class="bi bi-ticket-perforated-fill text-warning"></i>
                        <div class="stat-mini-number">
                            @(Model.TicketPrice == 0 ? Localizer["Destination_Free"].Value : Model.TicketPrice?.ToString("C"))
                        </div>
                        <div class="stat-mini-label">@Localizer["Destination_TicketPrice"].Value</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-mini-card">
                        <i class="bi bi-tag-fill text-success"></i>
                        <div class="stat-mini-number">@Model.Category</div>
                        <div class="stat-mini-label">@Localizer["Destination_Category"].Value</div>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Details -->
            <dl class="row">
                <dt class="col-sm-4 text-muted">@Localizer["Destination_CityGovernorate"].Value</dt>
                <dd class="col-sm-8">@Model.City</dd>

                <dt class="col-sm-4 text-muted">@Localizer["Destination_Description"].Value</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 text-muted">@Localizer["Destination_Coordinates"].Value</dt>
                <dd class="col-sm-8">
                    <i class="bi bi-geo text-danger me-1"></i>
                    Lat: @Model.Location.Y | Long: @Model.Location.X
                </dd>

                <dt class="col-sm-4 text-muted">@Localizer["Destination_OpeningHours"].Value</dt>
                <dd class="col-sm-8">
                    @(Model.OpeningHours.HasValue ? Model.OpeningHours.Value.ToString("hh:mm tt") : Localizer["Destination_NotSpecified"].Value)
                </dd>
            </dl>
        </div>

<!-- Card Footer -->
         <div class="record-footer">
             @{
                 var backUrl = ViewBag.BackUrl as string ?? "/Destination";
             }

            @if (User.IsInRole("User"))
            {
                <form asp-controller="Trip" asp-action="AddToTrip" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-circle-fill me-1"></i> @Localizer["Destination_AddToMyTrip"].Value
                    </button>
                </form>
            }

            <a href="@backUrl" class="btn-back"
               onclick="if(document.referrer){history.back();return false;}">
                <i class="bi bi-arrow-left me-1"></i> @Localizer["Destination_Back"].Value
            </a>
        </div>

        @if (ViewBag.ReviewsCarousel is Tourist_Project_MVC.View_Model.ReviewsCarouselVM reviewsVm && reviewsVm.Items != null && reviewsVm.Items.Any())
        {
            @await Html.PartialAsync("_ReviewsCarousel", reviewsVm)
        }

    </div>
</div>

@section Styles {
    <style>
        .destination-record-page{max-width:1180px;margin:0 auto;color:var(--dash-text-primary)}.destination-record-shell{padding:1rem;border:1px solid var(--dash-border);border-radius:18px;background:var(--dash-card-bg);box-shadow:var(--dash-shadow-sm)}.record-back{display:inline-flex;align-items:center;gap:.4rem;margin:0 0 .8rem;color:var(--dash-text-muted);font-size:.7rem;font-weight:800;text-decoration:none}.record-back:hover{color:var(--dash-primary)}.record-hero{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;padding:1.4rem 1.5rem;margin-bottom:1rem;border:1px solid color-mix(in srgb,var(--dash-primary) 28%,var(--dash-border));border-radius:15px;background:linear-gradient(135deg,color-mix(in srgb,var(--dash-primary) 8%,var(--dash-card-bg)),var(--dash-card-bg))}.record-kicker{color:var(--dash-primary);font-size:.63rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.record-hero h1{margin:.3rem 0 .2rem;font-size:clamp(1.35rem,3vw,2.1rem);font-weight:900}.record-hero p{margin:0;color:var(--dash-text-muted);font-size:.75rem}.record-actions{display:flex;gap:.45rem;flex-wrap:wrap}.record-actions .btn{border-radius:8px;font-size:.7rem;font-weight:800}.record-status{display:inline-flex;align-items:center;gap:.35rem;padding:.34rem .62rem;border-radius:999px;font-size:.64rem;font-weight:900}.record-status.bg-success{color:var(--dash-green);background:var(--dash-green-bg)!important}.record-status.bg-warning{color:#966b00;background:rgba(228,198,98,.18)!important}.record-status.bg-danger{color:var(--dash-rose);background:var(--dash-rose-bg)!important}.record-card-body{padding:1rem}.record-stat-card{height:100%;padding:.75rem;border:1px solid var(--dash-border);border-radius:10px;background:var(--dash-bg)}.record-stat-card i{color:var(--dash-primary)}.record-stat-number{display:block;margin-top:.3rem;font-weight:900}.record-stat-label{display:block;color:var(--dash-text-muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.06em}.record-meta-label{display:block;color:var(--dash-text-muted);font-size:.62rem;font-weight:800;text-transform:uppercase}.record-meta-value{font-size:.78rem;font-weight:800}.record-description{color:var(--dash-text-secondary);font-size:.78rem;line-height:1.7;white-space:pre-line}.record-footer{display:flex;justify-content:flex-end;gap:.5rem;padding:1rem;border-top:1px solid var(--dash-border)}
@@media(max-width:650px){.record-hero{flex-direction:column}.record-actions{width:100%}.record-actions .btn{flex:1}}
        .stat-mini-card {
            background: #FDF6EC;
            border: 1px solid #E8A045;
            border-radius: 12px;
            padding: 15px 10px;
        }

        .stat-mini-number {
            font-family: 'Cinzel', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--egy-dark);
            margin: 6px 0 2px;
        }

        .stat-mini-label {
            font-size: 0.75rem;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
    </style>
}
